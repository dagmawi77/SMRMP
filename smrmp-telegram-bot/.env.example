# Telegram BotFather token (required)
TELEGRAM_BOT_TOKEN=

# SMRMP API base including /api (required)
# Example: http://localhost:5000/api
SMRMP_API_URL=http://localhost:5000/api

# Frontend URL for ticket purchase / artifact deep links
FRONTEND_URL=http://localhost:5173

# Optional museum display overrides
MUSEUM_NAME=Adwa Victory Memorial Museum
MUSEUM_PHONE=

# long-polling (default) | webhook
BOT_MODE=polling

# Required only when BOT_MODE=webhook
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram/webhook
PORT=5001
