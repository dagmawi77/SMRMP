NODE_ENV=development
PORT=5000

# Database — either discrete DB_* OR Render's DATABASE_URL (see DEPLOY_RENDER.md)
# Option A: discrete vars (local Docker / Supabase pooler / Render Internal DB)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=smrmp_db
DB_USER=smrmp_user
DB_PASSWORD=smrmp_pass
DB_SSL=false
# Option B (Render): leave DB_* unset and set DATABASE_URL from the Render Postgres service
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SSL=true

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# service_role is server-only; needed for `npm run auth:sync`
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional but recommended: Project Settings → API → JWT Secret.
# When set, /auth/me and other protect() routes verify tokens locally (faster).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Payment (Telebirr Sandbox)
TELEBIRR_APP_ID=sandbox_app_id
TELEBIRR_APP_KEY=sandbox_key
TELEBIRR_SHORT_CODE=sandbox_code
TELEBIRR_PUBLIC_KEY=sandbox_public_key
TELEBIRR_BASE_URL=https://sandbox.telebirr.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API base (webhooks / absolute links — PRD Section 6)
API_BASE_URL=http://localhost:5000

# After pull: run migrations for RBAC tables (roles, permissions, role_permissions)
#   npx sequelize-cli db:migrate
# Admin UI: /admin/users and /admin/roles (requires admin permissions)
