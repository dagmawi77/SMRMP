NODE_ENV=development
PORT=5000

# Database — either discrete DB_* OR Render's DATABASE_URL (see DEPLOY_RENDER.md)
# Option A: discrete vars (local Docker / Supabase pooler / Render Internal DB)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=smrmp_db
DB_USER=smrmp_user
DB_PASSWORD=smrmp_pass
DB_SSL=false
# Option B (Render): leave DB_* unset and set DATABASE_URL from the Render Postgres service
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SSL=true

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# service_role is server-only; needed for `npm run auth:sync`
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional but recommended: Project Settings → API → JWT Secret.
# When set, /auth/me and other protect() routes verify tokens locally (faster).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Addis AI — Amharic / Afaan Oromo story narration (Addis Voices 2).
# Optional: without ADDIS_API_KEY the narration player falls back to browser
# speech synthesis. Billed at 5 ETB/minute, so clips are cached permanently.
ADDIS_API_KEY=sk_your_addis_ai_key
ADDIS_BASE_URL=https://api.addisassistant.com
# Voice IDs come from GET /api/v1/voice/voices — do not hardcode blindly.
ADDIS_VOICE_AM=am-dawit
ADDIS_VOICE_OM=om-diriba
ADDIS_ALLOW_PUBLIC_GENERATION=true
ADDIS_MAX_COST_PER_CLIP_ETB=15

# Payment (Telebirr Sandbox)
TELEBIRR_APP_ID=sandbox_app_id
TELEBIRR_APP_KEY=sandbox_key
TELEBIRR_SHORT_CODE=sandbox_code
TELEBIRR_PUBLIC_KEY=sandbox_public_key
TELEBIRR_BASE_URL=https://sandbox.telebirr.com

# Canonical frontend URL — used for CORS, QR code links and emailed links.
# Must be reachable by the device that scans an artifact QR code.
FRONTEND_URL=http://localhost:3000

# Optional extra browser origins allowed through CORS (comma-separated).
# Useful when FRONTEND_URL points at a LAN IP for phone testing.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API base (webhooks / absolute links — PRD Section 6)
API_BASE_URL=http://localhost:5000

# After pull: run migrations for RBAC tables (roles, permissions, role_permissions)
#   npx sequelize-cli db:migrate
# Admin UI: /admin/users and /admin/roles (requires admin permissions)
