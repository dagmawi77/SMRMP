NODE_ENV=development
PORT=5000

# Database — prefer Session pooler on IPv4 networks (Windows often can't resolve IPv6-only db.*)
# Supabase → Connect → Session mode
# Example:
#   DB_HOST=aws-0-eu-central-1.pooler.supabase.com
#   DB_USER=postgres.YOUR_PROJECT_REF
DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your_supabase_db_password
DB_SSL=true

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# service_role is server-only; needed for `npm run auth:sync`
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Payment (Telebirr Sandbox)
TELEBIRR_APP_ID=sandbox_app_id
TELEBIRR_APP_KEY=sandbox_key
TELEBIRR_SHORT_CODE=sandbox_code
TELEBIRR_PUBLIC_KEY=sandbox_public_key
TELEBIRR_BASE_URL=https://sandbox.telebirr.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API base (webhooks / absolute links — PRD Section 6)
API_BASE_URL=http://localhost:5000
