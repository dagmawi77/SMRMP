</span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-5\" data-name=\"uptime graph bar 5\" data-reason=\"height calculated dynamically\" style=\"height:61%\">\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-6\" data-name=\"uptime graph bar 6\" data-reason=\"height calculated dynamically\" style=\"height:77%\">\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-7\" data-name=\"uptime graph bar 7\" data-reason=\"height calculated dynamically\" style=\"height:70%\">\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-8\" data-name=\"uptime graph bar 8\" data-reason=\"height calculated dynamically\" style=\"height:89%\">\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-9\" data-name=\"uptime graph bar 9\" data-reason=\"height calculated dynamically\" style=\"height:81%\">\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-10\" data-name=\"uptime graph bar 10\" data-reason=\"height calculated dynamically\" style=\"height:94%\">\n                            </span>\n                        </div>\n                        <div class=\"mini-legend\" data-kid=\"1-1-2-2-3-2-4\">\n                            <span data-kid=\"1-1-2-2-3-2-4-1\">\n                                Oct 28\n                            </span>\n                            <span data-kid=\"1-1-2-2-3-2-4-2\">\n                                Nov 25\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"panel panel-pad\" data-kid=\"1-1-2-2-3-3\">\n                        <div class=\"panel-title\" data-kid=\"1-1-2-2-3-3-1\">\n                            <div data-kid=\"1-1-2-2-3-3-1-1\">\n                                <h3 data-kid=\"1-1-2-2-3-3-1-1-1\">\n                                    Facility readiness\n                                </h3>\n                                <p data-kid=\"1-1-2-2-3-3-1-1-2\">\n                                    Preventive inspections · 11 zones\n                                </p>\n                            </div>\n                            <i class=\"ti ti-building\" data-kid=\"1-1-2-2-3-3-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"readiness-list\" data-kid=\"1-1-2-2-3-3-2\">\n                            <div class=\"readiness-item\" data-kid=\"1-1-2-2-3-3-2-1\">\n                                <span data-kid=\"1-1-2-2-3-3-2-1-1\">\n                                    Gallery halls\n                                </span>\n                                <div class=\"readiness-track\" data-kid=\"1-1-2-2-3-3-2-1-2\">\n                                    <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-3-2-1-2-1\" data-name=\"readiness bar 1\" data-reason=\"width calculated dynamically\" style=\"width:92%\">\n                                    </span>\n                                </div>\n                                <strong data-kid=\"1-1-2-2-3-3-2-1-3\">\n                                    92%\n                                </strong>\n                            </div>\n                            <div class=\"readiness-item\" data-kid=\"1-1-2-2-3-3-2-2\">\n                                <span data-kid=\"1-1-2-2-3-3-2-2-1\">\n                                    Education wing\n                                </span>\n                                <div class=\"readiness-track\" data-kid=\"1-1-2-2-3-3-2-2-2\">\n                                    <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-3-2-2-2-1\" data-name=\"readiness bar 2\" data-reason=\"width calculated dynamically\" style=\"width:86%\">\n                                    </span>\n                                </div>\n                                <strong data-kid=\"1-1-2-2-3-3-2-2-3\">\n                                    86%\n                                </strong>\n                            </div>\n                            <div class=\"readiness-item\" data-kid=\"1-1-2-2-3-3-2-3\">\n                                <span data-kid=\"1-1-2-2-3-3-2-3-1\">\n                                    East courtyard\n                                </span>\n                                <div class=\"readiness-track warn\" data-kid=\"1-1-2-2-3-3-2-3-2\">\n                                    <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-3-2-3-2-1\" data-name=\"readiness bar 3\" data-reason=\"width calculated dynamically\" style=\"width:61%\">\n                                    </span>\n                                </div>\n                                <strong data-kid=\"1-1-2-2-3-3-2-3-3\">\n                                    61%\n                                </strong>\n                            </div>\n                            <div class=\"readiness-item\" data-kid=\"1-1-2-2-3-3-2-4\">\n                                <span data-kid=\"1-1-2-2-3-3-2-4-1\">\n                                    Storage rooms\n                                </span>\n                                <div class=\"readiness-track\" data-kid=\"1-1-2-2-3-3-2-4-2\">\n                                    <span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-3-2-4-2-1\" data-name=\"readiness bar 4\" data-reason=\"width calculated dynamically\" style=\"width:97%\">\n                                    </span>\n                                </div>\n                                <strong data-kid=\"1-1-2-2-3-3-2-4-3\">\n                                    97%\n                                </strong>\n                            </div>\n                        </div>\n                    </article>\n                </section>\n                <div class=\"section-head\" data-kid=\"1-1-2-2-4\">\n                    <div data-kid=\"1-1-2-2-4-1\">\n                        <h2 data-kid=\"1-1-2-2-4-1-1\">\n                            Risk matrix & approval flow\n                        </h2>\n                        <p data-kid=\"1-1-2-2-4-1-2\">\n                            Prioritise what can damage an object, disrupt a visitor journey, or compromise safety.\n                        </p>\n                    </div>\n                    <span class=\"section-link\" data-kid=\"1-1-2-2-4-2\">\n                        Live triage · 12 open\n                    </span>\n                </div>\n                <section class=\"risk-layout\" data-kid=\"1-1-2-2-5\">\n                    <article class=\"panel panel-pad\" data-kid=\"1-1-2-2-5-1\">\n                        <div class=\"panel-title\" data-kid=\"1-1-2-2-5-1-1\">\n                            <div data-kid=\"1-1-2-2-5-1-1-1\">\n                                <h3 data-kid=\"1-1-2-2-5-1-1-1-1\">\n                                    Urgency × impact\n                                </h3>\n                                <p data-kid=\"1-1-2-2-5-1-1-1-2\">\n                                    Signals are weighted by asset value, public access, and safety exposure.\n                                </p>\n                            </div>\n                            <i class=\"ti ti-chart-dots-3\" data-kid=\"1-1-2-2-5-1-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"matrix\" data-kid=\"1-1-2-2-5-1-2\">\n                            <div class=\"matrix-grid\" data-kid=\"1-1-2-2-5-1-2-1\">\n                                <div class=\"matrix-zone\" data-kid=\"1-1-2-2-5-1-2-1-1\">\n                                </div>\n                                <span class=\"matrix-label low\" data-kid=\"1-1-2-2-5-1-2-1-2\">\n                                    Monitor\n                                </span>\n                                <span class=\"matrix-label high\" data-kid=\"1-1-2-2-5-1-2-1-3\">\n                                    Act now\n                                </span>\n                                <div class=\"matrix-point point-red\" data-kid=\"1-1-2-2-5-1-2-1-4\" style=\"left:80%;top:19%\">\n                                    <i data-kid=\"1-1-2-2-5-1-2-1-4-1\">\n                                        !\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-5-1-2-1-4-2\">\n                                        Humidity variance\n                                    </span>\n                                </div>\n                                <div class=\"matrix-point point-red\" data-kid=\"1-1-2-2-5-1-2-1-5\" style=\"left:89%;top:42%\">\n                                    <i data-kid=\"1-1-2-2-5-1-2-1-5-1\">\n                                        !\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-5-1-2-1-5-2\">\n                                        Roof drain overflow\n                                    </span>\n                                </div>\n                                <div class=\"matrix-point point-amber\" data-kid=\"1-1-2-2-5-1-2-1-6\" style=\"left:61%;top:52%\">\n                                    <i data-kid=\"1-1-2-2-5-1-2-1-6-1\">\n                                        2\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-5-1-2-1-6-2\">\n                                        Display case latch\n                                    </span>\n                                </div>\n                                <div class=\"matrix-point point-amber\" data-kid=\"1-1-2-2-5-1-2-1-7\" style=\"left:70%;top:72%\">\n                                    <i data-kid=\"1-1-2-2-5-1-2-1-7-1\">\n                                        3\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-5-1-2-1-7-2\">\n                                        Projector lamp\n                                    </span>\n                                </div>\n                                <div class=\"matrix-point point-green\" data-kid=\"1-1-2-2-5-1-2-1-8\" style=\"left:35%;top:78%\">\n                                    <i data-kid=\"1-1-2-2-5-1-2-1-8-1\">\n                                        4\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-5-1-2-1-8-2\">\n                                        Print room light\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div aria-label=\"Approval workflow\" class=\"checkpoint-row\" data-kid=\"1-1-2-2-5-1-3\">\n                            <div class=\"checkpoint done\" data-kid=\"1-1-2-2-5-1-3-1\">\n                                <span class=\"checkpoint-dot\" data-kid=\"1-1-2-2-5-1-3-1-1\">\n                                </span>\n                                New\n                            </div>\n                            <div class=\"checkpoint done\" data-kid=\"1-1-2-2-5-1-3-2\">\n                                <span class=\"checkpoint-dot\" data-kid=\"1-1-2-2-5-1-3-2-1\">\n                                </span>\n                                Review\n                            </div>\n                            <div class=\"checkpoint done\" data-kid=\"1-1-2-2-5-1-3-3\">\n                                <span class=\"checkpoint-dot\" data-kid=\"1-1-2-2-5-1-3-3-1\">\n                                </span>\n                                Approve\n                            </div>\n                            <div class=\"checkpoint current\" data-kid=\"1-1-2-2-5-1-3-4\">\n                         