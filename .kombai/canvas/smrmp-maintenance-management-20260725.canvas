   </div>\n                    <div class=\"hero-side\" data-kid=\"1-1-3-2-2-2\" data-name=\"hero side column\">\n                        <div class=\"hero-photo\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"hero image wrapper\">\n                            <img alt=\"Warm museum gallery interior with display cases, Pew Nguyen on Pexels\" data-kid=\"1-1-3-2-2-2-1-1\" data-name=\"hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34909191/pexels-photo-34909191.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                            <div class=\"photo-caption\" data-kid=\"1-1-3-2-2-2-1-2\" data-name=\"image caption\">\n                                Museum floor readiness\n                                <span data-kid=\"1-1-3-2-2-2-1-2-1\" data-name=\"image sub-caption\">\n                                    Gallery operations · 97% open\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"health-card\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"health summary card\">\n                            <div class=\"health-head\" data-kid=\"1-1-3-2-2-2-2-1\" data-name=\"health card title\">\n                                <span data-kid=\"1-1-3-2-2-2-2-1-1\" data-name=\"health card label\">\n                                    Request health\n                                </span>\n                                <span data-kid=\"1-1-3-2-2-2-2-1-2\" data-name=\"health card percentage\">\n                                    84% within SLA\n                                </span>\n                            </div>\n                            <div class=\"health-bar\" data-kid=\"1-1-3-2-2-2-2-2\" data-name=\"health status bar\">\n                                <span data-kid=\"1-1-3-2-2-2-2-2-1\" data-name=\"health progress bar\">\n                                </span>\n                            </div>\n                            <div class=\