abel=\"Switch language\" class=\"top-control\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2-2\" data-name=\"language toggle button\" data-reason=\"text content updated by script\" id=\"language-toggle\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-language\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"language icon\" style=\"font-size:15px;width:15px;height:15px;color:#7C4A2D;line-height:1;\">\n                        </i>\n                        <span data-kid=\"1-1-3-1-2-2-2\" data-name=\"language text\">\n                            EN\n                        </span>\n                    </button>\n                    <button aria-label=\"Toggle dark mode\" class=\"top-control\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2-3\" data-name=\"theme toggle button\" data-reason=\"toast triggered, styles toggled by script\" id=\"dark-toggle\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-moon\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"theme icon\" style=\"font-size:15px;width:15px;height:15px;color:#7C4A2D;line-height:1;\">\n                        </i>\n                        <span data-kid=\"1-1-3-1-2-3-2\" data-name=\"theme text\">\n                            Dark\n                        </span>\n                    </button>\n                    <button aria-label=\"View 3 notifications\" class=\"notification-btn\" data-kid=\"1-1-3-1-2-4\" data-name=\"notification button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-bell\" data-kid=\"1-1-3-1-2-4-1\" data-name=\"notification icon\" style=\"font-size:16px;width:16px;height:16px;color:#2B1B12;line-height:1;\">\n                        </i>\n                        <span class=\"notification-count\" data-kid=\"1-1-3-1-2-4-2\" data-name=\"notification count badge\">\n                            3\n                        </span>\n                    </button>\n                    <div class=\"user-name\" data-kid=\"1-1-3-1-