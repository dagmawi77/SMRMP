 .timeline-dot.blue{background:var(--blue);}.maintenance-app .timeline-copy strong{display:block;color:var(--ink);font-size:9px;}.maintenance-app .timeline-copy span{display:block;margin-top:3px;color:var(--muted);font-size:8px;}.maintenance-app .deadline-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:13px;}.maintenance-app .deadline{padding:10px;border:1px solid var(--border);background:#FFFDF9;}.maintenance-app .deadline-date{color:var(--green);font-size:9px;font-weight:700;}.maintenance-app .deadline-date strong{display:block;color:var(--ink);font-size:17px;line-height:1.1;}.maintenance-app .deadline p{margin:6px 0 0;color:var(--muted);font-size:8px;line-height:1.35;}.maintenance-app .deadline .status{margin-top:7px;font-size:7px;}.maintenance-app .report-list{display:grid;gap:8px;margin-top:12px;}.maintenance-app .report-row{display:flex;align-items:center;gap:9px;padding:9px;border:1px solid #E8DCCF;background:#FFFDF9;}.maintenance-app .report-icon{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:var(--gold-soft);color:#8D6A1B;font-size:15px;}.maintenance-app .report-copy{min-width:0;flex:1;}.maintenance-app .report-copy strong{display:block;color:var(--ink);font-size:9px;}.maintenance-app .report-copy span{display:block;margin-top:2px;color:var(--muted);font-size:8px;}.maintenance-app .report-actions{display:flex;gap:4px;}.maintenance-app .report-actions button{padding:5px 6px;border:1px solid var(--border);border-radius:5px;background:var(--white);color:#7C4A2D;font-size:8px;font-weight:700;}.maintenance-app .notification-list{gap:0;}.maintenance-app .notification{display:flex;align-items:flex-start;gap:8px;padding:9px 0;border-bottom:1px solid #EDE4D7;}.maintenance-app .notification:last-child{border-bottom:0;}.maintenance-app .notification-mark{width:7px;height:7px;flex:none;margin-top:4px;border-radius:50%;background:var(--gold);}.maintenance-app .notification-mark.red{background:var(--red);}.maintenance-app .notification-mark.green{background:var(--green);}.maintenance-app .notification-copy{min-width:0;flex:1;}.maintenance-app .notification-copy strong{display:block;color:var(--ink);font-size:9px;}.maintenance-app .notification-copy span{display:block;margin-top:3px;color:var(--muted);font-size:8px;}.maintenance-app .notification-time{color:#9A8573;font-size:8px;white-space:nowrap;}\n  .maintenance-app .footer{padding:20px 0 4px;color:#8B7668;font-size:9px;}.maintenance-app .footer a{color:#7C4A2D;}\n  @media (max-width:1120px){.maintenance-app .workspace{padding-inline:18px;}.maintenance-app .health-grid{grid-template-columns:1fr 1fr;}.maintenance-app .health-feature{grid-column:1 / -1;}.maintenance-app .triage-grid,.maintenance-app .risk-layout{grid-template-columns:1fr;}.maintenance-app .ops-grid{grid-template-columns:1fr 1fr;}.maintenance-app .ops-grid article:last-child{grid-column:1 / -1;}}\n  @media (max-width:820px){.maintenance-app .sidebar{position:fixed;inset:0 auto 0 0;transform:translateX(-105%);box-shadow:12px 0 35px rgba(10,22,40,.18);}.maintenance-app .sidebar.open{transform:translateX(0);}.maintenance-app .mobile-only{display:grid!important;}.maintenance-app .top-search,.maintenance-app .operational,.maintenance-app .topbar-meta,.maintenance-app .user-name{display:none;}.maintenance-app .topbar{padding-inline:14px;}.maintenance-app .workspace{padding:15px 14px 20px;}.maintenance-app .hero{flex-direction:column;padding:20px;}.maintenance-app .hero-actions{align-items:stretch;width:100%;}.maintenance-app .health-grid,.maintenance-app .ops-grid{grid-template-columns:1fr;}.maintenance-app .health-feature{grid-column:auto;}.maintenance-app .issue-columns{grid-template-columns:1fr;}.maintenance-app .toolbar{align-items:stretch;flex-direction:column;}.maintenance-app .toolbar-left,.maintenance-app .toolbar-right{width:100%;}.maintenance-app .search-box{flex:1;width:auto;}.maintenance-app .gallery-grid{grid-template-columns:1fr;}.maintenance-app