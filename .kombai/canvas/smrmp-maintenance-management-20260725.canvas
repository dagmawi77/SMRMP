          </article>\n                </section>\n                <section class=\"emergency-rail\" data-kid=\"1-1-3-2-12\" data-name=\"emergency management section\" id=\"emergency\">\n                    <article class=\"emergency-card\" data-kid=\"1-1-3-2-12-1\" data-name=\"emergency response card\">\n                        <div class=\"alert-label\" data-kid=\"1-1-3-2-12-1-1\" data-name=\"alert label\">\n                            <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-1-3-2-12-1-1-1\" data-name=\"alert icon\" style=\"font-size:15px;width:15px;height:15px;color:#9A3A2A;line-height:1;\">\n                            </i>\n                            Emergency response rail\n                        </div>\n                        <h3 data-kid=\"1-1-3-2-12-1-2\" data-name=\"emergency headline\">\n                            Water leakage under north stair needs dispatch.\n                        </h3>\n                        <p data-kid=\"1-1-3-2-12-1-3\" data-name=\"emergency description\">\n                            Request MR-2024-0146 has been acknowledged by Security and Building Maintenance. Keep Gallery 01 closed until the electrical hazard is cleared.\n                        </p>\n                        <div class=\"alert-meta\" data-kid=\"1-1-3-2-12-1-4\" data-name=\"emergency meta info\">\n                            <span data-kid=\"1-1-3-2-12-1-4-1\" data-name=\"meta timestamp\">\n                                <i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"1-1-3-2-12-1-4-1-1\" data-name=\"clock icon\" style=\"font-size:13px;width:13px;height:13px;color:#9A3A2A;line-height:1;\">\n                                </i>\n                                00:42 since report\n                            </span>\n                            <span data-kid=\"1-1-3-2-12-1-4-2\" data-name=\"meta responders\">\n                                <i aria-hidden=\"true\" class=\"ti ti-users\" data-kid=\"1-1-3-2-12-1-4-2-1\" data-name=\"responders icon\" style=\"font-size:13px;width:13px;height:13px;color:#9A3A2A;line-height:1;\">\n                                </i>\n                                3 responders notified\n                            </span>\n                            <span data-kid=\"1-1-3-2-12-1-4-3\" data-name=\"meta location\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-1-3-2-12-1-4-3-1\" data-name=\"map pin icon\" style=\"font-size:13px;width:13px;height:13px;color:#9A3A2A;line-height:1;\">\n                                </i>\n                                Building A · Floor 1\n                            </span>\n                        </div>\n                        <div data-kid=\"1-1-3-2-12-1-5\" data-name=\"emergency action container\" style=\"margin-top:14px;\">\n                            <button class=\"btn btn-paper action-toast\" data-dynamic=\"true\" data-kid=\"1-1-3-2-12-1-5-1\" data-name=\"open incident button\" data-reason=\"toast triggered by script\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-bolt\" data-kid=\"1-1-3-2-12-1-5-1-1\" data-name=\"bolt icon\" style=\"font-size:14px;width:14px;height:14px;color:#9A3A2A;line-height:1;\">\n                                </i>\n                                Open incident room\n                            </button>\n                        </div>\n                    </article>\n                    <article class=\"contact-card\" data-kid=\"1-1-3-2-12-2\" data-name=\"contact card\">\n                        <h3 data-kid=\"1-1-3-2-12-2-1\" data-name=\"contact heading\">\n                            Emergency contact list\n                        </h3>\n                        <p data-kid=\"1-1-3-2-12-2-2\" data-name=\"contact description\">\n                            One-click coordination for fire, flood, electrical, security, and artifact incidents.\n                        </p>\n                        <div class=\"contact-list\" data-kid=\"1-1-3-2-12-2-3\" data-name=\"contact list\">\n                            <div class=\"contact-item\" data-kid=\"1-1-3-2-12-2-3-1\" data-name=\"contact item 1\">\n                                <span class=\"contact-avatar\" data-kid=\"1-1-3-2-12-2-3-1-1\" data-name=\"contact avatar 1\">\n                                    BM\n                                </span>\n                                <span data-kid=\"1-1-3-2-12-2-3-1-2\" data-name=\"contact item details 1\">\n                                    <strong data-kid=\"1-1-3-2-12-2-3-1-2-1\" data-name=\"contact name 1\">\n                                        Building maintenance\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-12-2-3-1-2-2\" data-name=\"contact info 1\">\n                                        Bekele Mamo · +251 911 340 218\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-phone-call\" data-kid=\"1-1-3-2-12-2-3-1-3\" data-name=\"call icon 1\" style=\"font-size:14px;width:14px;height:14px;color:#D9E7B7;line-height:1;margin-left:auto;\">\n                                </i>\n                            </div>\n                            <div class=\"contact-item\" data-kid=\"1-1-3-2-12-2-3-2\" data-name=\"contact item 2\">\n                                <span class=\"contact-avatar\" data-kid=\"1-1-3-2-12-2-3-2-1\" data-name=\"contact avatar 2\">\n                                    SK\n                                </span>\n                                <span data-kid=\"1-1-3-2-12-2-3-2-2\" data-name=\"contact item details 2\">\n                                    <strong data-kid=\"1-1-3-2-12-2-3-2-2-1\" data-name=\"contact name 2\">\n                                        Security control room\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-12-2-3-2-2-2\" data-name=\"contact info 2\">\n                                        Selam Kassa · Ext. 104\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-phone-call\" data-kid=\"1-1-3-2-12-2-3-2-3\" data-name=\"call icon 2\" style=\"font-size:14px;width:14px;height:14px;color:#D9E7B7;line-height:1;margin-left:auto;\">\n                                </i>\n                            </div>\n                            <div class=\"contact-item\" data-kid=\"1-1-3-2-12-2-3-3\" data-name=\"contact item 3\">\n                                <span class=\"contact-avatar\" data-kid=\"1-1-3-2-12-2-3-3-1\" data-name=\"contact avatar 3\">\n                                    AC\n                                </span>\n                                <span data-kid=\"1-1-3-2-12-2-3-3-2\" data-name=\"contact item details 3\">\n                                    <strong data-kid=\"1-1-3-2-12-2-3-3-2-1\" data-name=\"contact name 3\">\n                                        Artifact conservation\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-12-2-3-3-2-2\" data-name=\"contact info 3\">\n                                        Almaz Chekol · Ext. 207\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-phone-call\" data-kid=\"1-1-3-2-12-2-3-3-3\" data-name=\"call icon 3\" style=\"font-size:14px;width:14px;height:14px;color:#D9E7B7;line-height:1;margin-left:auto;\">\n                                </i>\n                            </div>\n                        </div>\n                    </article>\n                </section>\n                <div class=\"section-head\" data-kid=\"1-1-3-2-13\" data-name=\"reports section header\" id=\"reports\">\n                    <div data-kid=\"1-1-3-2-13-1\" data-name=\"reports header titles\">\n                        <h2 data-kid=\"1-1-3-2-13-1-1\" data-name=\"reports headline\">\n                            Reports & handover\n                        </h2>\n                        <p data-kid=\"1-1-3-2-13-1-2\" data-name=\"reports description\">\n                            Export the view your team needs for the next decision.\n                        </p>\n                    </div>\n                    <span class=\"section-link\" data-kid=\"1-1-3-2-13-2\" data-name=\"sync status\">\n                        Last synced 2 minutes ago\n                    </span>\n                </div>\n                <section class=\"report-strip\" data-kid=\"1-1-3-2-14\" data-name=\"report strip\">\n                    <div class=\"report-intro\" data-kid=\"1-1-3-2-14-1\" data-name=\"report intro\">\n                        <h3 data-kid=\"1-1-3-2-14-1-1\" data-name=\"intro heading\">\n                            Make the next move.\n                        </h3>\n                        <p data-kid=\"1-1-3-2-14-1-2\" data-name=\"intro description\">\n                            Build a maintenance report without leaving the operational view.\n                        </p>\n                    </div>\n                    <button class=\"report-card action-toast\" data-dynamic=\"true\" data-kid=\"1-1-3-2-14-2\" data-name=\"report card 1\" data-reason=\"toast triggered by script\" type=\"button\">\n                        <span data-kid=\"1-1-3-2-14-2-1\" data-name=\"report card icon 1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-file-report\" data-kid=\"1-1-3-2-14-2-1-1\" data-name=\"file icon 1\" style=\"font-size:17px;width:17px;height:17px;color:#374B07;line-height:1;\">\n                            </i>\n                        </span>\n                        <strong data-kid=\"1-1-3-2-14-2-2\" data-name=\"report card title 1\">\n                            Maintenance report\n                        </strong>\n                        <small data-kid=\"1-1-3-2-14-2-3\" data-name=\"report card sub-info 1\">\n                            PDF · monthly summary\n                        </small>\n                    </button>\n                    <button class=\"report-card action-toast\" data-dynamic=\"true\" data-kid=\"1-1-3-2-14-3\" data-name=\"report card 2\" data-reason=\"toast triggered by script\" type=\"button\">\n                        <span data-kid=\"1-1-3-2-14-3-1\" data-name=\"report card icon 2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-vase\" data-kid=\"1-1-3-2-14-3-1-1\" data-name=\"vase icon 2\" style=\"font-size:17px;width:17px;height:17px;color:#374B07;line-height:1;\">\n                            </i>\n                        </span>\n                        <strong data-kid=\"1-1-3-2-14-3-2\" data-name=\"report card title 2\">\n                            Artifact repair report\n                        </strong>\n                        <small data-kid=\"1-1-3-2-14-3-3\" data-name=\"report card sub-info 2\">\n                            Inspection history\n                        </small>\n                    </button>\n                    <button class=\"report-card action-toast\" data-dynamic=\"true\" data-kid=\"1-1-3-2-14-4\" data-name=\"report card 3\" data-reason=\"toast triggered by script\" type=\"button\">\n                        <span data-kid=\"1-1-3-2-14-4-1\" data-name=\"report card icon 3\">\n                            <i aria-hidden=\"true\" class=\"ti ti-file-spreadsheet\" data-kid=\"1-1-3-2-14-4-1-1\" data-name=\"spreadsheet icon 3\" style=\"font-size:17px;width:17px;height:17px;color:#374B07;line-height:1;\">\n                            </i>\n                        </span>\n                        <strong data-kid=\"1-1-3-2-14-4-2\" data-name=\"report card title 3\">\n                            Technician performance\n                        </strong>\n                        <small data-kid=\"1-1-3-2-14-4-3\" data-name=\"report card sub-info 3\">\n                            Excel · SLA view\n                        </small>\n                    </button>\n                    <button class=\"report-card action-toast\" data-dynamic=\"true\" data-kid=\"1-1-3-2-14-5\" data-name=\"report card 4\" data-reason=\"toast triggered by script\" type=\"button\">\n                        <span data-kid=\"1-1-3-2-14-5-1\" data-name=\"report card icon 4\">\n                            <i aria-hidden=\"true\" class=\"ti ti-printer\" data-kid=\"1-1-3-2-14-5-1-1\" data-name=\"printer icon 4\" style=\"font-size:17px;width:17px;height:17px;color:#374B07;line-height:1;\">\n                            </i>\n                        </span>\n                        <strong data-kid=\"1-1-3-2-14-5-2\" data-name=\"report card title 4\">\n                            Print handover\n                        </strong>\n                        <small data-kid=\"1-1-3-2-14-5-3\" data-name=\"report card sub-info 4\">\n                            Current operations view\n                        </small>\n                    </button>\n                </section>\n                <footer class=\"footer\" data-kid=\"1-1-3-2-15\" data-name=\"footer copyright text\">\n                    SMRMP Maintenance Management · Adwa Victory Memorial Museum · Multilingual-ready operations workspace · Stock photography: Pew Nguyen, Tahir Xəlfəquliyev, José Andrés Pacheco Cortes, and Blackcurrant Great on Pexels.\n                </footer>\n            </main>\n        </div>\n    </div>\n    <div aria-live=\"polite\" class=\"toast\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"toast notification element\" data-reason=\"visibility updated by script\" id=\"toast\" role=\"status\">\n        <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-2-1\" data-name=\"toast icon\" style=\"font-size:14px;width:14px;height:14px;color:#D9E7B7;line-height:1;\">\n        </i>\n        <span data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"toast message text\" data-reason=\"text updated by script\">\n            Action queued for the maintenance team\n        </span>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    const app=document.getElementById('maintenance-app');\n  const sidebar=document.getElementById('sidebar');\n  const collapse=document.getElementById('collapse-sidebar');\n  const mobileMenu=document.getElementById('mobile-menu');\n  const backdrop=document.getElementById('drawer-backdrop');\n  const toast=document.getElementById('toast');\n  const showToast=(message='Action queued for the maintenance team')=>{toast.querySelector('span').textContent=message;toast.classList.add('show');window.clearTimeout(window.__smrmpToast);window.__smrmpToast=window.setTimeout(()=>toast.classList.remove('show'),2200);};\n  const setDrawer=(open)=>{sidebar.classList.toggle('mobile-open',open);mobileMenu.setAttribute('aria-expanded',String(open));backdrop.style.display=open?'block':'none';};\n  collapse.addEventListener('click',()=>{const collapsed=sidebar.classList.toggle('collapsed');collapse.setAttribute('aria-expanded',String(!collapsed));collapse.setAttribute('aria-label',collapsed?'Expand sidebar':'Collapse sidebar');collapse.innerHTML='<i class=\"ti '+(collapsed?'ti-chevron-right':'ti-chevron-left')+'\" style=\"font-size:14px;width:14px;height:14px;color:#7C4A2D;line-height:1;\"></i>';});\n  mobileMenu.addEventListener('click',()=>setDrawer(true)); backdrop.addEventListener('click',()=>setDrawer(false)); window.addEventListener('resize',()=>{if(window.innerWidth>860)setDrawer(false);});\n  document.querySelectorAll('.action-toast').forEach((button)=>button.addEventListener('click',()=>showToast(button.textContent.trim()+' · ready')));\n  document.getElementById('dark-toggle').addEventListener('click',()=>{app.classList.toggle('dark-preview');showToast(app.classList.contains('dark-preview')?'Dark mode preview enabled':'Light mode preview enabled');});\n  const languages=['EN','OM','አማ'];let languageIndex=0;document.getElementById('language-toggle').addEventListener('click',()=>{languageIndex=(languageIndex+1)%languages.length;document.querySelector('#language-toggle span').textContent=languages[languageIndex];showToast('Language preview: '+languages[languageIndex]);});\n  document.getElementById('request-search').addEventListener('input',(event)=>{const query=event.target.value.toLowerCase();document.querySelectorAll('#request-rows tr').forEach((row)=>{row.style.display=row.textContent.toLowerCase().includes(query)?'':'none';});});\n  if(window.Chart){\n    const chartFont={family:'Inter',size:9};\n    new Chart(document.getElementById('requests-chart'),{type:'line',data:{labels:['Dec','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov'],datasets:[{label:'Submitted',data:[84,91,88,103,97,112,105,118,109,121,114,128],borderColor:'#D4A017',backgroundColor:'rgba(212,160,23,.13)',borderWidth:2,pointRadius:0,pointHoverRadius:4,tension:.36,fill:true},{label:'Completed',data:[71,78,80,86,82,94,90,99,96,105,101,116],borderColor:'#374B07',backgroundColor:'transparent',borderWidth:2,pointRadius:0,pointHoverRadius:4,tension:.36,fill:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{backgroundColor:'#0A1628',titleFont:chartFont,bodyFont:chartFont,padding:9,displayColors:false}},scales:{x:{grid:{display:false},ticks:{color:'#8B7668',font:chartFont}},y:{beginAtZero:false,min:50,grid:{color:'rgba(226,214,197,.72)'},ticks:{color:'#8B7668',font:chartFont,stepSize:20}}}}});\n    new Chart(document.getElementById('category-chart'),{type:'doughnut',data:{labels:['Facility','Artifact','Equipment','Security','Cleaning'],datasets:[{data:[34,24,18,9,7],backgroundColor:['#D4A017','#374B07','#315E8A','#9A3A2A','#B9652B'],borderWidth:3,borderColor:'#FAF6F0'}]},options:{responsive:true,maintainAspectRatio:false,cutout:'69%',plugins:{legend:{display:false},tooltip:{backgroundColor:'#0A1628',titleFont:chartFont,bodyFont:chartFont,padding:9}}}});\n  }\n</script>\n",
