"1-1-2-2-8-2-2-1-1-3\">\n                                        Monthly brief\n                                    </small>\n                                </button>\n                                <button class=\"export-btn\" data-kid=\"1-1-2-2-8-2-2-1-2\" type=\"button\">\n                                    <i class=\"ti ti-file-spreadsheet\" data-kid=\"1-1-2-2-8-2-2-1-2-1\">\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-8-2-2-1-2-2\">\n                                        Excel\n                                    </span>\n                                    <small data-kid=\"1-1-2-2-8-2-2-1-2-3\">\n                                        Full request data\n                                    </small>\n                                </button>\n                                <button class=\"export-btn\" data-kid=\"1-1-2-2-8-2-2-1-3\" type=\"button\">\n                                    <i class=\"ti ti-printer\" data-kid=\"1-1-2-2-8-2-2-1-3-1\">\n                                    </i>\n                                    <span data-kid=\"1-1-2-2-8-2-2-1-3-2\">\n                                        Print\n                                    </span>\n                                    <small data-kid=\"1-1-2-2-8-2-2-1-3-3\">\n                                        Workboard view\n                                    </small>\n                                </button>\n                            </div>\n                            <div data-dynamic=\"true\" data-kid=\"1-1-2-2-8-2-2-2\" data-name=\"repair completion chart\" data-reason=\"canvas rendered and updated by chart.js library\" style=\"height:125px;margin-top:13px;\">\n                                <canvas aria-label=\"Repair completion rate chart\" data-kid=\"1-1-2-2-8-2-2-2-1\" id=\"completion-chart\">\n                                </canvas>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"panel\" data-kid=\"1-1-2-2-8-3\">\n                        <div class=\"panel-head\" data-kid=\"1-1-2-2-8-3-1\">\n                            <div data-kid=\"1-1-2-2-8-3-1-1\">\n                                <h3 data-kid=\"1-1-2-2-8-3-1-1-1\">\n                                    Notifications\n                                </h3>\n                                <p data-kid=\"1-1-2-2-8-3-1-1-2\">\n                                    Officer and reporter updates\n                                </p>\n                            </div>\n                            <span class=\"badge badge-gold\" data-kid=\"1-1-2-2-8-3-1-2\">\n                                05 new\n                            </span>\n                        </div>\n                        <div class=\"panel-body\" data-kid=\"1-1-2-2-8-3-2\">\n                            <div class=\"notification\" data-kid=\"1-1-2-2-8-3-2-1\">\n                                <span class=\"notification-icon alert\" data-kid=\"1-1-2-2-8-3-2-1-1\">\n                                    <i class=\"ti ti-alert-triangle\" data-kid=\"1-1-2-2-8-3-2-1-1-1\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-1-2-2-8-3-2-1-2\">\n                                    <strong data-kid=\"1-1-2-2-8-3-2-1-2-1\">\n                                        Emergency request submitted\n                                    </strong>\n                                    <span data-kid=\"1-1-2-2-8-3-2-1-2-2\">\n                                        Fire alarm panel offline · Security wing · 14 min ago\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"notification\" data-kid=\"1-1-2-2-8-3-2-2\">\n                                <span class=\"notification-icon\" data-kid=\"1-1-2-2-8-3-2-2-1\">\n                                    <i class=\"ti ti-user-check\" data-kid=\"1-1-2-2-8-3-2-2-1-1\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-1-2-2-8-3-2-2-2\">\n                                    <strong data-kid=\"1-1-2-2-8-3-2-2-2-1\">\n                                        Task assigned to Mekonnen Kassa\n                                    </strong>\n                                    <span data-kid=\"1-1-2-2-8-3-2-2-2-2\">\n                                        HVAC humidity drift · East Gallery · 1h ago\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"notification\" data-kid=\"1-1-2-2-8-3-2-3\">\n                                <span class=\"notification-icon\" data-kid=\"1-1-2-2-8-3-2-3-1\">\n                                    <i class=\"ti ti-message-circle\" data-kid=\"1-1-2-2-8-3-2-3-1-1\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-1-2-2-8-3-2-3-2\">\n                                    <strong data-kid=\"1-1-2-2-8-3-2-3-2-1\">\n                                        Reporter added a comment\n                                    </strong>\n                                    <span data-kid=\"1-1-2-2-8-3-2-3-2-2\">\n                                        Broken display case latch · Hall 02 · 2h ago\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"notification\" data-kid=\"1-1-2-2-8-3-2-4\">\n                                <span class=\"notification-icon\" data-kid=\"1-1-2-2-8-3-2-4-1\">\n                                    <i class=\"ti ti-circle-check\" data-kid=\"1-1-2-2-8-3-2-4-1-1\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-1-2-2-8-3-2-4-2\">\n                                    <strong data-kid=\"1-1-2-2-8-3-2-4-2-1\">\n                                        Repair completed — awaiting verification\n                                    </strong>\n                                    <span data-kid=\"1-1-2-2-8-3-2-4-2-2\">\n                                        Audio guide dock · Visitor services · yesterday\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                </section>\n                <p class=\"footer-note\" data-kid=\"1-1-2-2-9\">\n                    SMRMP Maintenance Management · Design preview for Adwa Victory Memorial Museum · Photo credits: Tahir Xəlfəquliyev, Pew Nguyen, José Andrés Pacheco Cortes, and Blackcurrant Great on Pexels.\n                </p>\n            </main>\n        </div>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    const root = document.getElementById('maintenance-app');\n  const sidebar = document.getElementById('sidebar');\n  const collapse = document.getElementById('collapse-sidebar');\n  const mobileMenu = document.getElementById('mobile-menu');\n  collapse.addEventListener('click', () => { const collapsed = sidebar.classList.toggle('collapsed'); collapse.setAttribute('aria-expanded', String(!collapsed)); collapse.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar'); collapse.innerHTML = '<i class=\"ti ' + (collapsed ? 'ti-chevron-right' : 'ti-chevron-left') + '\" style=\"font-size:14px;width:14px;height:14px;line-height:1;\"></i>'; });\n  mobileMenu.addEventListener('click', () => { sidebar.classList.toggle('mobile-open'); mobileMenu.setAttribute('aria-expanded', String(sidebar.classList.contains('mobile-open'))); });\n  document.querySelectorAll('.view-tabs button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.view-tabs button').forEach((tab) => tab.classList.remove('active')); button.classList.add('active'); }));\n  document.querySelectorAll('.table-toggle button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.table-toggle button').forEach((tab) => tab.classList.remove('active')); button.classList.add('active'); }));\n  document.getElementById('dark-toggle').addEventListener('click', () => { root.classList.toggle('dark-preview'); });\n  const search = document.getElementById('queue-search');\n  search.addEventListener('input', () => { const query = search.value.toLowerCase(); document.querySelectorAll('#request-rows tr').forEach((row) => { row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none'; }); });\n  const chart = document.getElementById('completion-chart');\n  if (window.Chart && chart) { new Chart(chart, { type:'line', data:{ labels:['Jun','Jul','Aug','Sep','Oct','Nov'], datasets:[{ data:[71,76,74,82,88,92], borderColor:'#374B07', backgroundColor:'rgba(55,75,7,.11)', borderWidth:2, pointRadius:2, pointBackgroundColor:'#D4A017', tension:.35, fill:true }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{backgroundColor:'#0A1628',titleFont:{family:'Inter',size:9},bodyFont:{family:'Inter',size:9},padding:8,displayColors:false} }, scales:{ x:{grid:{display:false},ticks:{color:'#8B7668',font:{family:'Inter',size:8}}}, y:{min:60,max:100,grid:{color:'rgba(226,214,197,.75)'},ticks:{color:'#8B7668',font:{family:'Inter',size:8},callback:(value)=>value+'%'} } } } }); }\n</script>\n",
      "comments": [],
      "created": "2026-07-25T19:42:05.493895+00:00",
