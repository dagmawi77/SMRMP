        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/tabler-icons.min.css');\n  :root {\n    --parchment:#F5EFE6;\n    --card:#FAF6F0;\n    --paper:#FFFDF9;\n    --ink:#2B1B12;\n    --muted:#725C4D;\n    --faint:#9C8878;\n    --border:#E2D6C5;\n    --border-dark:#D0BEA8;\n    --navy:#0A1628;\n    --navy-2:#13253D;\n    --navy-3:#1D3554;\n    --gold:#D4A017;\n    --gold-soft:#FAF0D8;\n    --green:#374B07;\n    --green-soft:#E4EEDC;\n    --blue:#315E8A;\n    --blue-soft:#E4EFF7;\n    --red:#9A3A2A;\n    --red-soft:#F6E3DE;\n    --orange:#B9652B;\n    --shadow:0 8px 24px rgba(43,27,18,.06);\n  }\n  .maintenance-app { min-height:100vh; background:var(--parchment); color:var(--ink); font-family:Inter,Arial,sans-serif; font-size:13px; }\n  .maintenance-app * { box-sizing:border-box; }\n  .maintenance-app button,.maintenance-app input,.maintenance-app select { font:inherit; }\n  .maintenance-app button,.maintenance-app a { -webkit-tap-highlight-color:transparent; }\n  .maintenance-app button { cursor:pointer; }\n  .maintenance-app button:focus-visible,.maintenance-app a:focus-visible,.maintenance-app input:focus-visible,.maintenance-app select:focus-visible { outline:3px solid rgba(212,160,23,.7); outline-offset:2px; }\n  .app-frame { min-height:100vh; display:flex; }\n  .sidebar { width:264px; flex:0 0 264px; background:var(--paper); border-right:1px solid var(--border); display:flex; flex-direction:column; position:relative; z-index:20; transition:width .25s ease,transform .25s ease; }\n  .sidebar.collapsed { width:82px; flex-basis:82px; }\n  .brand-row { min-height:78px; padding:18px 20px; background:var(--card); border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }\n  .brand-link { min-width:0; display:flex; align-items:center; gap:12px; color:var(--ink); text-decoration:none; }\n  .brand-mark { width:40px; height:40px; flex:none; display:grid; place-items:center; border-radius:15px; background:var(--gold-soft); border:1px solid rgba(212,160,23,.45); color:var(--green); }\n  .brand-copy { min-width:0; }\n  .brand-copy strong { display:block; font:700 16px/1.1 'Playfair Display',Georgia,serif; letter-spacing:-.02em; }\n  .brand-copy span { display:block; margin-top:4px; color:var(--muted); font-size:10px; font-weight:700; letter-spacing:.11em; text-transform:uppercase; white-space:nowrap; }\n  .collapse-btn { width:26px; height:26px; border-radius:50%; border:1px solid rgba(212,160,23,.5); background:var(--gold-soft); color:#7C4A2D; display:grid; place-items:center; margin-right:-34px; z-index:2; }\n  .nav-scroll { flex:1; overflow:auto; padding:22px 12px 16px; }\n  .nav-label { padding:0 12px 9px; color:#8B7668; font-size:10px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }\n  .nav-group + .nav-group { margin-top:19px; }\n  .nav-link { width:100%; display:flex; align-items:center; gap:13px; margin-bottom:5px; padding:11px 13px; border:0; border-radius:12px; color:#5C4233; background:transparent; text-align:left; text-decoration:none; font-size:12px; font-weight:600; }\n  .nav-link:hover { background:#FAF0E4; color:var(--ink); }\n  .nav-link.active { background:var(--green-soft); color:var(--green); }\n  .nav-icon { width:18px; height:18px; flex:none; display:grid; place-items:center; color:#7C4A2D; }\n  .nav-link.active .nav-icon { color:var(--green); }\n  .nav-copy { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .sidebar.collapsed .brand-copy,.sidebar.collapsed .nav-label,.sidebar.collapsed .nav-copy,.sidebar.collapsed .status-card { display:none; }\n  .sidebar.collapsed .brand-row { justify-content:center; padding-inline:10px; }\n  .sidebar.collapsed .collapse-btn { position:absolute; right:-13px; top:26px; margin-right:0; }\n  .sidebar.collapsed .nav-link { justify-content:center; padding-inline:10px; }\n  .status-card { margin:10px 12px; padding:13px; border:1px solid rgba(212,160,23,.4); background:var(--gold-soft); }\n  .status-title { display:flex; align-items:center; gap:7px; color:#7C4A2D; font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }\n  .status-card p { margin:5px 0 0; color:#5C4233; font-size:11px; line-height:1.45; }\n  .main-column { min-width:0; flex:1; display:flex; flex-direction:column; }\n  .topbar { min-height:64px; flex:0 0 64px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:0 28px; background:rgba(250,246,240,.95); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:15; backdrop-filter:blur(12px); }\n  .topbar-left,.topbar-right { display:flex; align-items:center; gap:11px; min-width:0; }\n  .mobile-menu { display:none; width:34px; height:34px; place-items:center; border:1px solid var(--border); background:var(--paper); color:var(--ink); }\n  .museum-badge { width:32px; height:32px; display:grid; place-items:center; border:1px solid rgba(212,160,23,.3); background:#FAF0E4; color:var(--green); }\n  .topbar-title { color:var(--ink); font-size:12px; font-weight:700; white-space:nowrap; }\n  .topbar-meta { color:var(--faint); font-size:11px; white-space:nowrap; }\n  .operational { display:flex; align-items:center; gap:6px; padding:6px 9px; border:1px solid #B8D4A0; background:var(--green-soft); color:var(--green); font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }\n  .operational-dot { width:6px; height:6px; border-radius:50%; background:var(--green); box-shadow:0 0 0 3px rgba(55,75,7,.11); }\n  .top-search { width:min(300px,24vw); min-width:195px; display:flex; align-items:center; gap:7px; padding:8px 10px; border:1px solid var(--border); background:var(--paper); color:var(--muted); }\n  .top-search input { width:100%; border:0; outline:0; background:transparent; color:var(--ink); font-size:11px; }\n  .top-search kbd { padding:2px 5px; border:1px solid #D8C8B8; background:#EFE5D8; color:#5C4233; font-size:9px; }\n  .top-control { display:flex; align-items:center; gap:6px; min-height:34px; padding:0 9px; border:1px solid var(--border); background:var(--paper); color:var(--muted); font-size:10px; font-weight:700; }\n  .top-control:hover { border-color:rgba(212,160,23,.8); color:var(--ink); }\n  .notification-btn { position:relative; width:34px; height:34px; display:grid; place-items:center; border:1px solid var(--border); background:var(--paper); color:var(--ink); }\n  .notification-count { position:absolute; top:-4px; right:-4px; width:15px; height:15px; display:grid; place-items:center; border-radius:50%; background:var(--red); color:#fff; font-size:8px; font-weight:700; }\n  .user-name { text-align:right; line-height:1.2; }\n  .user-name strong { display:block; font-size:11px; }\n  .user-name span { display:block; margin-top:3px; color:#7C4A2D; font-size:9px; font-weight:700; text-transform:capitalize; }\n  .avatar { width:31px; height:31px; display:grid; place-items:center; border-radius:50%; background:var(--navy); color:var(--gold); font:700 11px 'Playfair Display',serif; }\n  .workspace { width:100%; max-width:1530px; padding:25px 28px 40px; margin:0 auto; }\n  .breadcrumb { display:flex; align-items:center; gap:7px; color:var(--faint); font-size:10px; font-weight:600; }\n  .breadcrumb strong { color:var(--ink); }\n  .hero { position:relative; overflow:hidden; display:grid; grid-template-columns:minmax(0,1.28fr) minmax(330px,.72fr); gap:22px; margin-top:11px; padding:27px 29px; background:var(--navy); border:1px solid #203450; box-shadow:0 14px 32px rgba(10,22,40,.16); color:#F5EFE6; }\n  .hero::after { position:absolute; right:-80px; bottom:-150px; width:390px; height:390px; border:1px solid rgba(212,160,23,.2); border-radius:50%; content:''; box-shadow:0 0 0 28px rgba(212,160,23,.04),0 0 0 56px rgba(212,160,23,.03); pointer-events:none; }\n  .eyebrow { display:flex; align-items:center; gap:9px; color:#D7B55B; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }\n  .eyebrow::before { width:26px; height:1px; background:var(--gold); content:''; }\n  .hero h1 { max-width:730px; margin:10px 0 8px; color:#FFFDF9; font:700 clamp(29px,3vw,43px)/1.05 'Playfair Display',Georgia,serif; letter-spacing:-.035em; }\n  .hero-copy { max-width:630px; color:rgba(245,239,230,.72); font-size:12px; line-height:1.55; }\n  .hero-meta { display:flex; flex-wrap:wrap; gap:9px 18px; margin-top:16px; color:#EAD9AD; font-size:10px; }\n  .hero-meta span { display:flex; align-items:center; gap:5px; }\n  .hero-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:21px; }\n  .btn { min-height:35px; display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:8px 12px; border:1px solid transparent; border-radius:8px; font-size:11px; font-weight:700; }\n  .btn-gold { background:var(--gold); color:#241710; border-color:#E6B82F; }\n  .btn-gold:hover { background:#E6B82F; }\n  .btn-quiet { background:rgba(255,255,255,.07); color:#FFFDF9; border-color:rgba(255,255,255,.24); }\n  .btn-quiet:hover { background:rgba(255,255,255,.13); }\n  .btn-paper { background:var(--paper); color:var(--ink); border-color:var(--border); }\n  .btn-paper:hover { border-color:rgba(212,160,23,.8); background:#FFF9ED; }\n  .hero-side { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:space-between; min-width:0; }\n  .hero-photo { position:relative; overflow:hidden; min-height:180px; border:1px solid rgba(255,255,255,.19); background:#07101e; }\n  .hero-photo img { width:100%; height:100%; min-height:180px; display:block; object-fit:cover; opacity:.72; }\n  .hero-photo::after { position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,22,40,.64),rgba(10,22,40,.08)); content:''; pointer-events:none; }\n  .photo-caption { position:absolute; left:13px; bottom:12px; z-index:1; color:#FFFDF9; font-size:10px; font-weight:700; }\n  .photo-caption span { display:block; margin-top:3px; color:rgba(255,253,249,.62); font-size:9px; font-weight:500; }\n  .health-card { margin-top:12px; padding:12px 13px; border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.06); }\n  .health-head { display:flex; align-items:center; justify-content:space-between; color:#FFFDF9; font-size:11px; font-weight:700; }\n  .health-head span { color:#BBD899; font-size:10px; }\n  .health-bar { height:7px; margin-top:11px; background:rgba(255,255,255,.12); overflow:hidden; }\n  .health-bar span { display:block; width:84%; height:100%; background:linear-gradient(90deg,var(--gold),#A8C276); }\n  .health-foot { display:flex; justify-content:space-between; margin-top:8px; color:rgba(255,255,255,.62); font-size:9px; }\n  .section-head { display:flex; align-items:flex-end; justify-content:space-between; gap:15px; margin:27px 0 11px; }\n  .section-head h2 { margin:0; color:var(--ink); font:700 20px/1.1 'Playfair Display',Georgia,serif; letter-spacing:-.02em; }\n  .section-head p { margin:5px 0 0; color:var(--muted); font-size:11px; }\n  .section-link { color:var(--green); font-size:11px; font-weight:700; text-decoration:none; }\n  .kpi-grid { display:grid; grid-template-columns:repeat(8,minmax(0,1fr)); gap:9px; }\n  .kpi { min-height:108px; position:relative; display:flex; flex-direction:column; justify-content:space-between; padding:13px 13px 12px; border:1px solid var(--border); background:var(--card); box-shadow:0 4px 14px rgba(43,27,18,.03); }\n  .kpi::before { position:absolute; top:0; left:0; width:100%; height:3px; background:var(--gold); content:''; }\n  .kpi.green::before { background:var(--green); }\n  .kpi.blue::before { background:var(--blue); }\n  .kpi.red::before { background:var(--red); }\n  .kpi-top { display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--muted); font-size:10px; font-weight:600; }\n  .kpi-icon { width:28px; height:28px; display:grid; place-items:center; flex:none; border:1px solid var(--border); background:#F3EBDD; color:#7C4A2D; }\n  .kpi-value { margin-top:8px; color:var(--ink); font:700 24px/1 'Playfair Display',Georgia,serif; }\n  .kpi-note { margin-top:6px; color:var(--green); font-size:9px; font-weight:700; }\n  .kpi-note.warn { color:var(--red); }\n  .analytics-grid { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(225px,.75fr) minmax(220px,.75fr); gap:13px; }\n  .panel { border:1px solid var(--border); background:var(--card); box-shadow:var(--shadow); }\n  .panel-pad { padding:16px 17px; }\n  .panel-title { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }\n  .panel-title h3 { margin:0; color:var(--ink); font-size:12px; font-weight:700; }\n  .panel-title p { margin:4px 0 0; color:var(--muted); font-size:10px; }\n  .mini-select { border:1px solid var(--border); background:var(--paper); color:var(--muted); padding:5px 7px; font-size:9px; }\n  .chart-wrap { height:190px; margin-top:12px; }\n  .chart-wrap.small { height:150px; }\n  .chart-legend { display:flex; align-items:center; gap:14px; margin-top:8px; color:var(--muted); font-size:9px; }\n  .legend-dot { width:7px; height:7px; border-radius:50%; background:var(--gold); }\n  .legend-dot.green { background:var(--green); }\n  .legend-dot.blue { background:var(--blue); }\n  .metric-row { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-top:19px; }\n  .metric-big { color:var(--ink); font:700 31px/1 'Playfair Display',Georgia,serif; }\n  .metric-delta { color:var(--green); font-size:10px; font-weight:700; }\n  .metric-sub { margin-top:5px; color:var(--muted); font-size:10px; }\n  .ring { width:105px; height:105px; position:relative; display:grid; place-items:center; flex:none; border-radius:50%; background:conic-gradient(var(--green) 0 84%, #E9DED0 84% 100%); }\n  .ring::after { position:absolute; inset:11px; border-radius:50%; background:var(--card); content:''; }\n  .ring strong,.ring span { position:relative; z-index:1; }\n  .ring strong { color:var(--ink); font:700 23px/1 'Playfair Display',Georgia,serif; }\n  .ring span { margin-top:1px; color:var(--muted); font-size:9px; }\n  .ring-copy { display:flex; flex-direction:column; align-items:center; position:relative; z-index:2; }\n  .scale-list { margin-top:13px; display:grid; gap:9px; }\n  .scale-line { display:grid; grid-template-columns:79px 1fr 31px; align-items:center; gap:7px; color:var(--muted); font-size:9px; }\n  .scale-line b { color:var(--ink); text-align:right; font-size:10px; }\n  .scale-bar { height:6px; background:#E9DED0; overflow:hidden; }\n  .scale-bar span { display:block; height:100%; background:var(--gold); }\n  .scale-bar.green span { background:var(--green); }\n  .scale-bar.blue span { background:var(--blue); }\n  .queue-panel { margin-top:13px; }\n  .queue-toolbar { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:14px; }\n  .toolbar-left,.toolbar-right { display:flex; align-items:center; gap:7px; flex-wrap:wrap; }\n  .search-field { min-width:260px; display:flex; align-items:center; gap:7px; padding:8px 10px; border:1px solid var(--border); background:var(--paper); color:var(--muted); }\n  .search-field input { width:100%; border:0; outline:0; background:transparent; color:var(--ink); font-size:11px; }\n  .filter-btn { display:inline-flex; align-items:center; gap:6px; min-height:34px; padding:7px 9px; border:1px solid var(--border); background:var(--paper); color:var(--muted); font-size:10px; font-weight:700; }\n  .filter-btn:hover { border-color:rgba(212,160,23,.8); color:var(--ink); }\n  .table-wrap { overflow:auto; margin:13px -17px -16px; border-top:1px solid var(--border); }\n  .request-table { width:100%; min-width:850px; border-collapse:collapse; }\n  .request-table th { padding:10px 15px; background:#F3EBDD; color:#806B5C; text-align:left; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; white-space:nowrap; }\n  .request-table td { padding:12px 15px; border-top:1px solid #EDE4D7; color:var(--ink); font-size:10px; white-space:nowrap; }\n  .request-table tbody tr:hover { background:#FFF9ED; }\n  .request-id { color:var(--green); font-size:10px; font-weight:700; }\n  .issue-title { display:flex; align-items:center; gap:8px; }\n  .issue-title strong { font-size:10px; }\n  .issue-title span { display:block; margin-top:3px; color:var(--muted); font-size:9px; }\n  .issue-thumb { width:30px; height:30px; object-fit:cover; border:1px solid var(--border); }\n  .badge { display:inline-flex; align-items:center; gap:5px; padding:4px 7px; border:1px solid transparent; font-size:9px; font-weight:700; }\n  .badge.green { background:var(--green-soft); border-color:#B8D4A0; color:var(--green); }\n  .badge.gold { background:var(--gold-soft); border-color:#E2C96D; color:#7C4A2D; }\n  .badge.red { background:var(--red-soft); border-color:#E2B3A7; color:var(--red); }\n  .badge.blue { background:var(--blue-soft); border-color:#B9D1E5; color:var(--blue); }\n  .badge.gray { background:#F0E9E0; border-color:#DDD1C2; color:#725C4D; }\n  .avatar-stack { display:flex; align-items:center; }\n  .avatar-stack span { width:23px; height:23px; display:grid; place-items:center; margin-left:-4px; border:2px solid var(--card); border-radius:50%; background:#D6BE9C; color:#4A2C1B; font-size:8px; font-weight:700; }\n  .avatar-stack span:first-child { margin-left:0; background:#B9D1E5; }\n  .avatar-stack span:last-child { background:#D9E7B7; }\n  .row-actions { display:flex; gap:4px; }\n  .icon-btn { width:27px; height:27px; display:grid; place-items:center; border:1px solid var(--border); background:var(--paper); color:var(--muted); }\n  .icon-btn:hover { border-color:rgba(212,160,23,.8); color:var(--ink); background:#FFF9ED; }\n  .table-footer { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 15px; border-top:1px solid var(--border); color:var(--muted); font-size:9px; }\n  .pagination { display:flex; gap:4px; }\n  .page-btn { width:26px; height:25px; display:grid; place-items:center; border:1px solid var(--border); background:var(--paper); color:var(--muted); font-size:9px; }\n  .page-btn.active { background:var(--green); border-color:var(--green); color:#fff; }\n  .workflow { display:grid; grid-template-columns:repeat(7,1fr); gap:0; margin-top:14px; padding:17px; background:var(--navy); border:1px solid #203450; color:#FFFDF9; }\n  .workflow-step { position:relative; min-height:74px; padding:0 12px; border-left:1px solid rgba(255,255,255,.14); }\n  .workflow-step:first-child { padding-left:2px; border-left:0; }\n  .workflow-step:not(:last-child)::after { position:absolute; top:13px; right:-7px; width:13px; height:13px; border-top:1px solid var(--gold); border-right:1px solid var(--gold); transform:rotate(45deg); background:var(--navy); content:''; z-index:1; }\n  .workflow-index { width:27px; height:27px; display:grid; place-items:center; margin-bottom:10px; border-radius:50%; background:rgba(212,160,23,.16); border:1px solid rgba(212,160,23,.6); color:#E6C96D; font-size:10px; font-weight:700; }\n  .workflow-step.current .workflow-index { background:var(--gold); color:#241710; }\n  .workflow-step h4 { margin:0; font-size:10px; }\n  .workflow-step p { margin:4px 0 0; color:rgba(255,255,255,.54); font-size:9px; line-height:1.35; }\n  .lower-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(270px,.78fr) minmax(250px,.72fr); gap:13px; margin-top:14px; }\n  .timeline,.calendar-list,.asset-list { margin:12px 0 0; padding:0; list-style:none; }\n  .timeline li,.calendar-list li,.asset-list li { display:flex; align-items:flex-start; gap:10px; padding:10px 0; border-bottom:1px solid #EDE4D7; }\n  .timeline li:last-child,.calendar-list li:last-child,.asset-list li:last-child { border-bottom:0; }\n  .timeline-dot { width:8px; height:8px; flex:none; margin-top:4px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 3px rgba(212,160,23,.14); }\n  .timeline-dot.green { background:var(--green); box-shadow:0 0 0 3px rgba(55,75,7,.12); }\n  .timeline-dot.red { background:var(--red); box-shadow:0 0 0 3px rgba(154,58,42,.12); }\n  .list-copy { min-width:0; flex:1; }\n  .list-copy strong { display:block; color:var(--ink); font-size:10px; line-height:1.3; }\n  .list-copy span { display:block; margin-top:3px; color:var(--muted); font-size:9px; line-height:1.35; }\n  .list-time { color:var(--faint); font-size:9px; white-space:nowrap; }\n  .date-box { width:40px; flex:none; padding:6px 4px; border:1px solid var(--border); background:#F3EBDD; text-align:center; }\n  .date-box strong { display:block; color:var(--green); font:700 17px/1 'Playfair Display',Georgia,serif; }\n  .date-box span { display:block; margin-top:3px; color:var(--muted); font-size:8px; font-weight:700; text-transform:uppercase; }\n  .asset-list li { align-items:center; }\n  .asset-icon { width:32px; height:32px; display:grid; place-items:center; flex:none; border:1px solid var(--border); background:#F3EBDD; color:#7C4A2D; }\n  .asset-score { min-width:33px; color:var(--green); text-align:right; font-size:10px; font-weight:700; }\n  .asset-score.warn { color:var(--orange); }\n  .mini-bar { height:5px; margin-top:5px; background:#E9DED0; overflow:hidden; }\n  .mini-bar span { display:block; height:100%; background:var(--green); }\n  .mini-bar.warn span { background:var(--orange); }\n  .emergency-rail { display:grid; grid-template-columns:1.1fr .9fr; gap:13px; margin-top:14px; }\n  .emergency-card { position:relative; overflow:hidden; min-height:174px; padding:17px; border:1px solid #E2B3A7; background:var(--red-soft); }\n  .emergency-card::after { position:absolute; right:-34px; bottom:-50px; width:150px; height:150px; border:1px solid rgba(154,58,42,.18); border-radius:50%; content:''; }\n  .alert-label { display:flex; align-items:center; gap:7px; color:var(--red); font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }\n  .emergency-card h3 { max-width:450px; margin:10px 0 6px; color:#5A2016; font:700 22px/1.05 'Playfair Display',Georgia,serif; }\n  .emergency-card p { max-width:520px; margin:0; color:#7A463C; font-size:10px; line-height:1.45; }\n  .alert-meta { display:flex; flex-wrap:wrap; gap:8px 16px; margin-top:13px; color:#7A463C; font-size:9px; font-weight:600; }\n  .contact-card { padding:17px; border:1px solid var(--border); background:var(--navy); color:#FFFDF9; }\n  .contact-card h3 { margin:0; font:700 18px/1.1 'Playfair Display',Georgia,serif; }\n  .contact-card p { margin:6px 0 13px; color:rgba(255,255,255,.62); font-size:10px; line-height:1.4; }\n  .contact-list { display:grid; gap:9px; }\n  .contact-item { display:flex; align-items:center; gap:9px; padding-top:9px; border-top:1px solid rgba(255,255,255,.13); }\n  .contact-avatar { width:27px; height:27px; display:grid; place-items:center; border-radius:50%; background:#D9E7B7; color:var(--green); font-size:9px; font-weight:700; }\n  .contact-item strong { display:block; font-size:10px; }\n  .contact-item span { display:block; margin-top:2px; color:rgba(255,255,255,.54); font-size:9px; }\n  .report-strip { display:grid; grid-template-columns:1.15fr repeat(4,1fr); gap:9px; margin-top:14px; }\n  .report-intro { padding:15px; border:1px solid #D6C5AE; background:#EFE3D1; }\n  .report-intro h3 { margin:0; color:var(--ink); font:700 17px/1.1 'Playfair Display',Georgia,serif; }\n  .report-intro p { margin:6px 0 0; color:var(--muted); font-size:10px; line-height:1.35; }\n  .report-card { min-height:88px; display:flex; flex-direction:column; justify-content:space-between; padding:13px; border:1px solid var(--border); background:var(--paper); color:var(--ink); text-align:left; }\n  .report-card:hover { border-color:rgba(212,160,23,.8); background:#FFF9ED; }\n  .report-card span { color:var(--green); }\n  .report-card strong { font-size:10px; }\n  .report-card small { color:var(--muted); font-size:9px; }\n  .footer { margin-top:22px; padding-top:14px; border-top:1px solid var(--border); color:#8B7668; font-size:9px; line-height:1.45; }\n  .toast { position:fixed; right:24px; bottom:24px; z-index:50; display:flex; align-items:center; gap:8px; padding:10px 13px; background:var(--green); border:1px solid #91AB68; color:#F8F7E8; box-shadow:0 10px 20px rgba(36,50,5,.2); font-size:11px; font-weight:700; opacity:0; transform:translateY(14px); pointer-events:none; transition:opacity .2s ease,transform .2s ease; }\n  .toast.show { opacity:1; transform:translateY(0); }\n  .drawer-backdrop { display:none; }\n  .dark-preview { --parchment:#151A20; --card:#20262E; --paper:#181E25; --ink:#F5EFE6; --muted:#B8AA9B; --faint:#95897D; --border:#39414A; --border-dark:#4B5662; --gold-soft:#332B18; --green-soft:#253321; --blue-soft:#1F3040; --red-soft:#3A2422; --shadow:0 8px 24px rgba(0,0,0,.18); }\n  .dark-preview .topbar { background:rgba(32,38,46,.94); }\n  .dark-preview .nav-link:hover,.dark-preview .request-table tbody tr:hover,.dark-preview .filter-btn:hover,.dark-preview .icon-btn:hover,.dark-preview .btn-paper:hover,.dark-preview .report-card:hover { background:#2C343D; }\n  .dark-preview .request-table th,.dark-preview .date-box,.dark-preview .kpi-icon,.dark-preview .asset-icon { background:#2A3139; }\n  .dark-preview .ring::after { background:var(--card); }\n  @media (max-width:1200px) {\n    .kpi-grid { grid-template-columns:repeat(4,1fr); }\n    .analytics-grid { grid-template-columns:1.35fr .8fr; }\n    .analytics-grid > .panel:last-child { grid-column:1 / -1; }\n    .lower-grid { grid-template-columns:1fr 1fr; }\n    .lower-grid > .panel:first-child { grid-column:1 / -1; }\n    .report-strip { grid-template-columns:repeat(4,1fr); }\n    .report-intro { grid-column:1 / -1; }\n  }\n  @media (max-width:860px) {\n    .sidebar { position:fixed; inset:0 auto 0 0; transform:translateX(-105%); box-shadow:12px 0 35px rgba(10,22,40,.18); }\n    .sidebar.mobile-open { transform:translateX(0); }\n    .sidebar.collapsed { width:264px; flex-basis:264px; }\n    .sidebar.collapsed .brand-copy,.sidebar.collapsed .nav-label,.sidebar.collapsed .nav-copy,.sidebar.collapsed .status-card { display:block; }\n    .sidebar.collapsed .brand-row { justify-content:space-between; padding-inline:20px; }\n    .sidebar.collapsed .collapse-btn { display:none; }\n    .sidebar.collapsed .nav-link { justify-content:flex-start; padding-inline:13px; }\n    .mobile-menu { display:grid; }\n    .top-search,.operational,.topbar-meta,.user-name { display:none; }\n    .topbar { padding-inline:14px; }\n    .workspace { padding:17px 14px 28px; }\n    .hero { grid-template-columns:1fr; padding:21px; }\n    .hero-side { max-width:640px; }\n    .queue-toolbar { align-items:stretch; flex-direction:column; }\n    .toolbar-left,.toolbar-right { width:100%; }\n    .search-field { flex:1; }\n    .workflow { grid-template-columns:repeat(4,1fr); gap:15px 0; }\n    .workflow-step:nth-child(4)::after { display:none; }\n    .emergency-rail { grid-template-columns:1fr; }\n    .report-strip { grid-template-columns:repeat(2,1fr); }\n    .report-intro { grid-column:1 / -1; }\n  }\n  @media (max-width:560px) {\n    .topbar-title { font-size:11px; }\n    .top-control span { display:none; }\n    .avatar { display:none; }\n    .hero h1 { font-size:29px; }\n    .hero-actions .btn { width:100%; }\n    .kpi-grid { grid-template-columns:repeat(2,1fr); }\n    .kpi { min-height:105px; }\n    .analytics-grid,.lower-grid { grid-template-columns:1fr; }\n    .analytics-grid > .panel:last-child,.lower-grid > .panel:first-child { grid-column:auto; }\n    .workflow { grid-template-columns:repeat(2,1fr); }\n    .workflow-step:nth-child(2)::after,.workflow-step:nth-child(4)::after,.workflow-step:nth-child(6)::after { display:none; }\n    .workflow-step { border-left:0; }\n    .report-strip { grid-template-columns:1fr 1fr; }\n    .table-footer { align-items:flex-start; flex-direction:column; }\n  }\n</style>\n<div class=\"maintenance-app\" data-kid=\"1\" data-name=\"maintenance application root\" id=\"maintenance-app\">\n    <!-- REUSE: PrivateLayout from smrmp-frontend/src/components/layout/PrivateLayout.jsx -->\n    <div class=\"app-frame\" data-kid=\"1-1\" data-name=\"app layout container\">\n        <!-- REUSE: Sidebar from smrmp-frontend/src/components/layout/Sidebar.jsx -->\n        <aside aria-label=\"Maintenance module navigation\" class=\"sidebar\" data-kid=\"1-1-1\" data-name=\"navigation sidebar\" id=\"sidebar\">\n            <div class=\"brand-row\" data-kid=\"1-1-1-1\" data-name=\"sidebar brand and collapse container\">\n                <a aria-label=\"SMRMP Maintenance Dashboard\" class=\"brand-link\" data-kid=\"1-1-1-1-1\" data-name=\"museum dashboard branding link\" href=\"#dashboard\">\n                    <span class=\"brand-mark\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon\">\n                        <i aria-hidden=\"true\" class=\"ti ti-building-museum\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"museum building icon\" style=\"font-size:21px;width:21px;height:21px;color:#374B07;line-height:1;\">\n                        </i>\n                    </span>\n                    <span class=\"brand-copy\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name and subtitle\">\n                        <strong data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand name\">\n                            SMRMP\n                        </strong>\n                        <span data-kid=\"1-1-1-1-1-2-2\" data-name=\"brand subtitle\">\n                            Maintenance portal\n                        </span>\n                    </span>\n                </a>\n                <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"collapse-btn\" data-dynamic=\"true\" data-kid=\"1-1-1-1-2\" data-name=\"sidebar collapse toggle button\" data-reason=\"icon and aria-label updated by script 