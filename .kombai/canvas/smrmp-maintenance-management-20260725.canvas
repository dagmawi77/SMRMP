      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  :root {\n    --parchment:#F5EFE6; --card:#FAF6F0; --white:#FFFDF9; --ink:#2B1B12; --muted:#6E5445;\n    --border:#E2D6C5; --brown:#7C4A2D; --navy:#0A1628; --navy-2:#152238; --gold:#D4A017;\n    --gold-soft:#FAF0D8; --green:#374B07; --green-soft:#E4EEDC; --red:#9A3A2A; --red-soft:#F6E1DC;\n    --blue:#315E8A; --blue-soft:#E3EDF5; --shadow:0 8px 24px rgba(43,27,18,.055);\n  }\n  .maintenance-app { min-height:100vh; background:var(--parchment); color:var(--ink); font-family:Inter,Arial,sans-serif; }\n  .maintenance-app * { box-sizing:border-box; }\n  .maintenance-app button,.maintenance-app input,.maintenance-app select { font:inherit; }\n  .maintenance-app button,.maintenance-app a { -webkit-tap-highlight-color:transparent; }\n  .maintenance-app button:focus-visible,.maintenance-app a:focus-visible,.maintenance-app input:focus-visible,.maintenance-app select:focus-visible { outline:3px solid rgba(212,160,23,.75); outline-offset:2px; }\n  .app-frame { display:flex; min-height:100vh; }\n  .sidebar { width:254px; flex:0 0 254px; background:var(--white); border-right:1px solid var(--border); display:flex; flex-direction:column; position:relative; z-index:20; transition:width .25s ease,transform .25s ease; }\n  .sidebar.collapsed { width:76px; flex-basis:76px; }\n  .brand-row { min-height:78px; padding:18px 18px 18px 20px; background:var(--card); border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }\n  .brand-link { display:flex; align-items:center; gap:11px; color:var(--ink); text-decoration:none; min-width:0; }\n  .brand-mark { width:40px; height:40px; flex:none; display:grid; place-items:center; border-radius:15px; background:var(--gold-soft); border:1px solid rgba(212,160,23,.45); color:var(--green); }\n  .brand-copy { min-width:0; }\n  .brand-copy strong { display:block; font:700 16px/1.1 'Playfair Display',Georgia,serif; letter-spacing:-.02em; }\n  .brand-copy span { display:block; margin-top:4px; color:var(--muted); font-size:9px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }\n  .collapse-btn { width:26px; height:26px; margin-right:-33px; border:1px solid rgba(212,160,23,.45); border-radius:50%; background:var(--gold-soft); color:var(--brown); display:grid; place-items:center; z-index:3; }\n  .nav-scroll { flex:1; overflow:auto; padding:20px 11px 14px; }\n  .nav-group { margin-bottom:18px; }\n  .nav-label { padding:0 12px 8px; color:#8B7668; font-size:9px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }\n  .nav-link { width:100%; display:flex; align-items:center; gap:12px; margin-bottom:4px; padding:10px 12px; border-radius:11px; color:#5C4233; background:transparent; text-decoration:none; font-size:11px; font-weight:600; }\n  .nav-link:hover { background:#FAF0E4; color:var(--ink); }\n  .nav-link.active { background:var(--green-soft); color:var(--green); }\n  .nav-icon { width:18px; height:18px; flex:none; display:grid; place-items:center; color:var(--brown); }\n  .nav-link.active .nav-icon { color:var(--green); }\n  .sidebar.collapsed .brand-copy,.sidebar.collapsed .nav-label,.sidebar.collapsed .nav-copy,.sidebar.collapsed .sidebar-note { display:none; }\n  .sidebar.collapsed .brand-row { justify-content:center; padding-inline:10px; }\n  .sidebar.collapsed .collapse-btn { position:absolute; right:-13px; top:26px; margin-right:0; }\n  .sidebar.collapsed .nav-link { justify-content:center; padding-inline:10px; }\n  .sidebar-note { margin:10px 11px 14px; padding:12px; border:1px solid rgba(212,160,23,.4); background:var(--gold-soft); border-radius:12px; }\n  .sidebar-note-title { display:flex; align-items:center; gap:6px; color:var(--brown); font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }\n  .sidebar-note p { margin:5px 0 0; color:#5C4233; font-size:10px; line-height:1.4; }\n  .main-column { min-width:0; flex:1; display:flex; flex-direction:column; }\n  .topbar { height:60px; flex:0 0 60px; display:flex; align-items:center; justify-content:space-between; gap:14px; padding:0 24px; background:rgba(250,246,240,.96); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:15; backdrop-filter:blur(14px); }\n  .topbar-left,.topbar-right { display:flex; align-items:center; gap:11px; min-width:0; }\n  .mobile-menu { display:none; width:32px; height:32px; border:1px solid var(--border); border-radius:9px; background:var(--white); color:var(--ink); place-items:center; }\n  .museum-chip { width:31px; height:31px; display:grid; place-items:center; border-radius:9px; color:var(--green); background:#FAF0E4; border:1px solid rgba(212,160,23,.3); }\n  .topbar-title { font-size:11px; font-weight:700; white-space:nowrap; }\n  .topbar-meta { color:var(--muted); font-size:10px; white-space:nowrap; }\n  .operational { display:flex; align-items:center; gap:6px; border:1px solid #B8D4A0; background:var(--green-soft); color:var(--green); border-radius:999px; padding:5px 9px; font-size:9px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }\n  .operational-dot { width:6px; height:6px; border-radius:50%; background:var(--green); box-shadow:0 0 0 3px rgba(55,75,7,.12); }\n  .top-search { width:min(260px,25vw); min-width:190px; display:flex; align-items:center; gap:7px; padding:7px 10px; border:1px solid var(--border); border-radius:9px; background:var(--white); color:var(--muted); font-size:10px; }\n  .top-search kbd { margin-left:auto; padding:2px 5px; border:1px solid #D8C8B8; background:#EFE5D8; color:var(--brown); border-radius:4px; font-size:8px; }\n  .lang-select,.icon-btn { height:31px; display:flex; align-items:center; gap:6px; border:1px solid var(--border); border-radius:8px; background:var(--white); color:var(--ink); padding:0 8px; font-size:9px; font-weight:700; }\n  .icon-btn { width:31px; justify-content:center; padding:0; }\n  .icon-btn .notif-dot { position:absolute; width:6px; height:6px; margin:-18px 0 0 14px; border-radius:50%; background:var(--red); border:1px solid var(--white); }\n  .user-name { text-align:right; line-height:1.2; }\n  .user-name strong { display:block; font-size:10px; }\n  .user-name span { display:block; margin-top:3px; color:var(--brown); font-size:8px; font-weight:700; text-transform:capitalize; }\n  .avatar { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:var(--navy); color:var(--gold); font:700 11px 'Playfair Display',serif; }\n  .workspace { width:100%; max-width:1540px; margin:0 auto; padding:23px 25px 28px; }\n  .hero { display:flex; justify-content:space-between; gap:20px; padding:22px 24px; color:#F5EFE6; background:var(--navy); border:1px solid #203450; box-shadow:0 12px 28px rgba(10,22,40,.14); }\n  .hero-copy { min-width:0; }\n  .eyebrow { display:flex; align-items:center; gap:8px; color:#E6C96D; font-size:9px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }\n  .eyebrow::before { content:''; width:25px; height:1px; background:var(--gold); }\n  .hero h1 { margin:8px 0 5px; color:#FFFDF9; font:700 clamp(27px,3.2vw,42px)/1.05 'Playfair Display',Georgia,serif; letter-spacing:-.04em; }\n  .hero p { max-width:600px; margin:0; color:rgba(245,239,230,.72); font-size:11px; line-height:1.5; }\n  .hero-meta { display:flex; flex-wrap:wrap; gap:10px 16px; margin-top:13px; color:#EAD9AD; font-size:9px; }\n  .hero-actions { display:flex; align-items:flex-start; justify-content:flex-end; gap:8px; flex-wrap:wrap; min-width:250px; }\n  .btn { min-height:33px; display:inline-flex; align-items:center; justify-content:center; gap:6px; border:1px solid transparent; border-radius:8px; padding:8px 11px; font-size:10px; font-weight:700; cursor:pointer; }\n  .btn-gold { background:var(--gold); color:#241710; border-color:#E6B82F; }\n  .btn-gold:hover { background:#E6B82F; }\n  .btn-quiet { background:rgba(255,255,255,.06); color:#FFFDF9; border-color:rgba(255,255,255,.25); }\n  .btn-quiet:hover { background:rgba(255,255,255,.12); }\n  .btn-light { background:var(--white); color:var(--ink); border-color:var(--border); }\n  .btn-light:hover { border-color:rgba(212,160,23,.75); background:#FFF9ED; }\n  .section-head { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin:22px 0 10px; }\n  .section-head h2 { margin:0; font:700 20px/1.1 'Playfair Display',Georgia,serif; letter-spacing:-.02em; }\n  .section-head p { margin:4px 0 0; color:var(--muted); font-size:10px; }\n  .section-link { color:var(--green); font-size:10px; font-weight:700; text-decoration:none; }\n  .kpi-strip { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:9px; margin-top:14px; }\n  .kpi { min-height:79px; display:flex; align-items:flex-start; justify-content:space-between; gap:8px; padding:12px; border:1px solid var(--border); border-top:3px solid var(--gold); background:var(--card); box-shadow:var(--shadow); }\n  .kpi.emergency { border-top-color:var(--red); }\n  .kpi.risk { border-top-color:#B67E1B; }\n  .kpi-label { color:var(--muted); font-size:9px; font-weight:600; }\n  .kpi-value { margin-top:5px; color:var(--ink); font:700 22px/1 'Playfair Display',Georgia,serif; }\n  .kpi-delta { margin-top:4px; color:var(--green); font-size:8px; font-weight:700; }\n  .kpi.emergency .kpi-delta { color:var(--red); }\n  .kpi-icon { width:28px; height:28px; display:grid; place-items:center; flex:none; color:var(--brown); background:#F3EBDD; border:1px solid #E2D6C5; }\n  .workboard-shell { display:grid; grid-template-columns:212px minmax(0,1fr) 286px; gap:12px; align-items:start; }\n  .rail,.panel { border:1px solid var(--border); background:var(--card); box-shadow:var(--shadow); }\n  .rail-head,.panel-head { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; padding:13px 14px 10px; border-bottom:1px solid #EDE4D7; }\n  .rail-head h3,.panel-head h3 { margin:0; color:var(--ink); font-size:11px; font-weight:700; }\n  .rail-head p,.panel-head p { margin:4px 0 0; color:var(--muted); font-size:9px; line-height:1.35; }\n  .rail-body,.panel-body { padding:12px 14px; }\n  .incident-card { margin-bottom:9px; padding:10px; border:1px solid #E3B6AA; background:var(--red-soft); }\n  .incident-card:last-child { margin-bottom:0; }\n  .incident-top { display:flex; align-items:center; justify-content:space-between; gap:6px; }\n  .incident-card strong { color:#6E2419; font-size:10px; line-height:1.3; }\n  .incident-card p { margin:4px 0 0; color:#8A493B; font-size:8px; line-height:1.45; }\n  .badge { display:inline-flex; align-items:center; gap:4px; white-space:nowrap; border-radius:999px; padding:4px 6px; font-size:8px; font-weight:700; }\n  .badge-red { color:#8C2A1C; background:#F4CFC6; }\n  .badge-gold { color:#7C4A2D; background:#F5E8C4; }\n  .badge-green { color:var(--green); background:#DCEBCF; }\n  .badge-blue { color:#234D73; background:#D7E5F0; }\n  .approval-row { display:flex; align-items:flex-start; gap:8px; padding:9px 0; border-bottom:1px solid #EDE4D7; }\n  .approval-row:last-child { border-bottom:0; padding-bottom:0; }\n  .approval-dot { width:7px; height:7px; margin-top:4px; flex:none; border-radius:50%; background:var(--gold); }\n  .approval-row strong { display:block; color:var(--ink); font-size:9px; line-height:1.3; }\n  .approval-row span { display:block; margin-top:3px; color:var(--muted); font-size:8px; }\n  .calendar-panel { min-width:0; }\n  .calendar-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; padding:13px 14px 11px; border-bottom:1px solid #EDE4D7; }\n  .calendar-title { display:flex; align-items:center; gap:8px; }\n  .calendar-title h3 { margin:0; font:700 20px/1 'Playfair Display',Georgia,serif; letter-spacing:-.02em; }\n  .calendar-title span { color:var(--muted); font-size:9px; }\n  .view-tabs { display:flex; gap:3px; padding:3px; border:1px solid var(--border); background:var(--white); border-radius:8px; }\n  .view-tabs button { border:0; border-radius:6px; padding:6px 8px; color:var(--muted); background:transparent; font-size:9px; font-weight:700; }\n  .view-tabs button.active { color:var(--ink); background:var(--gold-soft); }\n  .calendar-nav { display:flex; align-items:center; gap:5px; }\n  .calendar-nav button { width:26px; height:26px; display:grid; place-items:center; border:1px solid var(--border); border-radius:7px; background:var(--white); color:var(--brown); }\n  .calendar-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); border-left:1px solid #EDE4D7; border-top:1px solid #EDE4D7; }\n  .day-name { padding:8px 8px; color:#8B7668; background:#F7F1E9; border-right:1px solid #EDE4D7; border-bottom:1px solid #EDE4D7; font-size:8px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }\n  .day-cell { min-height:97px; padding:7px; background:var(--card); border-right:1px solid #EDE4D7; border-bottom:1px solid #EDE4D7; }\n  .day-cell.muted-day { background:#F4EEE7; }\n  .day-num { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:9px; font-weight:700; }\n  .day-num.current { color:var(--green); }\n  .day-num.current::after { content:'today'; color:var(--green); font-size:7px; font-weight:700; text-transform:uppercase; }\n  .event { display:block; margin-top:5px; padding:5px 5px 4px; border-left:3px solid var(--gold); background:#F7EDD2; color:#5F431F; font-size:8px; font-weight:700; line-height:1.25; }\n  .event span { display:block; margin-top:2px; color:#906F3C; font-size:7px; font-weight:500; }\n  .event.green { border-left-color:var(--green); background:#E5EEDC; color:var(--green); }\n  .event.green span { color:#61783A; }\n  .event.red { border-left-color:var(--red); background:#F5DFDA; color:#8C2A1C; }\n  .event.red span { color:#A45344; }\n  .event.blue { border-left-color:var(--blue); background:#E4EDF5; color:#234D73; }\n  .event.blue span { color:#587B9D; }\n  .swimlanes { margin-top:10px; border-top:1px solid #EDE4D7; }\n  .swim-head { display:flex; align-items:center; justify-content:space-between; padding:10px 12px 8px; color:var(--muted); font-size:9px; font-weight:700; }\n  .lane { display:grid; grid-template-columns:145px repeat(7,minmax(0,1fr)); border-top:1px solid #EDE4D7; }\n  .lane-person { display:flex; align-items:center; gap:7px; padding:9px 10px; color:var(--ink); font-size:9px; font-weight:700; background:#F7F1E9; }\n  .mini-avatar { width:22px; height:22px; display:grid; place-items:center; border-radius:50%; background:var(--navy); color:var(--gold); font-size:8px; }\n  .lane-slot { min-height:34px; border-left:1px solid #EDE4D7; display:grid; place-items:center; color:#C6B6A5; font-size:8px; }\n  .lane-slot span { min-width:20px; padding:3px 4px; border-radius:4px; color:var(--green); background:var(--green-soft); text-align:center; font-size:8px; font-weight:700; }\n  .lane-slot span.warn { color:#7C4A2D; background:#F5E8C4; }\n  .lane-slot span.alert { color:#8C2A1C; background:#F4CFC6; }\n  .selected-request { border:1px solid #203450; background:var(--navy); color:#FFFDF9; }\n  .selected-request .panel-head { border-bottom-color:rgba(255,255,255,.14); }\n  .selected-request .panel-head h3 { color:#FFFDF9; }\n  .selected-request .panel-head p { color:rgba(255,255,255,.55); }\n  .selected-request .panel-body { padding:13px 14px; }\n  .request-kicker { color:#E6C96D; font-size:8px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }\n  .request-title { margin:6px 0 7px; color:#FFFDF9; font:700 20px/1.08 'Playfair Display',Georgia,serif; }\n  .request-location { display:flex; align-items:center; gap:5px; color:rgba(255,255,255,.65); font-size:9px; }\n  .request-details { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:14px; padding-top:12px; border-top:1px solid rgba(255,255,255,.14); }\n  .request-detail label { display:block; color:rgba(255,255,255,.45); font-size:8px; text-transform:uppercase; letter-spacing:.08em; }\n  .request-detail strong { display:block; margin-top:3px; color:#FFFDF9; font-size:10px; }\n  .assignee { display:flex; align-items:center; gap:8px; margin-top:14px; padding:9px; border:1px solid rgba(255,255,255,.14); background:rgba(255,255,255,.055); }\n  .assignee .mini-avatar { background:var(--gold); color:var(--ink); }\n  .assignee-copy { min-width:0; }\n  .assignee-copy strong { display:block; font-size:9px; }\n  .assignee-copy span { display:block; margin-top:2px; color:rgba(255,255,255,.55); font-size:8px; }\n  .assignee-date { margin-left:auto; text-align:right; }\n  .assignee-date small { display:block; color:rgba(255,255,255,.45); font-size:7px; }\n  .assignee-date strong { display:block; margin-top:2px; color:#E6C96D; font-size:9px; }\n  .attachment-strip { display:flex; gap:5px; margin-top:13px; }\n  .attachment { width:45px; height:38px; overflow:hidden; position:relative; border:1px solid rgba(255,255,255,.22); background:#1B2A42; }\n  .attachment img { width:100%; height:100%; object-fit:cover; opacity:.8; }\n  .attachment span { position:absolute; right:2px; bottom:2px; padding:2px 3px; border-radius:3px; background:rgba(10,22,40,.82); color:#FFFDF9; font-size:7px; }\n  .timeline { position:relative; margin:15px 0 0 4px; padding-left:17px; }\n  .timeline::before { content:''; position:absolute; left:4px; top:5px; bottom:5px; width:1px; background:rgba(255,255,255,.2); }\n  .timeline-item { position:relative; margin-bottom:10px; }\n  .timeline-item:last-child { margin-bottom:0; }\n  .timeline-dot { position:absolute; left:-17px; top:2px; width:9px; height:9px; border-radius:50%; background:var(--gold); border:2px solid var(--navy); box-shadow:0 0 0 1px rgba(212,160,23,.6); }\n  .timeline-dot.done { background:#9AB977; box-shadow:0 0 0 1px rgba(154,185,119,.6); }\n  .timeline-item strong { display:block; color:#FFFDF9; font-size:9px; }\n  .timeline-item span { display:block; margin-top:2px; color:rgba(255,255,255,.5); font-size:8px; }\n  .workflow { display:flex; align-items:center; gap:4px; overflow:auto; padding:10px 12px; border-top:1px solid rgba(255,255,255,.13); }\n  .workflow-step { display:flex; align-items:center; gap:4px; white-space:nowrap; color:rgba(255,255,255,.45); font-size:7px; font-weight:700; }\n  .workflow-step::after { content:'›'; margin-left:1px; color:rgba(255,255,255,.28); font-size:12px; }\n  .workflow-step:last-child::after { display:none; }\n  .workflow-step.active { color:#E6C96D; }\n  .workflow-step.done { color:#B8D4A0; }\n  .step-dot { width:12px; height:12px; display:grid; place-items:center; border-radius:50%; background:rgba(255,255,255,.12); font-size:7px; }\n  .workflow-step.active .step-dot { color:var(--ink); background:var(--gold); }\n  .workflow-step.done .step-dot { color:var(--green); background:#B8D4A0; }\n  .queue-panel { margin-top:14px; }\n  .queue-tools { display:flex; align-items:center; gap:7px; flex-wrap:wrap; padding:11px 14px; border-bottom:1px solid #EDE4D7; }\n  .queue-search { flex:1; min-width:210px; display:flex; align-items:center; gap:7px; padding:7px 9px; border:1px solid var(--border); border-radius:8px; background:var(--white); color:var(--muted); }\n  .queue-search input { width:100%; min-width:0; border:0; outline:0; background:transparent; color:var(--ink); font-size:9px; }\n  .filter-btn,.select-control { height:30px; display:flex; align-items:center; gap:6px; border:1px solid var(--border); border-radius:8px; background:var(--white); color:var(--ink); padding:0 9px; font-size:9px; font-weight:700; }\n  .table-toggle { display:flex; padding:3px; border:1px solid var(--border); border-radius:8px; background:var(--white); }\n  .table-toggle button { width:27px; height:23px; border:0; border-radius:5px; color:var(--muted); background:transparent; }\n  .table-toggle button.active { color:var(--ink); background:var(--gold-soft); }\n  .request-table { width:100%; border-collapse:collapse; }\n  .request-table th { padding:9px 12px; color:#8B7668; background:#F7F1E9; border-bottom:1px solid #EDE4D7; text-align:left; font-size:8px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; white-space:nowrap; }\n  .request-table td { padding:10px 12px; color:var(--ink); border-bottom:1px solid #EDE4D7; font-size:9px; vertical-align:middle; }\n  .request-table tr:last-child td { border-bottom:0; }\n  .request-table tbody tr:hover { background:#FFF9ED; }\n  .request-id { color:var(--brown); font-weight:700; }\n  .issue-cell strong { display:block; font-size:9px; }\n  .issue-cell span { display:block; margin-top:3px; color:var(--muted); font-size:8px; }\n  .person-cell { display:flex; align-items:center; gap:6px; white-space:nowrap; }\n  .person-cell .mini-avatar { width:20px; height:20px; font-size:7px; }\n  .table-actions { display:flex; align-items:center; gap:4px; }\n  .table-actions button { width:24px; height:24px; display:grid; place-items:center; border:1px solid var(--border); border-radius:6px; background:var(--white); color:var(--brown); }\n  .pagination { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 14px; color:var(--muted); font-size:8px; }\n  .pagination-actions { display:flex; gap:4px; }\n  .pagination-actions button { width:24px; height:24px; display:grid; place-items:center; border:1px solid var(--border); border-radius:6px; background:var(--white); color:var(--brown); }\n  .asset-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:11px; }\n  .asset-card { overflow:hidden; position:relative; border:1px solid var(--border); background:var(--white); }\n  .asset-image { width:100%; height:83px; display:block; object-fit:cover; }\n  .asset-content { padding:11px; }\n  .asset-content h3 { margin:0; color:var(--ink); font-size:11px; }\n  .asset-content p { margin:4px 0 9px; color:var(--muted); font-size:8px; line-height:1.35; }\n  .asset-progress { display:flex; align-items:center; gap:7px; color:var(--muted); font-size:8px; }\n  .progress-bar { height:5px; flex:1; background:#E9DED0; }\n  .progress-bar span { display:block; height:100%; background:var(--green); }\n  .matrix-labels { display:grid; grid-template-columns:1fr 1fr; gap:5px; margin-top:9px; }\n  .matrix-label { padding:5px 6px; border:1px solid #EDE4D7; color:#5C4233; background:#F7F1E9; font-size:8px; font-weight:700; }\n  .lower-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(250px,.75fr) minmax(260px,.75fr); gap:12px; margin-top:14px; }\n  .history-row { display:grid; grid-template-columns:55px 1fr auto; gap:8px; align-items:center; padding:9px 0; border-bottom:1px solid #EDE4D7; }\n  .history-row:last-child { border-bottom:0; padding-bottom:0; }\n  .history-date { color:var(--green); font-size:8px; font-weight:700; }\n  .history-copy strong { display:block; color:var(--ink); font-size:9px; }\n  .history-copy span { display:block; margin-top:3px; color:var(--muted); font-size:8px; }\n  .history-hours { color:var(--brown); font-size:8px; font-weight:700; }\n  .export-list { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-top:10px; }\n  .export-btn { display:flex; flex-direction:column; align-items:flex-start; gap:9px; padding:9px; border:1px solid var(--border); background:var(--white); color:var(--ink); text-align:left; }\n  .export-btn:hover { border-color:rgba(212,160,23,.7); background:#FFF9ED; }\n  .export-btn i { color:var(--green); font-size:15px; }\n  .export-btn span { font-size:9px; font-weight:700; }\n  .export-btn small { color:var(--muted); font-size:8px; }\n  .notification { display:flex; align-items:flex-start; gap:8px; padding:9px 0; border-bottom:1px solid #EDE4D7; }\n  .notification:last-child { border-bottom:0; padding-bottom:0; }\n  .notification-icon { width:22px; height:22px; display:grid; place-items:center; flex:none; border-radius:7px; color:var(--green); background:var(--green-soft); }\n  .notification-icon.alert { color:var(--red); background:var(--red-soft); }\n  .notification strong { display:block; color:var(--ink); font-size:9px; line-height:1.25; }\n  .notification span { display:block; margin-top:3px; color:var(--muted); font-size:8px; line-height:1.35; }\n  .dark-preview { display:none; }\n  .footer-note { margin-top:18px; color:#8B7668; font-size:8px; line-height:1.4; }\n  @media (max-width:1220px) { .workboard-shell { grid-template-columns:190px minmax(0,1fr); } .selected-request { grid-column:1 / -1; } .selected-request .panel-body { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:14px; } .selected-request .panel-head { grid-column:1 / -1; } .selected-request .request-details { margin-top:0; padding-top:0; border-top:0; } .selected-request .assignee,.selected-request .attachment-strip,.selected-request .timeline { margin-top:0; } .selected-request .workflow { grid-column:1 / -1; } .lower-grid { grid-template-columns:1fr 1fr; } .lower-grid > .panel:last-child { grid-column:1 / -1; } }\n  @media (max-width:930px) { .sidebar { position:fixed; inset:0 auto 0 0; transform:translateX(-105%); box-shadow:12px 0 35px rgba(10,22,40,.18); } .sidebar.mobile-open { transform:translateX(0); } .sidebar.collapsed { width:254px; flex-basis:254px; } .sidebar.collapsed .brand-copy,.sidebar.collapsed .nav-label,.sidebar.collapsed .nav-copy,.sidebar.collapsed .sidebar-note { display:block; } .sidebar.collapsed .nav-link { justify-content:flex-start; padding-inline:12px; } .sidebar.collapsed .brand-row { justify-content:space-between; padding-inline:20px; } .sidebar.collapsed .collapse-btn { display:none; } .mobile-menu { display:grid; } .top-search,.operational,.topbar-meta,.user-name { display:none; } .topbar { padding-inline:14px; } .workspace { padding:16px 14px 22px; } .hero { flex-direction:column; padding:20px; } .hero-actions { justify-content:flex-start; } .kpi-strip { grid-template-columns:repeat(3,1fr); } .workboard-shell { grid-template-columns:1fr; } .rail { order:2; } .calendar-panel { order:1; } .selected-request { order:3; grid-column:auto; } .selected-request .panel-body { display:block; } .selected-request .request-details,.selected-request .assignee,.selected-request .attachment-strip,.selected-request .timeline { margin-top:13px; } .selected-request .request-details { padding-top:12px; border-top:1px solid rgba(255,255,255,.14); } }\n  @media (max-width:650px) { .topbar-title { font-size:10px; } .lang-select { display:none; } .workspace { padding-inline:11px; } .hero h1 { font-size:29px; } .hero-actions .btn { width:100%; } .kpi-strip { grid-template-columns:repeat(2,1fr); } .calendar-top { flex-wrap:wrap; } .calendar-title { width:100%; } .calendar-grid { min-width:690px; } .calendar-panel { overflow-x:auto; } .calendar-panel .calendar-top,.calendar-panel .swimlanes,.calendar-panel .calendar-grid { width:690px; } .lane { grid-template-columns:120px repeat(7,1fr); } .queue-panel { overflow:hidden; } .request-table { min-width:920px; } .queue-tools { min-width:920px; } .asset-grid,.lower-grid { grid-template-columns:1fr; } .lower-grid > .panel:last-child { grid-column:auto; } }\n</style>\n<!-- REUSE: PrivateLayout from smrmp-frontend/src/components/layout/PrivateLayout.jsx -->\n<!-- REUSE: Sidebar from smrmp-frontend/src/components/layout/Sidebar.jsx -->\n<!-- REUSE: Navbar from smrmp-frontend/src/components/layout/Navbar.jsx -->\n<div class=\"maintenance-app\" data-kid=\"1\" data-name=\"maintenance management application\" id=\"maintenance-app\">\n    <div class=\"app-frame\" data-kid=\"1-1\" data-name=\"app layout container\">\n        <aside aria-label=\"Maintenance module navigation\" class=\"sidebar\" data-kid=\"1-1-1\" data-name=\"navigation sidebar\" id=\"sidebar\">\n            <div class=\"brand-row\" data-kid=\"1-1-1-1\" data-name=\"brand identity row\">\n                <a aria-label=\"SMRMP maintenance dashboard\" class=\"brand-link\" data-kid=\"1-1-1-1-1\" data-name=\"museum dashboard home link\" href=\"#dashboard\">\n                    <span class=\"brand-mark\" data-kid=\"1-1-1-1-1-1\" data-name=\"museum brand logo container\">\n                        <i class=\"ti ti-building-museum\" data-kid=\"1-1-1-1-1-1-1\" style=\"font-size:21px;width:21px;height:21px;line-height:1;\">\n                        </i>\n                    </span>\n                    <span class=\"brand-copy\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name and subtitle\">\n                        <strong data-kid=\"1-1-1-1-1-2-1\">\n                            SMRMP\n                        </strong>\n                        <span data-kid=\"1-1-1-1-1-2-2\">\n                            Maintenance portal\n                        </span>\n                    </span>\n                </a>\n                <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"collapse-btn\" data-dynamic=\"true\" data-kid=\"1-1-1-1-2\" data-name=\"sidebar collapse button\" data-reason=\"aria-expanded, aria-label and icon swapped on click\" id=\"collapse-sidebar\" type=\"button\">\n                    <i class=\"ti ti-chevron-left\" data-kid=\"1-1-1-1-2-1\" style=\"font-size:14px;width:14px;height:14px;line-height:1;\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"nav-scroll\" data-kid=\"1-1-1-2\" data-name=\"navigation link container\">\n                <div class=\"nav-group\" data-kid=\"1-1-1-2-1\" data-name=\"operations navigation group\">\n                    <div class=\"nav-label\" data-kid=\"1-1-1-2-1-1\">\n                        Operations\n                    </div>\n                    <a class=\"nav-link active\" data-kid=\"1-1-1-2-1-2\" href=\"#dashboard\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-1-2-1\">\n                            <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-1-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-1-2-2\">\n                            Maintenance Dashboard\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-1-3\" href=\"#requests\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-1-3-1\">\n                            <i class=\"ti ti-clipboard-list\" data-kid=\"1-1-1-2-1-3-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-1-3-2\">\n                            Maintenance Requests\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-1-4\" href=\"#create\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-1-4-1\">\n                            <i class=\"ti ti-circle-plus\" data-kid=\"1-1-1-2-1-4-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-1-4-2\">\n                            Create Request\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-1-5\" href=\"#assigned\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-1-5-1\">\n                            <i class=\"ti ti-user-check\" data-kid=\"1-1-1-2-1-5-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-1-5-2\">\n                            Assigned Tasks\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-1-6\" href=\"#emergency\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-1-6-1\">\n                            <i class=\"ti ti-alert-triangle\" data-kid=\"1-1-1-2-1-6-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-1-6-2\">\n                            Emergency Incidents\n                        </span>\n                    </a>\n                </div>\n                <div class=\"nav-group\" data-kid=\"1-1-1-2-2\">\n                    <div class=\"nav-label\" data-kid=\"1-1-1-2-2-1\">\n                        Assets\n                    </div>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-2\" href=\"#artifact-damage\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-2-2-1\">\n                            <i class=\"ti ti-history\" data-kid=\"1-1-1-2-2-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-2-2-2\">\n                            Artifact Damage\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-3\" href=\"#equipment\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-2-3-1\">\n                            <i class=\"ti ti-device-desktop-cog\" data-kid=\"1-1-1-2-2-3-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-2-3-2\">\n                            Equipment Issues\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-4\" href=\"#facility\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-2-4-1\">\n                            <i class=\"ti ti-building\" data-kid=\"1-1-1-2-2-4-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-2-4-2\">\n                            Facility Issues\n                        </span>\n                    </a>\n                </div>\n                <div class=\"nav-group\" data-kid=\"1-1-1-2-3\">\n                    <div class=\"nav-label\" data-kid=\"1-1-1-2-3-1\">\n                        Planning\n                    </div>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-3-2\" href=\"#calendar\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-3-2-1\">\n                            <i class=\"ti ti-calendar-event\" data-kid=\"1-1-1-2-3-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-3-2-2\">\n                            Maintenance Calendar\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-3-3\" href=\"#history\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-3-3-1\">\n                            <i class=\"ti ti-history-toggle\" data-kid=\"1-1-1-2-3-3-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-3-3-2\">\n                            Repair History\n                        </span>\n                    </a>\n                </div>\n                <div class=\"nav-group\" data-kid=\"1-1-1-2-4\">\n                    <div class=\"nav-label\" data-kid=\"1-1-1-2-4-1\">\n                        Insights\n                    </div>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-4-2\" href=\"#reports\">\n                        <span class=\"nav-icon\" data-kid=\"1-1-1-2-4-2-1\">\n                            <i class=\"ti ti-chart-dots-3\" data-kid=\"1-1-1-2-4-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"nav-copy\" data-kid=\"1-1-1-2-4-2-2\">\n                            Reports\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"sidebar-note\" data-kid=\"1-1-1-3\" data-name=\"museum information note\">\n                <div class=\"sidebar-note-title\" data-kid=\"1-1-1-3-1\">\n                    <i class=\"ti ti-building-museum\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-1-2\">\n                        Adwa Museum\n                    </span>\n                </div>\n                <p data-kid=\"1-1-1-3-2\">\n                    Maintenance operations active\n                    <br data-kid=\"1-1-1-3-2-1\"/>\n                    የጥገና ሥራ ንቁ\n                </p>\n            </div>\n        </aside>\n        <div class=\"main-column\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <header class=\"topbar\" data-kid=\"1-1-2-1\" data-name=\"top navigation bar\">\n                <div class=\"topbar-left\" data-kid=\"1-1-2-1-1\" data-name=\"top bar left section\">\n                    <button aria-expanded=\"false\" aria-label=\"Open navigation\" class=\"mobile-menu\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1\" data-name=\"mobile navigation menu button\" data-reason=\"aria-expanded attribute toggled by script\" id=\"mobile-menu\" type=\"button\">\n                        <i class=\"ti ti-menu-2\" data-kid=\"1-1-2-1-1-1-1\">\n                        </i>\n                    </button>\n                    <span class=\"museum-chip\" data-kid=\"1-1-2-1-1-2\">\n                        <i class=\"ti ti-building-museum\" data-kid=\"1-1-2-1-1-2-1\">\n                        </i>\n                    </span>\n                    <span class=\"topbar-title\" data-kid=\"1-1-2-1-1-3\">\n                        Adwa Victory Memorial Museum\n                    </span>\n                    <span class=\"topbar-meta\" data-kid=\"1-1-2-1-1-4\">\n                        / SMRMP / Maintenance\n                    </