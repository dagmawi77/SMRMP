2-2\">\n                                <div class=\"report-icon\" data-kid=\"1-1-2-2-9-1-2-2-1\">\n                                    <i class=\"ti ti-vase\" data-kid=\"1-1-2-2-9-1-2-2-1-1\">\n                                    </i>\n                                </div>\n                                <div class=\"report-copy\" data-kid=\"1-1-2-2-9-1-2-2-2\">\n                                    <strong data-kid=\"1-1-2-2-9-1-2-2-2-1\">\n                                        Artifact repair report\n                                    </strong>\n                                    <span data-kid=\"1-1-2-2-9-1-2-2-2-2\">\n                                        Q4 conservation · 7 objects\n                                    </span>\n                                </div>\n                                <div class=\"report-actions\" data-kid=\"1-1-2-2-9-1-2-2-3\">\n                                    <button data-kid=\"1-1-2-2-9-1-2-2-3-1\">\n                                        PDF\n                                    </button>\n                                    <button data-kid=\"1-1-2-2-9-1-2-2-3-2\">\n                                        Print\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"report-row\" data-kid=\"1-1-2-2-9-1-2-3\">\n                                <div class=\"report-icon\" data-kid=\"1-1-2-2-9-1-2-3-1\">\n                                    <i class=\"ti ti-alert-triangle\" data-kid=\"1-1-2-2-9-1-2-3-1-1\">\n                                    </i>\n                                </div>\n                                <div class=\"report-copy\" data-kid=\"1-1-2-2-9-1-2-3-2\">\n                                    <strong data-kid=\"1-1-2-2-9-1-2-3-2-1\">\n                                        Emergency incident summary\n                                    </strong>\n                                    <span data-kid=\"1-1-2-2-9-1-2-3-2-2\">\n                                        Open cases · 2 active\n                                    </span>\n                                </div>\n                                <div class=\"report-actions\" data-kid=\"1-1-2-2-9-1-2-3-3\">\n                                    <button data-kid=\"1-1-2-2-9-1-2-3-3-1\">\n                                        PDF\n                                    </button>\n                                    <button data-kid=\"1-1-2-2-9-1-2-3-3-2\">\n                                        Excel\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"panel panel-pad\" data-kid=\"1-1-2-2-9-2\" id=\"notifications\">\n                        <div class=\"panel-title\" data-kid=\"1-1-2-2-9-2-1\">\n                            <div data-kid=\"1-1-2-2-9-2-1-1\">\n                                <h3 data-kid=\"1-1-2-2-9-2-1-1-1\">\n                                    Notification center\n                                </h3>\n                                <p data-kid=\"1-1-2-2-9-2-1-1-2\">\n                                    English · Afaan Oromo · አማርኛ\n                                </p>\n                            </div>\n                            <span class=\"nav-count\" data-dynamic=\"true\" data-kid=\"1-1-2-2-9-2-1-2\" data-name=\"new notifications count\" data-reason=\"number updated dynamically by system\" style=\"background:var(--gold-soft);color:#8D6A1B\">\n                                6 new\n                            </span>\n                        </div>\n                        <div class=\"notification-list\" data-kid=\"1-1-2-2-9-2-2\">\n                            <div class=\"notification\" data-kid=\"1-1-2-2-9-2-2-1\">\n                                <span class=\"notification-mark\" data-kid=\"1-1-2-2-9-2-2