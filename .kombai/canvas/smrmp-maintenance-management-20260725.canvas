      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n  :root {\n    --navy:#0A1628; --navy-2:#13243B; --ink:#2B1B12; --muted:#725E50;\n    --parchment:#F5EFE6; --card:#FAF6F0; --white:#FFFDF9; --border:#E2D6C5;\n    --gold:#D4A017; --gold-soft:#FAF0D8; --green:#374B07; --green-soft:#E4EEDC;\n    --blue:#315E8A; --blue-soft:#E6EEF6; --red:#9A3A2A; --red-soft:#F5E4DF;\n    --amber:#A96916; --amber-soft:#F7EDD7; --shadow:0 8px 22px rgba(43,27,18,.055);\n  }\n  .maintenance-app{min-height:100vh;background:var(--parchment);color:var(--ink);font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.45;}\n  .maintenance-app *{box-sizing:border-box;}\n  .maintenance-app button,.maintenance-app input,.maintenance-app select{font:inherit;}\n  .maintenance-app button{cursor:pointer;}\n  .maintenance-app button:focus-visible,.maintenance-app a:focus-visible,.maintenance-app input:focus-visible,.maintenance-app select:focus-visible{outline:3px solid rgba(212,160,23,.78);outline-offset:2px;}\n  .maintenance-app .app-frame{display:flex;min-height:100vh;}\n  .maintenance-app .sidebar{width:256px;flex:0 0 256px;background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;position:relative;z-index:10;}\n  .maintenance-app .brand-row{min-height:78px;display:flex;align-items:center;gap:12px;padding:18px 20px;background:var(--card);border-bottom:1px solid var(--border);}\n  .maintenance-app .brand-mark{width:40px;height:40px;border-radius:15px;display:grid;place-items:center;background:var(--gold-soft);border:1px solid rgba(212,160,23,.45);color:var(--green);flex:none;}\n  .maintenance-app .brand-copy{min-width:0;}\n  .maintenance-app .brand-copy strong{display:block;font:700 16px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.02em;}\n  .maintenance-app .brand-copy span{display:block;margin-top:4px;color:var(--muted);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;}\n  .maintenance-app .nav-scroll{flex:1;overflow:auto;padding:22px 12px 15px;}\n  .maintenance-app .nav-label{padding:0 12px 9px;color:#8B7668;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;}\n  .maintenance-app .nav-section{margin:19px 0 8px;padding:0 12px;color:#B18A55;font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;}\n  .maintenance-app .nav-link{display:flex;align-items:center;gap:12px;width:100%;margin-bottom:4px;padding:10px 12px;border-radius:11px;color:#5C4233;text-decoration:none;font-size:12px;font-weight:600;}\n  .maintenance-app .nav-link:hover{background:#FAF0E4;color:var(--ink);}\n  .maintenance-app .nav-link.active{background:var(--green-soft);color:var(--green);}\n  .maintenance-app .nav-link.active .nav-icon{color:var(--green);}\n  .maintenance-app .nav-icon{width:18px;height:18px;display:grid;place-items:center;flex:none;color:#7C4A2D;font-size:18px;line-height:1;}\n  .maintenance-app .nav-count{margin-left:auto;padding:3px 6px;border-radius:999px;background:var(--red-soft);color:var(--red);font-size:9px;font-weight:700;}\n  .maintenance-app .museum-card{margin:12px;padding:13px;border:1px solid rgba(212,160,23,.4);border-radius:13px;background:var(--gold-soft);}\n  .maintenance-app .museum-card-title{display:flex;align-items:center;gap:7px;color:#7C4A2D;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;}\n  .maintenance-app .museum-card p{margin:5px 0 0;color:#5C4233;font-size:10px;line-height:1.45;}\n  .maintenance-app .main-column{min-width:0;flex:1;display:flex;flex-direction:column;}\n  .maintenance-app .topbar{height:60px;flex:0 0 60px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 27px;background:rgba(250,246,240,.94);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:8;backdrop-filter:blur(12px);}\n  .maintenance-app .topbar-left,.maintenance-app .topbar-right{display:flex;align-items:center;gap:12px;min-width:0;}\n  .maintenance-app .museum-badge{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:#FAF0E4;border:1px solid rgba(212,160,23,.32);color:var(--green);font-size:16px;}\n  .maintenance-app .topbar-title{font-size:12px;font-weight:700;white-space:nowrap;}\n  .maintenance-app .topbar-meta{color:var(--muted);font-size:10px;white-space:nowrap;}\n  .maintenance-app .operational{display:flex;align-items:center;gap:6px;padding:5px 9px;border:1px solid #B8D4A0;border-radius:999px;background:var(--green-soft);color:var(--green);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}\n  .maintenance-app .operational-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(55,75,7,.12);}\n  .maintenance-app .top-search{display:flex;align-items:center;gap:7px;min-width:225px;width:min(300px,28vw);padding:8px 10px;border:1px solid var(--border);border-radius:9px;background:var(--white);color:#957E6C;font-size:10px;}\n  .maintenance-app .top-search kbd{margin-left:auto;padding:2px 5px;border:1px solid #D8C8B8;border-radius:4px;background:#EFE5D8;color:#5C4233;font-size:9px;}\n  .maintenance-app .user-name{text-align:right;line-height:1.2;}.maintenance-app .user-name strong{display:block;font-size:10px;}.maintenance-app .user-name span{display:block;margin-top:3px;color:#7C4A2D;font-size:9px;font-weight:700;}\n  .maintenance-app .avatar{width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:var(--navy);color:var(--gold);font:700 11px 'Playfair Display',serif;}\n  .maintenance-app .icon-btn{width:31px;height:31px;display:grid;place-items:center;border:1px solid var(--border);border-radius:8px;background:var(--white);color:#6E5445;font-size:16px;}\n  .maintenance-app .workspace{width:100%;max-width:1460px;margin:0 auto;padding:22px 27px 28px;}\n  .maintenance-app .hero{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:24px 27px;color:var(--parchment);background:var(--navy);border:1px solid #203450;box-shadow:0 12px 28px rgba(10,22,40,.15);}\n  .maintenance-app .eyebrow{display:flex;align-items:center;gap:9px;color:#E8C86B;font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;}.maintenance-app .eyebrow:before{content:'';width:26px;height:1px;background:var(--gold);}\n  .maintenance-app .hero h1{margin:8px 0 6px;color:var(--white);font:700 clamp(27px,3vw,39px)/1.06 'Playfair Display',Georgia,serif;letter-spacing:-.035em;}.maintenance-app .hero p{max-width:620px;margin:0;color:rgba(245,239,230,.72);font-size:11px;line-height:1.55;}.maintenance-app .hero-context{display:flex;align-items:center;gap:7px;margin-top:13px;color:#E8D8AF;font-size:10px;}.maintenance-app .hero-context span{color:rgba(245,239,230,.45);}\n  .maintenance-app .hero-actions{display:flex;flex-direction:column;align-items:flex-end;gap:11px;min-width:232px;}.maintenance-app .response-box{width:100%;padding:11px 13px;border:1px solid rgba(212,160,23,.35);background:rgba(255,255,255,.055);}.maintenance-app .response-top{display:flex;align-items:center;justify-content:space-between;color:#D9E7B7;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}.maintenance-app .response-top strong{color:#F8E6A4;font-size:11px;letter-spacing:0;text-transform:none;}.maintenance-app .response-bar{height:5px;margin-top:8px;background:rgba(255,255,255,.14);}.maintenance-app .response-bar span{display:block;width:86%;height:100%;background:var(--gold);}.maintenance-app .response-copy{margin-top:6px;color:rgba(245,239,230,.58);font-size:9px;}\n  .maintenance-app .btn{min-height:33px;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:8px 12px;border:1px solid transparent;border-radius:8px;font-size:10px;font-weight:700;text-decoration:none;}.maintenance-app .btn-gold{background:var(--gold);border-color:#E6B82F;color:#241710;}.maintenance-app .btn-gold:hover{background:#E6B82F;}.maintenance-app .btn-quiet{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.24);color:var(--white);}.maintenance-app .btn-white{background:var(--white);border-color:var(--border);color:var(--ink);}.maintenance-app .btn-soft{background:var(--gold-soft);border-color:#E9D7AB;color:#7C4A2D;}\n  .maintenance-app .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin:24px 0 11px;}.maintenance-app .section-head h2{margin:0;color:var(--ink);font:700 21px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.02em;}.maintenance-app .section-head p{margin:4px 0 0;color:var(--muted);font-size:10px;}.maintenance-app .section-link{color:var(--green);font-size:10px;font-weight:700;text-decoration:none;}\n  .maintenance-app .health-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:13px;}.maintenance-app .panel{border:1px solid var(--border);background:var(--card);box-shadow:var(--shadow);}.maintenance-app .panel-pad{padding:15px 16px;}.maintenance-app .panel-title{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}.maintenance-app .panel-title h3{margin:0;color:var(--ink);font-size:12px;font-weight:700;}.maintenance-app .panel-title p{margin:4px 0 0;color:var(--muted);font-size:9px;}.maintenance-app .panel-title i{color:#7C4A2D;font-size:16px;}\n  .maintenance-app .health-feature{min-height:185px;position:relative;overflow:hidden;color:var(--white);background:#1A2114;border-color:#BCA76C;}.maintenance-app .health-feature img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.47;}.maintenance-app .health-feature:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,22,40,.92),rgba(10,22,40,.48));}.maintenance-app .health-feature-content{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:space-between;min-height:185px;padding:16px 17px;}.maintenance-app .health-feature .panel-title h3{color:var(--white);}.maintenance-app .health-feature .panel-title p{color:rgba(255,253,249,.68);}.maintenance-app .health-score{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-top:19px;}.maintenance-app .score-number{font:700 39px/.9 'Playfair Display',serif;color:#F9E29A;}.maintenance-app .score-number small{font:600 13px/1 Inter,Arial,sans-serif;color:rgba(255,253,249,.65);}.maintenance-app .score-copy{max-width:184px;color:rgba(255,253,249,.7);font-size:9px;line-height:1.4;}.maintenance-app .score-copy strong{display:block;margin-bottom:3px;color:#D9E7B7;font-size:10px;}.maintenance-app .health-meter{height:6px;margin-top:13px;background:rgba(255,255,255,.15);}.maintenance-app .health-meter span{display:block;height:100%;width:82%;background:var(--gold);}.maintenance-app .metric-row{display:flex;align-items:center;gap:9px;margin-top:18px;}.maintenance-app .metric-row .metric-number{font:700 28px/.9 'Playfair Display',serif;color:var(--ink);}.maintenance-app .metric-label{color:var(--muted);font-size:9px;line-height:1.35;}.maintenance-app .metric-label strong{display:block;color:var(--green);font-size:10px;}.maintenance-app .mini-bars{display:flex;align-items:flex-end;gap:4px;height:52px;margin-top:14px;padding:0 2px;border-bottom:1px solid #E5D8C7;}.maintenance-app .mini-bars span{flex:1;background:#B9C79D;}.maintenance-app .mini-bars span:nth-child(2),.maintenance-app .mini-bars span:nth-child(5),.maintenance-app .mini-bars span:nth-child(8){background:var(--green);}.maintenance-app .mini-legend{display:flex;justify-content:space-between;margin-top:7px;color:#957E6C;font-size:8px;}.maintenance-app .readiness-list{display:grid;gap:9px;margin-top:16px;}.maintenance-app .readiness-item{display:grid;grid-template-columns:76px 1fr 28px;align-items:center;gap:7px;color:var(--muted);font-size:9px;}.maintenance-app .readiness-item strong{color:var(--ink);font-size:9px;text-align:right;}.maintenance-app .readiness-track{height:5px;background:#E9DED0;}.maintenance-app .readiness-track span{display:block;height:100%;background:var(--green);}.maintenance-app .readiness-track.warn span{background:var(--amber);}\n  .maintenance-app .risk-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(330px,.85fr);gap:13px;}.maintenance-app .matrix{min-height:279px;position:relative;margin-top:15px;padding:20px 21px 22px 32px;border-left:1px solid #D9C9B7;border-bottom:1px solid #D9C9B7;background:linear-gradient(90deg,rgba(245,228,223,.24),rgba(247,237,215,.22) 55%,rgba(228,238,220,.34));}.maintenance-app .matrix:before{content:'Impact';position:absolute;top:50%;left:-28px;transform:rotate(-90deg);color:#7C6657;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}.maintenance-app .matrix:after{content:'Urgency →';position:absolute;right:4px;bottom:-21px;color:#7C6657;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}.maintenance-app .matrix-grid{position:relative;width:100%;height:220px;background-image:linear-gradient(to right,rgba(226,214,197,.8) 1px,transparent 1px),linear-gradient(to bottom,rgba(226,214,197,.8) 1px,transparent 1px);background-size:25% 25%;}.maintenance-app .matrix-zone{position:absolute;inset:0;background:linear-gradient(135deg,rgba(245,228,223,.35),transparent 32%,transparent 68%,rgba(228,238,220,.46));pointer-events:none;}.maintenance-app .matrix-label{position:absolute;color:#8B7668;font-size:8px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;}.maintenance-app .matrix-label.low{left:8px;bottom:7px;}.maintenance-app .matrix-label.high{right:8px;top:7px;color:var(--red);}.maintenance-app .matrix-point{position:absolute;display:flex;align-items:center;gap:5px;transform:translate(-50%,-50%);}.maintenance-app .matrix-point i{width:13px;height:13px;display:grid;place-items:center;border-radius:50%;border:2px solid var(--white);box-shadow:0 2px 5px rgba(43,27,18,.18);font-style:normal;font-size:7px;font-weight:700;}.maintenance-app .matrix-point span{white-space:nowrap;color:var(--ink);font-size:8px;font-weight:700;}.maintenance-app .point-red i{background:var(--red);color:var(--white);}.maintenance-app .point-amber i{background:var(--amber);color:var(--white);}.maintenance-app .point-green i{background:var(--green);color:var(--white);}\n  .maintenance-app .checkpoint-row{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:17px;}.maintenance-app .checkpoint{position:relative;padding-top:19px;text-align:center;color:#947D6C;font-size:8px;}.maintenance-app .checkpoint:before{content:'';position:absolute;top:5px;left:0;width:100%;height:2px;background:#DCCEBE;}.maintenance-app .checkpoint:first-child:before{left:50%;width:50%;}.maintenance-app .checkpoint:last-child:before{width:50%;}.maintenance-app .checkpoint-dot{position:absolute;top:0;left:50%;z-index:1;width:11px;height:11px;transform:translateX(-50%);border:2px solid var(--card);border-radius:50%;background:#DCCEBE;}.maintenance-app .checkpoint.done{color:var(--green);font-weight:700;}.maintenance-app .checkpoint.done:before{background:var(--green);}.maintenance-app .checkpoint.done .checkpoint-dot{background:var(--green);}.maintenance-app .checkpoint.current{color:#7C4A2D;font-weight:700;}.maintenance-app .checkpoint.current:before{background:linear-gradient(90deg,var(--green) 50%,#DCCEBE 50%);}.maintenance-app .checkpoint.current .checkpoint-dot{background:var(--gold);box-shadow:0 0 0 3px rgba(212,160,23,.18);}\n  .maintenance-app .queue-panel{margin-top:13px;}.maintenance-app .toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px;padding:10px;border:1px solid #E8DCCF;background:#FFF9F2;}.maintenance-app .toolbar-left,.maintenance-app .toolbar-right{display:flex;align-items:center;gap:7px;}.maintenance-app .search-box{display:flex;align-items:center;gap:7px;width:225px;padding:7px 9px;border:1px solid var(--border);border-radius:7px;background:var(--white);color:#957E6C;font-size:9px;}.maintenance-app .search-box input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font-size:9px;}.maintenance-app .filter-btn,.maintenance-app .sort-select{display:inline-flex;align-items:center;gap:6px;padding:7px 8px;border:1px solid var(--border);border-radius:7px;background:var(--white);color:#5C4233;font-size:9px;font-weight:700;}.maintenance-app .table-wrap{overflow-x:auto;margin-top:10px;}.maintenance-app table{width:100%;border-collapse:collapse;min-width:850px;}.maintenance-app th{padding:8px 9px;border-bottom:1px solid #DCCEBE;color:#8B7668;font-size:8px;font-weight:700;letter-spacing:.09em;text-align:left;text-transform:uppercase;}.maintenance-app td{padding:11px 9px;border-bottom:1px solid #EDE4D7;color:#5C4233;font-size:9px;vertical-align:middle;}.maintenance-app tbody tr:hover{background:#FFF9ED;}.maintenance-app .request-id{color:var(--green);font-weight:700;}.maintenance-app .issue-title{color:var(--ink);font-weight:700;}.maintenance-app .issue-meta{display:block;margin-top:3px;color:#957E6C;font-size:8px;font-weight:500;}.maintenance-app .status,.maintenance-app .priority{display:inline-flex;align-items:center;gap:5px;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:700;white-space:nowrap;}.maintenance-app .status:before,.maintenance-app .priority:before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;}.maintenance-app .status-review{background:var(--amber-soft);color:var(--amber);}.maintenance-app .status-progress{background:var(--blue-soft);color:var(--blue);}.maintenance-app .status-assigned{background:var(--green-soft);color:var(--green);}.maintenance-app .status-emergency{background:var(--red-soft);color:var(--red);}.maintenance-app .priority-critical{background:var(--red-soft);color:var(--red);}.maintenance-app .priority-high{background:var(--amber-soft);color:var(--amber);}.maintenance-app .priority-medium{background:var(--gold-soft);color:#8D6A1B;}.maintenance-app .table-action{color:var(--green);font-size:14px;}.maintenance-app .pagination{display:flex;align-items:center;justify-content:space-between;padding-top:11px;color:#957E6C;font-size:9px;}.maintenance-app .page-btns{display:flex;gap:4px;}.maintenance-app .page-btn{min-width:24px;height:24px;display:grid;place-items:center;border:1px solid var(--border);border-radius:6px;background:var(--white);color:#6E5445;font-size:9px;font-weight:700;}.maintenance-app .page-btn.active{border-color:var(--green);background:var(--green);color:var(--white);}\n  .maintenance-app .triage-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:13px;margin-top:13px;}.maintenance-app .gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px;}.maintenance-app .damage-card{overflow:hidden;border:1px solid var(--border);background:var(--white);}.maintenance-app .damage-card img{display:block;width:100%;height:89px;object-fit:cover;}.maintenance-app .damage-copy{padding:9px 10px;}.maintenance-app .damage-copy strong{display:block;color:var(--ink);font-size:9px;}.maintenance-app .damage-copy span{display:block;margin-top:3px;color:var(--muted);font-size:8px;line-height:1.3;}.maintenance-app .damage-note{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-top:7px;color:var(--green);font-size:8px;font-weight:700;}.maintenance-app .issue-columns{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px;}.maintenance-app .issue-column{padding:11px;border:1px solid #E7DBCE;background:#FFFDF9;}.maintenance-app .issue-column h4{display:flex;justify-content:space-between;align-items:center;margin:0;color:var(--ink);font-size:10px;}.maintenance-app .issue-column h4 i{color:#7C4A2D;font-size:14px;}.maintenance-app .issue-list{display:grid;gap:8px;margin-top:9px;}.maintenance-app .issue-item{display:flex;align-items: