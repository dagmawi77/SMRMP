    },
    "var_9cc4e362292c": {
      "type": "variant",
      "label": "Exhibition Dashboard — Curator Command Center",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --navy: #101b31;\n    --navy-2: #182947;\n    --navy-3: #243a62;\n    --espresso: #2b1b12;\n    --gold: #cda45d;\n    --gold-deep: #a9823f;\n    --gold-soft: #f7edd9;\n    --parchment: #f4efe7;\n    --canvas: #ebe6dc;\n    --paper: #fffdf9;\n    --ink: #2b1b12;\n    --ink-soft: #4d433b;\n    --muted: #796f65;\n    --line: #e2d8ca;\n    --line-strong: #d1c4b4;\n    --green: #54745b;\n    --green-soft: #e7f0e7;\n    --amber: #b57b34;\n    --amber-soft: #fff3dd;\n    --red: #a45b52;\n    --red-soft: #f9e7e4;\n    --blue-soft: #e7eef9;\n    --shadow: 0 10px 30px rgba(54, 37, 20, .07);\n    --shadow-lift: 0 16px 36px rgba(40, 28, 18, .12);\n    --radius-lg: 18px;\n    --radius-md: 14px;\n    --radius-sm: 10px;\n  }\n\n  .exhibition-artifact,\n  .exhibition-artifact * { box-sizing: border-box; }\n\n  .exhibition-artifact {\n    width: 100%;\n    min-height: 100vh;\n    overflow: hidden;\n    color: var(--ink);\n    background: var(--canvas);\n    font-family: 'Inter', Arial, sans-serif;\n    font-size: 13px;\n    line-height: 1.45;\n  }\n\n  .exhibition-artifact button,\n  .exhibition-artifact input,\n  .exhibition-artifact select { font: inherit; }\n\n  .exhibition-artifact button { cursor: pointer; }\n\n  .exhibition-artifact button:focus-visible,\n  .exhibition-artifact a:focus-visible,\n  .exhibition-artifact select:focus-visible,\n  .exhibition-artifact input:focus-visible {\n    outline: 3px solid rgba(205, 164, 93, .55);\n    outline-offset: 2px;\n  }\n\n  .artifact-layout { display: flex; min-height: 100vh; }\n\n  .artifact-sidebar {\n    position: relative;\n    z-index: 50;\n    display: flex;\n    width: 252px;\n    flex: 0 0 252px;\n    flex-direction: column;\n    color: #f8f3eb;\n    background: linear-gradient(180deg, var(--navy) 0%, #10192b 56%, #17170f 100%);\n    border-right: 1px solid rgba(205, 164, 93, .24);\n    transition: width .24s ease, transform .24s ease;\n  }\n\n  .artifact-sidebar.is-collapsed { width: 78px; flex-basis: 78px; }\n\n  .sidebar-brand {\n    display: flex;\n    min-height: 83px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    padding: 18px 16px;\n    border-bottom: 1px solid rgba(226, 216, 202, .13);\n  }\n\n  .brand-lockup { display: flex; min-width: 0; align-items: center; gap: 10px; }\n  .brand-mark {\n    display: grid;\n    width: 40px;\n    height: 40px;\n    flex: 0 0 auto;\n    place-items: center;\n    color: var(--gold);\n    background: rgba(205, 164, 93, .14);\n    border: 1px solid rgba(205, 164, 93, .36);\n    border-radius: 13px;\n  }\n  .brand-mark .ti { font-size: 22px; line-height: 1; }\n  .brand-copy { min-width: 0; }\n  .brand-copy strong { display: block; color: #fffaf0; font-size: 14px; letter-spacing: -.02em; }\n  .brand-copy span { display: block; margin-top: 2px; color: rgba(247, 237, 217, .64); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n\n  .sidebar-collapse,\n  .mobile-close,\n  .mobile-menu {\n    display: grid;\n    width: 32px;\n    height: 32px;\n    place-items: center;\n    color: #eadcc8;\n    background: transparent;\n    border: 1px solid rgba(255,255,255,.12);\n    border-radius: 9px;\n  }\n  .sidebar-collapse:hover,\n  .mobile-close:hover,\n  .mobile-menu:hover { color: #fff; background: rgba(255,255,255,.08); }\n  .sidebar-collapse .ti,\n  .mobile-close .ti,\n  .mobile-menu .ti { font-size: 17px; }\n  .mobile-close { display: none; }\n\n  .sidebar-scroll { flex: 1; overflow: auto; padding: 20px 12px; }\n  .sidebar-label { margin: 0 10px 9px; color: rgba(247,237,217,.42); font-size: 10px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }\n  .sidebar-nav { display: grid; gap: 4px; }\n  .nav-link,\n  .nav-parent {\n    display: flex;\n    min-height: 40px;\n    align-items: center;\n    gap: 11px;\n    width: 100%;\n    padding: 10px 11px;\n    color: rgba(248,243,235,.75);\n    background: transparent;\n    border: 0;\n    border-radius: 11px;\n    text-align: left;\n    text-decoration: none;\n    transition: background .18s ease, color .18s ease;\n  }\n  .nav-link:hover,\n  .nav-parent:hover { color: #fff8ed; background: rgba(255,255,255,.07); }\n  .nav-link .ti,\n  .nav-parent .ti { width: 18px; flex: 0 0 auto; color: var(--gold); font-size: 18px; text-align: center; }\n  .nav-link span,\n  .nav-parent span { overflow: hidden; flex: 1; white-space: nowrap; text-overflow: ellipsis; }\n  .nav-link.is-active,\n  .nav-parent.is-active { color: #fffaf0; background: rgba(205, 164, 93, .16); box-shadow: inset 3px 0 0 var(--gold); }\n  .nav-link.is-active .ti,\n  .nav-parent.is-active .ti { color: #f0c875; }\n  .nav-parent .chevron { width: auto; color: rgba(255,255,255,.55); font-size: 14px; }\n  .nav-submenu { display: grid; gap: 2px; margin: 3px 0 7px 29px; padding-left: 11px; border-left: 1px solid rgba(205,164,93,.28); }\n  .nav-submenu a { padding: 7px 8px; color: rgba(248,243,235,.56); border-radius: 8px; font-size: 11px; text-decoration: none; }\n  .nav-submenu a:hover { color: #fff9ec; background: rgba(255,255,255,.06); }\n  .nav-submenu a.is-current { color: #f4cd81; background: rgba(205,164,93,.12); font-weight: 700; }\n  .is-collapsed .nav-parent span,\n  .is-collapsed .nav-parent .chevron,\n  .is-collapsed .nav-submenu,\n  .is-collapsed .nav-link span,\n  .is-collapsed .sidebar-label,\n  .is-collapsed .brand-copy,\n  .is-collapsed .sidebar-status { display: none; }\n  .is-collapsed .nav-link,\n  .is-collapsed .nav-parent { justify-content: center; padding-inline: 10px; }\n  .is-collapsed .sidebar-brand { justify-content: center; padding-inline: 12px; }\n  .is-collapsed .sidebar-collapse { position: absolute; right: -14px; top: 25px; background: var(--navy-2); }\n\n  .sidebar-status { margin: 16px 6px 3px; padding: 12px; color: #eee3d1; background: rgba(255,255,255,.06); border: 1px solid rgba(205,164,93,.2); border-radius: 12px; }\n  .sidebar-status-top { display: flex; align-items: center; gap: 7px; color: #f0c875; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }\n  .status-dot { width: 7px; height: 7px; border-radius: 999px; background: #91bf77; box-shadow: 0 0 0 4px rgba(145,191,119,.12); }\n  .sidebar-status p { margin: 6px 0 0; color: rgba(238,227,209,.6); font-size: 10px; }\n\n  .artifact-main { min-width: 0; flex: 1; background: var(--canvas); }\n  .topbar {\n    display: flex;\n    min-height: 70px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 12px 30px;\n    background: rgba(255,253,249,.92);\n    border-bottom: 1px solid var(--line);\n    box-shadow: 0 2px 14px rgba(48, 35, 22, .03);\n  }\n  .topbar-left { display: flex; min-width: 0; align-items: center; gap: 11px; }\n  .mobile-menu { display: none; color: var(--ink); border-color: var(--line); }\n  .museum-badge { display: grid; width: 32px; height: 32px; place-items: center; color: var(--navy); background: var(--gold-soft); border: 1px solid rgba(205,164,93,.45); border-radius: 10px; }\n  .museum-badge .ti { font-size: 16px; }\n  .topbar-brand { min-width: 0; }\n  .topbar-brand strong { display: block; font-size: 12px; letter-spacing: -.01em; }\n  .topbar-brand span { display: block; margin-top: 1px; color: var(--muted); font-size: 10px; }\n  .operational-pill { display: inline-flex; align-items: center; gap: 6px; margin-left: 8px; padding: 5px 9px; color: var(--green); background: var(--green-soft); border: 1px solid #cfe0d1; border-radius: 999px; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }\n  .topbar-actions { display: flex; align-items: center; gap: 9px; }\n  .search-trigger { display: flex; min-width: 210px; align-items: center; gap: 8px; padding: 9px 11px; color: var(--muted); background: #fbf9f5; border: 1px solid var(--line); border-radius: 10px; text-align: left; }\n  .search-trigger:hover { border-color: rgba(205,164,93,.8); background: #fffdf9; }\n  .search-trigger .ti { color: var(--gold-deep); font-size: 15px; }\n  .search-trigger kbd { margin-left: auto; padding: 2px 5px; color: var(--muted); background: #eee8df; border: 1px solid var(--line); border-radius: 4px; font-size: 9px; }\n  .language-select { height: 34px; padding: 0 8px; color: var(--ink-soft); background: #fffdf9; border: 1px solid var(--line); border-radius: 9px; font-size: 11px; font-weight: 700; }\n  .user-profile { display: flex; align-items: center; gap: 8px; padding-left: 9px; border-left: 1px solid var(--line); }\n  .avatar { display: grid; width: 31px; height: 31px; place-items: center; color: #fff7e8; background: var(--navy); border: 2px solid var(--gold-soft); border-radius: 50%; font-size: 11px; font-weight: 800; }\n  .user-copy { text-align: right; }\n  .user-copy strong { display: block; font-size: 11px; }\n  .user-copy span { display: block; color: var(--gold-deep); font-size: 9px; font-weight: 800; text-transform: capitalize; }\n\n  .artifact-content { max-width: 1440px; margin: 0 auto; padding: 24px 30px 30px; }\n  .breadcrumb { display: flex; align-items: center; gap: 7px; margin-bottom: 13px; color: var(--muted); font-size: 11px; }\n  .breadcrumb a { color: var(--muted); text-decoration: none; }\n  .breadcrumb a:hover { color: var(--gold-deep); }\n  .breadcrumb .ti { color: var(--line-strong); font-size: 13px; }\n  .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 21px; }\n  .eyebrow { margin: 0 0 5px; color: var(--gold-deep); font-size: 10px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }\n  .page-head h1 { margin: 0; color: var(--espresso); font-family: 'Playfair Display', Georgia, serif; font-size: clamp(26px, 3vw, 34px); line-height: 1.05; letter-spacing: -.035em; }\n  .page-head p { max-width: 590px; margin: 7px 0 0; color: var(--muted); font-size: 12px; }\n  .page-actions { display: flex; align-items: center; gap: 8px; }\n  .btn { display: inline-flex; min-height: 37px; align-items: center; justify-content: center; gap: 7px; padding: 9px 13px; border: 1px solid transparent; border-radius: 10px; font-size: 11px; font-weight: 800; white-space: nowrap; }\n  .btn .ti { font-size: 15px; }\n  .btn-primary { color: #241b0f; background: var(--gold); border-color: var(--gold-deep); box-shadow: 0 5px 12px rgba(168,130,63,.18); }\n  .btn-primary:hover { background: #e2bb72; }\n  .btn-secondary { color: var(--ink-soft); background: var(--paper); border-color: var(--line); }\n  .btn-secondary:hover { color: var(--ink); background: var(--gold-soft); border-color: #d8bd8d; }\n  .btn-quiet { color: var(--gold-deep); background: transparent; border-color: rgba(205,164,93,.45); }\n  .btn-quiet:hover { background: var(--gold-soft); }\n\n  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 11px; margin-bottom: 15px; }\n  .stat-card { min-width: 0; padding: 14px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow); }\n  .stat-card:hover { border-color: rgba(205,164,93,.65); box-shadow: var(--shadow-lift); }\n  .stat-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n  .stat-label { overflow: hidden; color: var(--muted); font-size: 10px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }\n  .metric-icon { display: grid; width: 28px; height: 28px; flex: 0 0 auto; place-items: center; color: var(--gold-deep); background: var(--gold-soft); border-radius: 9px; }\n  .metric-icon .ti { font-size: 15px; }\n  .stat-value { display: block; margin-top: 8px; color: var(--espresso); font-size: 23px; font-weight: 800; letter-spacing: -.055em; }\n  .stat-foot { display: flex; align-items: center; gap: 5px; margin-top: 4px; color: var(--muted); font-size: 9px; }\n  .stat-foot .positive { color: var(--green); font-weight: 800; }\n  .stat-foot .ti { font-size: 12px; }\n  .featured-stat { grid-column: span 2; display: flex; align-items: center; gap: 10px; padding: 11px; background: var(--navy); border-color: var(--navy); color: #fff; }\n  .featured-stat .stat-label { color: rgba(255,255,255,.67); }\n  .featured-stat .stat-value { margin-top: 3px; color: #fff5df; font-family: 'Playfair Display', Georgia, serif; font-size: 15px; letter-spacing: -.01em; line-height: 1.1; }\n  .featured-stat .stat-foot { color: rgba(255,255,255,.6); }\n  .featured-stat .metric-icon { width: 38px; height: 38px; color: #f3cd7b; background: rgba(205,164,93,.17); border: 1px solid rgba(205,164,93,.3); }\n  .featured-stat .metric-icon .ti { font-size: 19px; }\n  .featured-stat .featured-thumb { width: 54px; height: 54px; flex: 0 0 auto; overflow: hidden; border: 1px solid rgba(255,255,255,.23); border-radius: 10px; }\n  .featured-stat .featured-thumb img { width: 100%; height: 100%; object-fit: cover; }\n\n  .panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow); }\n  .panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 17px 12px; }\n  .panel-title { margin: 0; color: var(--espresso); font-family: 'Playfair Display', Georgia, serif; font-size: 17px; letter-spacing: -.02em; }\n  .panel-subtitle { margin: 3px 0 0; color: var(--muted); font-size: 10px; }\n  .panel-link { display: inline-flex; align-items: center; gap: 4px; color: var(--gold-deep); font-size: 10px; font-weight: 800; text-decoration: none; }\n  .panel-link:hover { color: var(--espresso); }\n  .panel-link .ti { font-size: 13px; }\n\n  .featured-panel { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); min-height: 236px; overflow: hidden; margin-bottom: 15px; }\n  .featured-image { position: relative; min-height: 236px; overflow: hidden; background: var(--navy); }\n  .featured-image::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, transparent 45%, rgba(16,27,49,.74)); pointer-events: none; }\n  .featured-image img { width: 100%; height: 100%; display: block; object-fit: cover; }\n  .image-label { position: absolute; z-index: 1; left: 15px; bottom: 14px; display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; color: #fff8eb; background: rgba(16,27,49,.74); border: 1px solid rgba(255,255,255,.16); border-radius: 999px; font-size: 9px; font-weight: 800; }\n  .image-label .ti { color: #f1c876; font-size: 12px; }\n  .featured-copy { padding: 21px 23px; }\n  .featured-copy .eyebrow { margin-bottom: 8px; }\n  .featured-copy h2 { max-width: 490px; margin: 0; color: var(--espresso); font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 2.6vw, 31px); line-height: 1.06; letter-spacing: -.04em; }\n  .featured-copy .description { max-width: 470px; margin: 10px 0 14px; color: var(--muted); font-size: 11px; line-height: 1.55; }\n  .meta-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }\n  .meta-chip { display: inline-flex; align-items: center; gap: 5px; padding: 6px 8px; color: var(--ink-soft); background: #f8f4ee; border: 1px solid var(--line); border-radius: 7px; font-size: 10px; font-weight: 700; }\n  .meta-chip .ti { color: var(--gold-deep); font-size: 13px; }\n  .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; color: var(--green); background: var(--green-soft); border: 1px solid #cfe0d1; border-radius: 999px; font-size: 9px; font-weight: 800; }\n  .status-badge::before { width: 6px; height: 6px; content: ''; border-radius: 999px; background: currentColor; }\n  .featured-kpis { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 3px; }\n  .featured-kpi strong { display: block; color: var(--espresso); font-size: 17px; letter-spacing: -.04em; }\n  .featured-kpi span { display: block; margin-top: 1px; color: var(--muted); font-size: 9px; }\n  .featured-kpi + .featured-kpi { padding-left: 20px; border-left: 1px solid var(--line); }\n\n  .charts-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(205px, .7fr); gap: 15px; margin-bottom: 15px; }\n  .chart-panel { min-width: 0; min-height: 275px; }\n  .chart-body { padding: 0 17px 16px; }\n  .chart-canvas-wrap { position: relative; height: 186px; }\n  .chart-controls { display: flex; align-items: center; gap: 4px; padding: 3px; background: #f4efe7; border: 1px solid var(--line); border-radius: 8px; }\n  .range-btn { padding: 5px 7px; color: var(--muted); background: transparent; border: 0; border-radius: 6px; font-size: 9px; font-weight: 800; }\n  .range-btn:hover { color: var(--ink); }\n  .range-btn.is-selected { color: var(--espresso); background: #fffdf9; box-shadow: 0 1px 3px rgba(50,35,20,.08); }\n  .legend-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 3px; color: var(--muted); font-size: 9px; }\n  .legend-item { display: inline-flex; align-items: center; gap: 5px; }\n  .legend-dot { width: 7px; height: 7px; border-radius: 2px; }\n  .donut-body { display: flex; height: 210px; align-items: center; gap: 13px; padding: 0 17px 15px; }\n  .donut-canvas-wrap { position: relative; width: 145px; height: 165px; flex: 0 0 145px; }\n  .donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }\n  .donut-center strong { color: var(--espresso); font-size: 21px; letter-spacing: -.06em; }\n  .donut-center span { color: var(--muted); font-size: 9px; }\n  .donut-legend { display: grid; gap: 10px; min-width: 0; }\n  .donut-legend-item { display: grid; grid-template-columns: 7px 1fr auto; align-items: center; gap: 6px; color: var(--muted); font-size: 10px; }\n  .donut-legend-item strong { color: var(--ink-soft); font-size: 10px; }\n  .donut-legend-item b { color: var(--espresso); font-size: 11px; }\n\n  .lower-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(230px, .8fr) minmax(220px, .72fr); gap: 15px; }\n  .activity-list { display: grid; gap: 0; padding: 0 17px 9px; }\n  .activity-item { display: grid; grid-template-columns: 29px 1fr auto; gap: 9px; align-items: start; padding: 11px 0; border-bottom: 1px solid #eee8df; }\n  .activity-item:last-child { border-bottom: 0; }\n  .activity-avatar { display: grid; width: 29px; height: 29px; place-items: center; color: var(--gold-deep); background: var(--gold-soft); border: 1px solid #edd8b2; border-radius: 9px; font-size: 13px; }\n  .activity-copy strong { display: block; color: var(--ink-soft); font-size: 10px; font-weight: 800; }\n  .activity-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; line-height: 1.35; }\n  .activity-time { color: #9a9085; font-size: 9px; white-space: nowrap; }\n\n  .schedule-list { display: grid; gap: 8px; padding: 0 17px 15px; }\n  .schedule-item { display: grid; grid-template-columns: 41px 1fr; gap: 9px; align-items: center; padding: 8px; background: #fbf8f3; border: 1px solid #eee7dd; border-radius: 10px; }\n  .schedule-date { padding: 5px 3px; color: var(--gold-deep); background: var(--gold-soft); border-radius: 7px; text-align: center; }\n  .schedule-date strong { display: block; font-size: 14px; line-height: 1; }\n  .schedule-date span { display: block; margin-top: 3px; font-size: 8px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }\n  .schedule-copy strong { display: block; overflow: hidden; color: var(--ink-soft); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }\n  .schedule-copy span { display: block; margin-top: 2px; color: var(--muted); font-size: 9px; }\n\n  .quick-actions { display: grid; gap: 8px; padding: 0 17px 15px; }\n  .quick-action { display: flex; min-height: 42px; align-items: center; gap: 9px; padding: 8px 9px; color: var(--ink-soft); background: #fbf8f3; border: 1px solid #eee7dd; border-radius: 10px; text-align: left; }\n  .quick-action:hover { color: var(--espresso); background: var(--gold-soft); border-color: #e0c18d; }\n  .quick-action .quick-icon { display: grid; width: 26px; height: 26px; flex: 0 0 auto; place-items: center; color: var(--gold-deep); background: #fffdf9; border: 1px solid #e8d5b4; border-radius: 8px; }\n  .quick-action .ti { font-size: 14px; }\n  .quick-action strong { display: block; font-size: 10px; }\n  .quick-action span { display: block; margin-top: 1px; color: var(--muted); font-size: 9px; }\n  .quick-action > .ti { margin-left: auto; color: #a89b8e; font-size: 13px; }\n\n  .module-note { display: flex; align-items: center; gap: 7px; margin-top: 16px; padding: 8px 11px; color: var(--muted); background: rgba(255,253,249,.55); border: 1px solid rgba(226,216,202,.8); border-radius: 9px; font-size: 10px; }\n  .module-note .ti { color: var(--gold-deep); font-size: 14px; }\n  .artifact-attribution { padding: 12px 0 2px; color: #998e82; font-size: 9px; text-align: right; }\n\n  .drawer-backdrop { display: none; }\n\n  @media (max-width: 1120px) {\n    .artifact-content { padding-inline: 22px; }\n    .topbar { padding-inline: 22px; }\n    .charts-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }\n    .chart-panel:last-child { grid-column: span 2; }\n    .donut-body { justify-content: center; }\n    .lower-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }\n    .quick-panel { grid-column: span 2; }\n    .quick-actions { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n\n  @media (max-width: 860px) {\n    .artifact-sidebar { position: fixed; inset: 0 auto 0 0; width: 252px; transform: translateX(-105%); box-shadow: 20px 0 42px rgba(16,27,49,.22); }\n    .artifact-sidebar.is-mobile-open { transform: translateX(0); }\n    .artifact-sidebar.is-collapsed { width: 252px; }\n    .artifact-sidebar.is-collapsed .nav-parent span,\n    .artifact-sidebar.is-collapsed .nav-parent .chevron,\n    .artifact-sidebar.is-collapsed .nav-submenu,\n    .artifact-sidebar.is-collapsed .nav-link span,\n    .artifact-sidebar.is-collapsed .sidebar-label,\n    .artifact-sidebar.is-collapsed .brand-copy,\n    .artifact-sidebar.is-collapsed .sidebar-status { display: block; }\n    .artifact-sidebar.is-collapsed .nav-link,\n    .artifact-sidebar.is-collapsed .nav-parent { justify-content: flex-start; padding: 10px 11px; }\n    .artifact-sidebar.is-collapsed .sidebar-brand { justify-content: space-between; padding-inline: 16px; }\n    .artifact-sidebar.is-collapsed .sidebar-collapse { position: static; }\n    .sidebar-collapse { display: none; }\n    .mobile-close { display: grid; }\n    .drawer-backdrop.is-visible { display: block; position: fixed; inset: 0; z-index: 40; background: rgba(16,27,49,.47); backdrop-filter: blur(2px); }\n    .mobile-menu { display: grid; }\n    .topbar { padding-inline: 16px; }\n    .search-trigger { min-width: 0; width: 38px; justify-content: center; padding: 8px; }\n    .search-trigger span,\n    .search-trigger kbd { display: none; }\n    .user-copy { display: none; }\n    .artifact-content { padding: 20px 16px 26px; }\n    .stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n    .featured-panel { grid-template-columns: 1fr; }\n    .featured-image { min-height: 205px; }\n  }\n\n  @media (max-width: 640px) {\n    .topbar-brand span,\n    .operational-pill,\n    .language-select { display: none; }\n    .topbar-actions { gap: 6px; }\n    .page-head { align-items: flex-start; flex-direction: column; }\n    .page-actions { width: 100%; }\n    .page-actions .btn { flex: 1; }\n    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .featured-stat { grid-column: span 2; }\n    .charts-grid,\n    .lower-grid { grid-template-columns: 1fr; }\n    .chart-panel:last-child,\n    .quick-panel { grid-column: auto; }\n    .quick-actions { grid-template-columns: 1fr; }\n    .featured-copy { padding: 18px; }\n    .featured-copy h2 { font-size: 25px; }\n    .donut-body { justify-content: flex-start; }\n    .artifact-attribution { text-align: left; line-height: 1.5; }\n  }\n</style>\n<div class=\"exhibition-artifact\" data-kid=\"1\" data-module=\"exhibition-management\" data-name=\"exhibition management module\">\n    <div class=\"artifact-layout\" data-kid=\"1-1\" data-name=\"page layout container\">\n        <div aria-hidden=\"true\" class=\"drawer-backdrop\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"drawer backdrop overlay\" data-reason=\"visibility toggled by script\" id=\"drawerBackdrop\">\n        </div>\n        <aside aria-label=\"Primary navigation\" class=\"artifact-sidebar\" data-kid=\"1-1-2\" data-name=\"primary navigation sidebar\" id=\"artifactSidebar\">\n            <div class=\"sidebar-brand\" data-kid=\"1-1-2-1\" data-name=\"sidebar brand header\">\n                <a aria-label=\"SMRMP dashboard\" class=\"brand-lockup\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard home link\" href=\"#dashboard\">\n                    <span class=\"brand-mark\" data-kid=\"1-1-2-1-1-1\" data-name=\"brand icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-building-museum\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"museum building icon\">\n                        </i>\n                    </span>\n                    <span class=\"brand-copy\" data-kid=\"1-1-2-1-1-2\" data-name=\"brand text container\">\n                        <strong data-kid=\"1-1-2-1-1-2-1\" data-name=\"brand title text\">\n                            SMRMP\n                        </strong>\n                        <span data-kid=\"1-1-2-1-1-2-2\" data-name=\"brand subtitle text\">\n                            Curator portal\n                        </span>\n                    </span>\n                </a>\n        