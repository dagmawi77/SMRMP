                          Abel Tesfaye\n                                </strong>\n                                updated the Memorial Hall schedule.\n                            </div>\n                            <div class=\"exh-activity-time\" data-dynamic=\"true\" data-kid=\"1-3-2-5-2-2-4-3\" data-name=\"activity timestamp\" data-reason=\"text updated by system state\">\n                                Yesterday\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n            <section aria-label=\"Quick actions\" class=\"exh-quick\" data-kid=\"1-3-2-6\">\n                <div data-kid=\"1-3-2-6-1\">\n                    <div class=\"exh-quick-title\" data-kid=\"1-3-2-6-1-1\">\n                        Keep the programme moving\n                    </div>\n                    <div class=\"exh-quick-copy\" data-kid=\"1-3-2-6-1-2\">\n                        Common curator actions for today’s exhibition workload.\n                    </div>\n                </div>\n                <div class=\"exh-quick-actions\" data-kid=\"1-3-2-6-2\">\n                    <button class=\"exh-quick-btn exh-quick-btn-primary\" data-kid=\"1-3-2-6-2-1\" data-modal=\"Create exhibition\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus exh-icon-sm\" data-kid=\"1-3-2-6-2-1-1\">\n                        </i>\n                        Create exhibition\n                    </button>\n                    <button class=\"exh-quick-btn\" data-kid=\"1-3-2-6-2-2\" data-modal=\"Assign artifacts\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-arrows-transfer-up exh-icon-sm\" data-kid=\"1-3-2-6-2-2-1\">\n                        </i>\n                        Assign artifacts\n                    </button>\n                    <button class=\"exh-quick-btn\" data-kid=\"1-3-2-6-2-3\" data-modal=\"Upload gallery images\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-photo-plus exh-icon-sm\" data-kid=\"1-3-2-6-2-3-1\">\n                        </i>\n                        Upload gallery images\n                    </button>\n                </div>\n            </section>\n            <footer class=\"exh-footer\" data-kid=\"1-3-2-7\">\n                <span data-kid=\"1-3-2-7-1\">\n                    SMRMP · Exhibition Atlas · Adwa Victory Memorial Museum\n                </span>\n                <span data-kid=\"1-3-2-7-2\">\n                    Images: Berna on Pexels · Rahime Gül on Pexels · Ayşenaz Bilgin on Pexels\n                </span>\n            </footer>\n        </main>\n    </section>\n    <nav aria-label=\"Mobile quick actions\" class=\"exh-mobile-actions\" data-kid=\"1-4\">\n        <button class=\"exh-mobile-action is-primary\" data-kid=\"1-4-1\" data-modal=\"Create exhibition\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-plus exh-icon\" data-kid=\"1-4-1-1\">\n            </i>\n            <span data-kid=\"1-4-1-2\">\n                Create\n            </span>\n        </button>\n        <button class=\"exh-mobile-action\" data-kid=\"1-4-2\" data-modal=\"Assign artifacts\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-arrows-transfer-up exh-icon\" data-kid=\"1-4-2-1\">\n            </i>\n            <span data-kid=\"1-4-2-2\">\n                Assign\n            </span>\n        </button>\n        <button class=\"exh-mobile-action\" data-kid=\"1-4-3\" data-modal=\"Upload gallery images\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-photo-plus exh-icon\" data-kid=\"1-4-3-1\">\n            </i>\n            <span data-kid=\"1-4-3-2\">\n                Gallery\n            </span>\n        </button>\n        <button class=\"exh-mobile-action\" data-kid=\"1-4-4\" data-modal=\"Open calendar\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-calendar-event exh-icon\" data-kid=\"1-4-4-1\">\n            </i>\n            <span data-kid=\"1-4-4-2\">\n                Calendar\n            </span>\n        </button>\n    </nav>\n    <div aria-labelledby=\"exh-modal-title\" aria-modal=\"true\" class=\"exh-modal\" data-kid=\"1-5\" id=\"exh-modal\" role=\"dialog\">\n        <div class=\"exh-modal-card\" data-kid=\"1-5-1\">\n            <div class=\"exh-modal-top\" data-kid=\"1-5-1-1\">\n                <div data-kid=\"1-5-1-1-1\">\n                    <h2 class=\"exh-modal-title\" data-kid=\"1-5-1-1-1-1\" id=\"exh-modal-title\">\n                        Attention state\n                    </h2>\n                    <p class=\"exh-modal-copy\" data-kid=\"1-5-1-1-1-2\" id=\"exh-modal-copy\">\n                        Review the selected operation before continuing.\n                    </p>\n                </div>\n                <button aria-label=\"Close dialog\" class=\"exh-icon-btn\" data-kid=\"1-5-1-1-2\" id=\"exh-modal-close\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-x exh-icon-sm\" data-kid=\"1-5-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"exh-modal-body\" data-kid=\"1-5-1-2\">\n                <div class=\"exh-modal-alert\" data-kid=\"1-5-1-2-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle exh-icon\" data-kid=\"1-5-1-2-1-1\">\n                    </i>\n                    <span data-kid=\"1-5-1-2-1-2\" id=\"exh-modal-alert\">\n                        This is a preview interaction. In production, the next step would open the corresponding workflow.\n                    </span>\n                </div>\n                <div class=\"exh-modal-actions\" data-kid=\"1-5-1-2-2\">\n                    <button class=\"exh-modal-cancel\" data-kid=\"1-5-1-2-2-1\" id=\"exh-modal-cancel\" type=\"button\">\n                        Cancel\n                    </button>\n                    <button class=\"exh-modal-primary\" data-kid=\"1-5-1-2-2-2\" id=\"exh-modal-primary\" type=\"button\">\n                        Continue\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    (function(){\n  const app=document.getElementById('exh-app');\n  const collapse=document.getElementById('exh-collapse');\n  const mobileOpen=document.getElementById('exh-mobile-open');\n  const overlay=document.getElementById('exh-overlay');\n  const subnavToggle=document.getElementById('exh-subnav-toggle');\n  const subnav=document.getElementById('exh-subnav');\n  const parent=document.getElementById('exh-nav-parent');\n  collapse&&collapse.addEventListener('click',function(){const collapsed=app.classList.toggle('is-collapsed');collapse.setAttribute('aria-pressed',String(collapsed));collapse.setAttribute('aria-label',collapsed?'Expand sidebar':'Collapse sidebar');collapse.innerHTML='<i class=\"ti '+(collapsed?'ti-chevron-right':'ti-chevron-left')+' exh-icon\" aria-hidden=\"true\"></i>';});\n  function closeDrawer(){app.classList.remove('is-drawer-open');mobileOpen&&mobileOpen.setAttribute('aria-expanded','false');}\n  mobileOpen&&mobileOpen.addEventListener('click',function(){app.classList.add('is-drawer-open');mobileOpen.setAttribute('aria-expanded','true');}); overlay&&overlay.addEventListener('click',closeDrawer);\n  document.querySelectorAll('.exh-sidebar a').forEach(function(link){link.addEventListener('click',closeDrawer)});\n  subnavToggle&&subnavToggle.addEventListener('click',function(){const expanded=subnavToggle.getAttribute('aria-expanded')==='true';subnavToggle.setAttribute('aria-expanded',String(!expanded));subnavToggle.setAttribute('aria-label',expanded?'Expand exhibitions submenu':'Collapse exhibitions submenu');parent.classList.toggle('is-closed',expanded);subnav.style.display=expanded?'none':'';});\n  document.querySelectorAll('.exh-period button').forEach(function(btn){btn.addEventListener('click',function(){document.querySelectorAll('.exh-period button').forEach(function(item){item.classList.remove('is-selected')});btn.classList.add('is-selected')})});\n  const tablePanel=document.getElementById('exh-table-panel'); const listBtn=document.getElementById('exh-list-view'); const gridBtn=document.getElementById('exh-grid-view');\n  listBtn&&listBtn.addEventListener('click',function(){tablePanel.classList.remove('exh-grid-view');listBtn.classList.add('is-active');gridBtn.classList.remove('is-active');listBtn.setAttribute('aria-pressed','true');gridBtn.setAttribute('aria-pressed','false')});\n  gridBtn&&gridBtn.addEventListener('click',function(){tablePanel.classList.add('exh-grid-view');gridBtn.classList.add('is-active');listBtn.classList.remove('is-active');gridBtn.setAttribute('aria-pressed','true');listBtn.setAttribute('aria-pressed','false')});\n  function applyFilter(filter){document.querySelectorAll('#exh-table-body tr,#exh-grid-cards article').forEach(function(row){row.style.display=filter==='all'||row.dataset.status===filter?'':'none'});document.querySelectorAll('.exh-chip').forEach(function(chip){chip.classList.toggle('is-selected',chip.dataset.filter===filter)})}\n  document.querySelectorAll('.exh-chip').forEach(function(chip){chip.addEventListener('click',function(){applyFilter(chip.dataset.filter)})});\n  const months=['May 2026','June 2026','July 2026','August 2026']; let monthIndex=0; const monthLabel=document.getElementById('exh-calendar-month');\n  document.getElementById('exh-prev-month')?.addEventListener('click',function(){monthIndex=(monthIndex+months.length-1)%months.length;monthLabel.textContent=months[monthIndex]}); document.getElementById('exh-next-month')?.addEventListener('click',function(){monthIndex=(monthIndex+1)%months.length;monthLabel.textContent=months[monthIndex]});\n  const modal=document.getElementById('exh-modal'), modalTitle=document.getElementById('exh-modal-title'), modalCopy=document.getElementById('exh-modal-copy'), modalAlert=document.getElementById('exh-modal-alert');\n  function openModal(title,detail){modalTitle.textContent=title;modalCopy.textContent='Review the selected operation before continuing.';modalAlert.textContent=detail||'This is a preview interaction. In production, the next step would open the corresponding workflow.';modal.classList.add('is-open');document.getElementById('exh-modal-close').focus()}\n  function closeModal(){modal.classList.remove('is-open')}\n  document.querySelectorAll('[data-modal]').forEach(function(btn){btn.addEventListener('click',function(){openModal(btn.dataset.modal,'This action is ready to connect to the '+btn.dataset.modal.toLowerCase()+' workflow.')})}); document.querySelectorAll('.exh-conflict-row').forEach(function(row){row.addEventListener('click',function(){openModal('Schedule conflict',row.dataset.conflict+' needs curator review before publication.')})}); document.getElementById('exh-resolve')?.addEventListener('click',function(){openModal('Resolve conflicts','Three schedule exceptions are waiting for a room, capacity, or conservation decision.')}); document.getElementById('exh-qr')?.addEventListener('click',function(){openModal('QR scanner','Point a museum device at an exhibition code to preview its public record.')}); document.getElementById('exh-modal-close')?.addEventListener('click',closeModal); document.getElementById('exh-modal-cancel')?.addEventListener('click',closeModal); document.getElementById('exh-modal-primary')?.addEventListener('click',function(){closeModal()}); modal?.addEventListener('click',function(e){if(e.target===modal)closeModal()}); document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});\n  if(window.Chart){new Chart(document.getElementById('exh-visitors-chart'),{type:'line',data:{labels:['Jan','Feb','Mar','Apr','May','Jun','Jul'],datasets:[{data:[2100,2650,2380,3180,3760,4210,4890],borderColor:'#e3bf5d',backgroundColor:'rgba(227,191,93,.16)',fill:true,tension:.42,pointRadius:3,pointHoverRadius:5,pointBackgroundColor:'#fffaf0',pointBorderColor:'#e3bf5d',pointBorderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{displayColors:false,backgroundColor:'#0d1d2c',titleColor:'#fffaf0',bodyColor:'#f7df9a',padding:9,callbacks:{label:function(ctx){return ' '+ctx.parsed.y.toLocaleString()+' visitors'}}}},scales:{x:{grid:{display:false},ticks:{color:'rgba(246,239,228,.5)',font:{size:9,family:'Inter'}}},y:{beginAtZero:false,grid:{color:'rgba(255,255,255,.08)'},ticks:{color:'rgba(246,239,228,.5)',font:{size:9,family:'Inter'},callback:function(v){return (v/1000)+'k'}}}}}})}\n})();\n</script>\n",
      "comments": [],
      "created": "2026-07-25T15:13:28.820877+00:00",
      "modified": "2026-07-25T15:14:53.690532+00:00",
