            <section class=\"feature-layout\" data-kid=\"1-1-3-2-3\">\n                    <article aria-labelledby=\"featured-title\" class=\"feature-card\" data-kid=\"1-1-3-2-3-1\">\n                        <img alt=\"Museum display with a golden artifact, Lokman Sevim on Pexels\" class=\"feature-image\" data-kid=\"1-1-3-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14950665/pexels-photo-14950665.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                        <div class=\"feature-scrim\" data-kid=\"1-1-3-2-3-1-2\">\n                        </div>\n                        <div class=\"feature-content\" data-kid=\"1-1-3-2-3-1-3\">\n                            <div data-kid=\"1-1-3-2-3-1-3-1\">\n                                <div class=\"feature-overline\" data-kid=\"1-1-3-2-3-1-3-1-1\">\n                                    Featured exhibition · ዋና ማሳያ\n                                </div>\n                                <h2 data-kid=\"1-1-3-2-3-1-3-1-2\" id=\"featured-title\">\n                                    The Lion of Adwa: Memory & Making\n                                </h2>\n                                <div class=\"feature-subtitle\" data-kid=\"1-1-3-2-3-1-3-1-3\">\n                                    A material history of courage, craft, and the people who carried a victory into memory.\n                                </div>\n                                <div class=\"feature-details\" data-kid=\"1-1-3-2-3-1-3-1-4\">\n                                    <span data-kid=\"1-1-3-2-3-1-3-1-4-1\">\n                                        <i class=\"ti ti-user\" data-kid=\"1-1-3-2-3-1-3-1-4-1-1\" style=\"font-size:13px;width:13px;height:13px;color:#E6C96D;line-height:1;\">\n                                        </i>\n                                        Curated by Hana Bekele\n                                    </span>\n                                    <span data-kid=\"1-1-3-2-3-1-3-1-4-2\">\n