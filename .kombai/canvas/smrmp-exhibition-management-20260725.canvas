>\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-74\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-75\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-76\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-77\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-78\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-79\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-80\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-81\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-82\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-83\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-84\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-85\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-86\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-87\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-88\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-89\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-90\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-91\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-92\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-93\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-94\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-95\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-96\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-97\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-98\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-99\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-100\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-101\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-102\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-103\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-104\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-105\">\n                            </span>\n                            <span data-kid=\"1-1-3-2-10-1-1-106\">\n                            </span>\n                        </div>\n                        <div class=\"qr-copy\" data-kid=\"1-1-3-2-10-1-1-107\">\n                            <h3 data-kid=\"1-1-3-2-10-1-1-107-1\">\n                                Public story QR\n                            </h3>\n                            <p data-kid=\"1-1-3-2-10-1-1-107-2\">\n                                Share the public exhibition detail page with a single scan.\n                            </p>\n                            <button aria-label=\"Copy exhibition QR link\" class=\"copy-btn\" data-kid=\"1-1-3-2-10-1-1-107-3\" id=\"copy-qr\" type=\"button\">\n                                <i class=\"ti ti-copy\" data-kid=\"1-1-3-2-10-1-1-107-3-1\" style=\"font-size:12px;width:12px;height:12px;color:#FFFDF9;line-height:1;\">\n                                </i>\n                                Copy public link\n                            </button>\n                        </div>\n                    </article>\n                </div>\n                <article class=\"panel panel-pad\" data-kid=\"1-1-3-2-10-2\">\n                    <div class=\"panel-title\" data-kid=\"1-1-3-2-10-2-1\">\n                        <div data-kid=\"1-1-3-2-10-2-1-1\">\n                            <h3 data-kid=\"1-1-3-2-10-2-1-1-1\">\n                                Related exhibitions\n                            </h3>\n                            <p data-kid=\"1-1-3-2-10-2-1-1-2\">\n                                Stories visitors may follow next\n                            </p>\n                        </div>\n                        <i class=\"ti ti-link\" data-kid=\"1-1-3-2-10-2-1-2\" style=\"font-size:15px;width:15px;height:15px;color:#7C4A2D;line-height:1;\">\n                        </i>\n                    </div>\n                    <ul class=\"related-list\" data-kid=\"1-1-3-2-10-2-2\">\n                        <li data-kid=\"1-1-3-2-10-2-2-1\">\n                            <img alt=\"Artifact display, Justinas on Pexels\" data-kid=\"1-1-3-2-10-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/27849813/pexels-photo-27849813.png?auto=compress&cs=tinysrgb&w=600&q=80\"/>\n                            <span class=\"list-copy\" data-kid=\"1-1-3-2-10-2-2-1-2\">\n                                <strong data-kid=\"1-1-3-2-10-2-2-1-2-1\">\n                                    Threads of Belonging\n                                </strong>\n                                <span data-kid=\"1-1-3-2-10-2-2-1-2-2\">\n                                    Temporary · Hall 01\n                                </span>\n                            </span>\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-1-3-2-10-2-2-1-3\" style=\"font-size:13px;width:13px;height:13px;color:#7C4A2D;line-height:1;margin-left:auto;\">\n                            </i>\n                        </li>\n                        <li data-kid=\"1-1-3-2-10-2-2-2\">\n                            <img alt=\"Museum gallery interior, Necip Duman on Pexels\" data-kid=\"1-1-3-2-10-2-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/31326473/pexels-photo-31326473.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\"/>\n                            <span class=\"list-copy\" data-kid=\"1-1-3-2-10-2-2-2-2\">\n                                <strong data-kid=\"1-1-3-2-10-2-2-2-2-1\">\n                                    Echoes in Bronze\n                                </strong>\n                                <span data-kid=\"1-1-3-2-10-2-2-2-2-2\">\n                                    Permanent · Hall 03\n                                </span>\n                            </span>\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-1-3-2-10-2-2-2-3\" style=\"font-size:13px;width:13px;height:13px;color:#7C4A2D;line-height:1;margin-left:auto;\">\n                            </i>\n                        </li>\n                    </ul>\n                </article>\n            </main>\n        </section>\n    </div>\n    <footer class=\"footer\" data-kid=\"1-1-3-2-11\" data-name=\"footer section\">\n        SMRMP Exhibition Management · Data shown for design preview · Photo credits:\n        <a data-kid=\"1-1-3-2-11-1\" href=\"https://www.pexels.com/\" rel=\"noreferrer\" target=\"_blank\">\n            Lokman Sevim\n        </a>\n        ,\n        <a data-kid=\"1-1-3-2-11-2\" href=\"https://www.pexels.com/\" rel=\"noreferrer\" target=\"_blank\">\n            Justinas\n        </a>\n        , and\n        <a data-kid=\"1-1-3-2-11-3\" href=\"https://www.pexels.com/\" rel=\"noreferrer\" target=\"_blank\">\n            Necip Duman\n        </a>\n        on Pexels.\n    </footer>\n</div>\n<div aria-live=\"polite\" class=\"toast\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"success toast notification\" data-reason=\"class toggled by script to show\" id=\"toast\" role=\"status\">\n    <i class=\"ti ti-check\" data-kid=\"1-2-1\" style=\"font-size:14px;width:14px;height:14px;color:#D9E7B7;line-height:1;\">\n    </i>\n    <span data-kid=\"1-2-2\" data-name=\"toast message text\">\n        Public link copied\n    </span>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    const app = document.getElementById('exhibition-app');\n  const sidebar = document.getElementById('sidebar');\n  const collapse = document.getElementById('collapse-sidebar');\n  const mobileMenu = document.getElementById('mobile-menu');\n  const backdrop = document.getElementById('drawer-backdrop');\n  const parent = document.getElementById('exhibitions-parent');\n  const subnav = document.getElementById('exhibition-subnav');\n  const toast = document.getElementById('toast');\n  const toggleDrawer = (open) => { sidebar.classList.toggle('mobile-open', open); mobileMenu.setAttribute('aria-expanded', String(open)); backdrop.style.display = open ? 'block' : 'none'; };\n  collapse.addEventListener('click', () => { const collapsed = sidebar.classList.toggle('collapsed'); collapse.setAttribute('aria-expanded', String(!collapsed)); collapse.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar'); collapse.innerHTML = '<i class=\"ti ' + (collapsed ? 'ti-chevron-right' : 'ti-chevron-left') + '\" style=\"font-size:14px;width:14px;height:14px;color:#7C4A2D;line-height:1;\"></i>'; });\n  mobileMenu.addEventListener('click', () => toggleDrawer(true));\n  backdrop.addEventListener('click', () => toggleDrawer(false));\n  parent.addEventListener('click', () => { const open = parent.classList.toggle('open'); parent.setAttribute('aria-expanded', String(open)); subnav.style.display = open ? 'block' : 'none'; });\n  window.addEventListener('resize', () => { if (window.innerWidth > 820) toggleDrawer(false); });\n  document.querySelectorAll('[data-tab]').forEach((button) => button.addEventListener('click', () => { const target = button.dataset.tab; document.querySelectorAll('[data-tab]').forEach((tab) => { tab.classList.toggle('active', tab === button); tab.setAttribute('aria-selected', String(tab === button)); }); document.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === target)); }));\n  document.getElementById('copy-qr').addEventListener('click', async () => { try { await navigator.clipboard.writeText('https://adwamuseum.et/exhibitions/lion-of-adwa'); } catch (error) {} toast.classList.add('show'); window.setTimeout(() => toast.classList.remove('show'), 2200); });\n  const chartCanvas = document.getElementById('visitor-chart');\n  if (window.Chart && chartCanvas) { new Chart(chartCanvas, { type: 'line', data: { labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov'], datasets: [{ label:'Visitors', data:[18,21,24,22,27,31,29,36,34,39,43], borderColor:'#D4A017', backgroundColor:'rgba(212,160,23,.16)', borderWidth:2, pointRadius:0, pointHoverRadius:4, tension:.38, fill:true }] }, options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{backgroundColor:'#0A1628', titleFont:{family:'Inter',size:10}, bodyFont:{family:'Inter',size:10}, padding:9, displayColors:false} }, scales:{ x:{grid:{display:false}, ticks:{color:'#8B7668',font:{family:'Inter',size:9}}}, y:{beginAtZero:true, max:50, grid:{color:'rgba(226,214,197,.7)'}, ticks:{color:'#8B7668',font:{family:'Inter',size:9}, callback:(value)=>value+'k'} } } } }); }\n</script>\n",
      "comments": [],
      "created": "2026-07-25T15:13:25.515293+00:00",
      "modified": "2026-07-25T15:18:02.315882+00:00",
      "id": "var_72e53699b470",
      "viewportScrollY": 0
    },
    "var_de9aae02dfc6": {
      "type": "variant",
      "label": "Exhibition Dashboard — Exhibition Atlas",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n:root{--navy:#0d1d2c;--navy-2:#152a3b;--navy-3:#213b4f;--brown:#4a2c1b;--brown-2:#7c4a2d;--gold:#d4a017;--gold-soft:#f8efd7;--paper:#f5efe6;--card:#fffdf9;--line:#e2d6c5;--muted:#765f50;--green:#42631c;--green-soft:#e4eedc;--amber:#ad6711;--amber-soft:#fff2d8;--red:#a44735;--red-soft:#fae5df;--shadow:0 12px 32px rgba(52,34,20,.08);--shadow-dark:0 16px 34px rgba(4,12,20,.22)}\n.exh-app{min-height:100vh;background:var(--paper);color:#2b1b12;font-family:Inter,Arial,sans-serif;display:flex;position:relative;overflow-x:hidden}\n.exh-app button,.exh-app input,.exh-app select{font:inherit}.exh-app button{cursor:pointer}.exh-app button:focus-visible,.exh-app a:focus-visible,.exh-app input:focus-visible,.exh-app select:focus-visible{outline:3px solid rgba(212,160,23,.52);outline-offset:2px}\n.exh-icon{width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;line-height:18px;color:currentColor;flex:none}\n.exh-icon-sm{width:15px;height:15px;font-size:15px;line-height:15px}.exh-icon-lg{width:22px;height:22px;font-size:22px;line-height:22px}\n.exh-sidebar{width:260px;flex:0 0 260px;background:#fffdf9;border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:100vh;transition:width .25s ease,transform .25s ease;position:relative;z-index:30}\n.exh-app.is-collapsed .exh-sidebar{width:78px;flex-basis:78px}.exh-app.is-collapsed .exh-brand-copy,.exh-app.is-collapsed .exh-nav-label,.exh-app.is-collapsed .exh-nav-count,.exh-app.is-collapsed .exh-sidebar-note{display:none}.exh-app.is-collapsed .exh-nav-link{justify-content:center;padding-left:0;padding-right:0}.exh-app.is-collapsed .exh-nav-parent{justify-content:center}.exh-app.is-collapsed .exh-subnav{display:none}\n.exh-brand{height:76px;padding:17px 18px;border-bottom:1px solid var(--line);background:#faf6f0;display:flex;align-items:center;gap:11px}.exh-brand-mark{width:40px;height:40px;border-radius:14px;background:#faf0d8;border:1px solid rgba(212,160,23,.45);display:grid;place-items:center;color:var(--brown-2);font-size:21px;flex:none}.exh-brand-copy{min-width:0}.exh-brand-name{font-family:'Playfair Display',Georgia,serif;font-size:17px;font-weight:700;letter-spacing:-.02em}.exh-brand-role{font-size:10px;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.12em;margin-top:2px;white-space:nowrap}.exh-sidebar-toggle{position:absolute;right:-12px;top:25px;width:25px;height:25px;border-radius:999px;border:1px solid rgba(212,160,23,.6);background:#faf0d8;color:var(--brown-2);display:grid;place-items:center;z-index:2}.exh-sidebar-toggle .exh-icon{width:12px;height:12px;font-size:12px;line-height:12px}\n.exh-side-nav{padding:22px 12px 12px;overflow:auto;flex:1}.exh-nav-section{font-size:10px;color:#a1846e;font-weight:800;letter-spacing:.16em;text-transform:uppercase;padding:0 10px 9px}.exh-nav-link{display:flex;align-items:center;gap:12px;padding:10px 11px;border-radius:11px;color:#5c4233;text-decoration:none;font-size:13px;font-weight:700;margin-bottom:4px;min-height:40px}.exh-nav-link:hover{background:#faf0e4;color:#2b1b12}.exh-nav-link.is-active{background:#e4eedc;color:#243205}.exh-nav-link.is-active .exh-icon{color:#374b07}.exh-nav-link .exh-icon{color:#7c4a2d}.exh-nav-parent{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 11px;border-radius:11px;color:#243205;background:#f2f5e9;font-size:13px;font-weight:800;margin-bottom:3px}.exh-nav-parent-left{display:flex;align-items:center;gap:12px;min-width:0}.exh-nav-parent .exh-icon{color:#374b07}.exh-nav-caret{transition:transform .2s ease}.exh-nav-parent.is-closed .exh-nav-caret{transform:rotate(-90deg)}.exh-subnav{margin:0 0 9px 18px;padding:3px 0 3px 16px;border-left:1px solid #d4c6b7}.exh-subnav-link{display:flex;align-items:center;justify-content:space-between;gap:7px;padding:8px 9px;border-radius:8px;color:#765f50;text-decoration:none;font-size:11px;font-weight:700}.exh-subnav-link:hover{background:#fbf3e8;color:#2b1b12}.exh-subnav-link.is-current{background:#f9efd6;color:#7c4a2d;box-shadow:inset 3px 0 0 var(--gold)}.exh-nav-count{font-size:9px;line-height:16px;min-width:17px;height:16px;padding:0 4px;text-align:center;border-radius:999px;background:#efe5d8;color:#765f50;font-weight:800}.exh-subnav-link.is-current .exh-nav-count{background:#d4a017;color:#24170e}.exh-sidebar-note{margin:14px 12px 16px;padding:12px;border-radius:13px;border:1px solid rgba(212,160,23,.4);background:#faf0d8}.exh-sidebar-note-title{display:flex;align-items:center;gap:7px;font-size:10px;font-weight:800;color:#7c4a2d;text-transform:uppercase;letter-spacing:.08em}.exh-sidebar-note p{font-size:10px;line-height:1.45;color:#5c4233;margin:6px 0 0}\n.exh-overlay{display:none}\n.exh-shell{min-width:0;flex:1;display:flex;flex-direction:column}.exh-topbar{height:62px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 27px;border-bottom:1px solid var(--line);background:rgba(250,246,240,.92);backdrop-filter:blur(16px);position:sticky;top:0;z-index:20}.exh-top-left,.exh-top-right{display:flex;align-items:center;gap:12px;min-width:0}.exh-mobile-menu{display:none;width:34px;height:34px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:9px;background:var(--card);color:var(--brown)}.exh-top-brand{display:flex;align-items:center;gap:9px;white-space:nowrap}.exh-top-brand-mark{width:28px;height:28px;border-radius:9px;background:#faf0e4;border:1px solid rgba(212,160,23,.34);display:grid;place-items:center;color:#374b07}.exh-top-brand-text{font-size:12px;font-weight:800;color:#2b1b12;letter-spacing:-.01em}.exh-top-divider{height:18px;width:1px;background:var(--line)}.exh-operational{display:flex;align-items:cente