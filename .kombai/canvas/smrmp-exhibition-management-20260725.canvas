      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root { --navy:#0A1628; --navy-2:#152238; --ink:#2B1B12; --muted:#6E5445; --parchment:#F5EFE6; --card:#FAF6F0; --white:#FFFDF9; --border:#E2D6C5; --gold:#D4A017; --gold-soft:#FAF0D8; --green:#374B07; --green-soft:#E4EEDC; --red:#9A3A2A; --blue:#315E8A; }\n  .museum-app { min-height: 100vh; background: var(--parchment); color: var(--ink); font-family: Inter, Arial, sans-serif; }\n  .museum-app button, .museum-app a, .museum-app input { font: inherit; }\n  .museum-app button { cursor: pointer; }\n  .museum-app button:focus-visible, .museum-app a:focus-visible, .museum-app input:focus-visible { outline: 3px solid rgba(212,160,23,.72); outline-offset: 2px; }\n  .museum-app .app-frame { display:flex; min-height:100vh; }\n  .museum-app .sidebar { width:256px; flex:0 0 256px; background:#FFFDF9; border-right:1px solid var(--border); display:flex; flex-direction:column; position:relative; z-index:20; transition:width .25s ease, transform .25s ease; }\n  .museum-app .sidebar.collapsed { width:80px; flex-basis:80px; }\n  .museum-app .brand-row { min-height:78px; padding:18px 20px; background:#FAF6F0; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }\n  .museum-app .brand-link { display:flex; align-items:center; gap:12px; color:var(--ink); text-decoration:none; min-width:0; }\n  .museum-app .brand-mark { width:40px; height:40px; border-radius:15px; display:grid; place-items:center; flex:none; background:var(--gold-soft); border:1px solid rgba(212,160,23,.45); color:var(--green); }\n  .museum-app .brand-copy { min-width:0; }\n  .museum-app .brand-copy strong { display:block; font:700 16px/1.1 'Playfair Display', Georgia, serif; letter-spacing:-.02em; }\n  .museum-app .brand-copy span { display:block; color:var(--muted); font-size:10px; font-weight:700; letter-spacing:.11em; text-transform:uppercase; margin-top:4px; }\n  .museum-app .collapse-btn { width:26px; height:26px; border-radius:50%; border:1px solid rgba(212,160,23,.5); background:var(--gold-soft); color:#7C4A2D; display:grid; place-items:center; margin-right:-34px; z-index:2; }\n  .museum-app .nav-scroll { flex:1; overflow:auto; padding:22px 12px 16px; }\n  .museum-app .nav-label { padding:0 12px 9px; color:#8B7668; font-size:10px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }\n  .museum-app .nav-link, .museum-app .nav-parent { width:100%; display:flex; align-items:center; gap:13px; border:0; border-radius:12px; padding:11px 13px; color:#5C4233; background:transparent; text-decoration:none; text-align:left; font-size:13px; font-weight:600; margin-bottom:5px; }\n  .museum-app .nav-link:hover, .museum-app .nav-parent:hover { background:#FAF0E4; color:var(--ink); }\n  .museum-app .nav-link.active, .museum-app .nav-parent.active { background:var(--green-soft); color:var(--green); }\n  .museum-app .nav-icon { width:19px; height:19px; flex:none; display:grid; place-items:center; color:#7C4A2D; }\n  .museum-app .nav-link.active .nav-icon, .museum-app .nav-parent.active .nav-icon { color:var(--green); }\n  .museum-app .nav-parent .chevron { margin-left:auto; transition:transform .2s ease; }\n  .museum-app .nav-parent.open .chevron { transform:rotate(180deg); }\n  .museum-app .subnav { padding:2px 0 8px 44px; }\n  .museum-app .subnav a { display:flex; align-items:center; gap:9px; padding:8px 10px; color:#7C6657; text-decoration:none; font-size:11px; line-height:1.25; border-left:1px solid #D8C8B8; }\n  .museum-app .subnav a:hover { color:var(--ink); background:#FAF0E4; }\n  .museum-app .subnav a.active { color:var(--green); font-weight:700; border-left:2px solid var(--gold); background:#F7F1E9; }\n  .museum-app .status-card { margin:12px; padding:13px; border-radius:13px; border:1px solid rgba(212,160,23,.4); background:var(--gold-soft); }\n  .museum-app .status-card .status-title { display:flex; align-items:center; gap:7px; color:#7C4A2D; font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }\n  .museum-app .status-card p { color:#5C4233; font-size:11px; line-height:1.45; margin:5px 0 0; }\n  .museum-app .collapsed-only { display:none; }\n  .museum-app .sidebar.collapsed .brand-copy, .museum-app .sidebar.collapsed .nav-label, .museum-app .sidebar.collapsed .nav-copy, .museum-app .sidebar.collapsed .subnav, .museum-app .sidebar.collapsed .status-card { display:none; }\n  .museum-app .sidebar.collapsed .brand-row { justify-content:center; padding-inline:10px; }\n  .museum-app .sidebar.collapsed .collapse-btn { margin-right:0; position:absolute; right:-13px; top:26px; }\n  .museum-app .sidebar.collapsed .nav-link, .museum-app .sidebar.collapsed .nav-parent { justify-content:center; padding-inline:10px; }\n  .museum-app .sidebar.collapsed .collapsed-only { display:block; }\n  .museum-app .main-column { min-width:0; flex:1; display:flex; flex-direction:column; }\n  .museum-app .topbar { height:58px; flex:0 0 58px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:0 25px; background:rgba(250,246,240,.94); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:15; backdrop-filter:blur(12px); }\n  .museum-app .topbar-left, .museum-app .topbar-right { display:flex; align-items:center; gap:12px; min-width:0; }\n  .museum-app .mobile-menu { display:none; width:32px; height:32px; place-items:center; border-radius:9px; border:1px solid var(--border); background:var(--white); color:var(--ink); }\n  .museum-app .museum-badge { width:30px; height:30px; display:grid; place-items:center; border-radius:9px; color:var(--green); background:#FAF0E4; border:1px solid rgba(212,160,23,.3); }\n  .museum-app .topbar-title { font-size:12px; font-weight:700; white-space:nowrap; }\n  .museum-app .topbar-meta { color:var(--muted); font-size:11px; white-space:nowrap; }\n  .museum-app .operational { display:flex; align-items:center; gap:6px; border:1px solid #B8D4A0; background:var(--green-soft); color:var(--green); border-radius:999px; padding:5px 9px; font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }\n  .museum-app .operational-dot { width:6px; height:6px; border-radius:50%; background:var(--green); box-shadow:0 0 0 3px rgba(55,75,7,.11); }\n  .museum-app .top-search { display:flex; align-items:center; gap:7px; min-width:210px; width:min(290px,28vw); border:1px solid var(--border); background:var(--white); color:var(--muted); border-radius:9px; padding:7px 10px; font-size:11px; }\n  .museum-app .top-search kbd { margin-left:auto; padding:2px 5px; border:1px solid #D8C8B8; background:#EFE5D8; color:#5C4233; border-radius:4px; font-size:9px; }\n  .museum-app .user-name { text-align:right; line-height:1.2; }\n  .museum-app .user-name strong { display:block; font-size:11px; }\n  .museum-app .user-name span { display:block; margin-top:3px; color:#7C4A2D; font-size:9px; font-weight:700; text-transform:capitalize; }\n  .museum-app .avatar { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:var(--navy); color:var(--gold); font:700 11px 'Playfair Display',serif; }\n  .museum-app .logout { border:1px solid var(--border); background:var(--white); color:#4A2C1B; border-radius:8px; padding:7px 9px; display:flex; align-items:center; gap:6px; font-size:10px; font-weight:700; }\n  .museum-app .workspace { width:100%; max-width:1400px; padding:24px 26px 18px; margin:0 auto; }\n  .museum-app .welcome { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; padding:25px 27px; color:#F5EFE6; background:var(--navy); border:1px solid #203450; box-shadow:0 12px 28px rgba(10,22,40,.16); }\n  .museum-app .eyebrow { display:flex; align-items:center; gap:9px; color:#D7B55B; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }\n  .museum-app .eyebrow::before { content:''; width:26px; height:1px; background:var(--gold); }\n  .museum-app .welcome h1 { margin:8px 0 6px; color:#FFFDF9; font:700 clamp(26px,3vw,38px)/1.08 'Playfair Display', Georgia, serif; letter-spacing:-.035em; }\n  .museum-app .welcome p { margin:0; color:rgba(245,239,230,.72); font-size:12px; max-width:590px; line-height:1.55; }\n  .museum-app .welcome-context { display:flex; gap:7px; align-items:center; margin-top:13px; color:#EAD9AD; font-size:10px; }\n  .museum-app .welcome-context span { color:rgba(245,239,230,.46); }\n  .museum-app .welcome-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }\n  .museum-app .btn { min-height:34px; display:inline-flex; align-items:center; justify-content:center; gap:7px; border:1px solid transparent; border-radius:8px; padding:8px 12px; font-size:11px; font-weight:700; text-decoration:none; }\n  .museum-app .btn-gold { background:var(--gold); color:#241710; border-color:#E6B82F; }\n  .museum-app .btn-gold:hover { background:#E6B82F; }\n  .museum-app .btn-quiet { background:rgba(255,255,255,.06); color:#FFFDF9; border-color:rgba(255,255,255,.24); }\n  .museum-app .btn-quiet:hover { background:rgba(255,255,255,.12); }\n  .museum-app .section-head { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin:26px 0 11px; }\n  .museum-app .section-head h2 { margin:0; color:var(--ink); font:700 20px/1.1 'Playfair Display', Georgia, serif; letter-spacing:-.02em; }\n  .museum-app .section-head p { margin:4px 0 0; color:var(--muted); font-size:11px; }\n  .museum-app .section-link { color:var(--green); font-size:11px; font-weight:700; text-decoration:none; }\n  .museum-app .feature-layout { display:grid; grid-template-columns:minmax(0,1.75fr) minmax(230px,.75fr); gap:14px; }\n  .museum-app .feature-card { min-height:290px; position:relative; overflow:hidden; background:#1C120B; border:1px solid rgba(212,160,23,.55); color:#FFFDF9; }\n  .museum-app .feature-image { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.58; }\n  .museum-app .feature-scrim { position:absolute; inset:0; background:linear-gradient(90deg, rgba(10,22,40,.95) 0%, rgba(10,22,40,.77) 46%, rgba(10,22,40,.28) 100%); }\n  .museum-app .feature-content { min-height:290px; position:relative; z-index:1; display:flex; flex-direction:column; justify-content:space-between; padding:22px 23px; max-width:590px; }\n  .museum-app .feature-overline { color:#E6C96D; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; }\n  .museum-app .feature-content h2 { margin:7px 0 8px; font:700 clamp(24px,3.1vw,35px)/1.06 'Playfair Display', Georgia, serif; letter-spacing:-.035em; }\n  .museum-app .feature-subtitle { color:rgba(255,253,249,.75); font-size:11px; line-height:1.45; max-width:390px; }\n  .museum-app .feature-details { display:flex; flex-wrap:wrap; gap:10px 17px; margin-top:16px; color:#F5EFE6; font-size:10px; }\n  .museum-app .feature-details span { display:flex; align-items:center; gap:5px; }\n  .museum-app .feature-details i { color:#E6C96D; }\n  .museum-app .feature-bottom { display:flex; align-items:flex-end; justify-content:space-between; gap:14px; }\n  .museum-app .feature-status { color:#E4EEDC; font-size:10px; font-weight:700; }\n  .museum-app .tab-row { display:flex; gap:4px; margin-top:18px; border-top:1px solid rgba(255,255,255,.18); padding-top:11px; }\n  .museum-app .tab-btn { border:0; border-bottom:2px solid transparent; background:transparent; color:rgba(255,253,249,.63); padding:4px 8px 6px; font-size:10px; font-weight:700; }\n  .museum-app .tab-btn.active { color:#FFFDF9; border-bottom-color:var(--gold); }\n  .museum-app .tab-panel { display:none; margin-top:10px; color:rgba(255,253,249,.74); font-size:11px; line-height:1.5; }\n  .museum-app .tab-panel.active { display:block; }\n  .museum-app .tab-panel strong { color:#FFFDF9; }\n  .museum-app .kpi-rail { display:grid; grid-template-columns:1fr; gap:10px; }\n  .museum-app .kpi-card { min-height:66px; border:1px solid var(--border); background:var(--card); padding:12px 13px; display:flex; align-items:center; justify-content:space-between; gap:10px; }\n  .museum-app .kpi-card:first-child { border-top:3px solid var(--gold); }\n  .museum-app .kpi-label { color:var(--muted); font-size:10px; font-weight:600; }\n  .museum-app .kpi-value { margin-top:4px; color:var(--ink); font:700 22px/1 'Playfair Display', Georgia, serif; }\n  .museum-app .kpi-delta { margin-top:4px; color:var(--green); font-size:9px; font-weight:700; }\n  .museum-app .kpi-icon { width:34px; height:34px; display:grid; place-items:center; flex:none; background:#F3EBDD; color:#7C4A2D; border:1px solid #E2D6C5; }\n  .museum-app .story-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(190px,.7fr) minmax(170px,.55fr); gap:14px; }\n  .museum-app .panel { border:1px solid var(--border); background:var(--card); box-shadow:0 5px 14px rgba(43,27,18,.035); }\n  .museum-app .panel-pad { padding:15px 16px; }\n  .museum-app .panel-title { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }\n  .museum-app .panel-title h3 { margin:0; color:var(--ink); font-size:12px; font-weight:700; }\n  .museum-app .panel-title p { margin:4px 0 0; color:var(--muted); font-size:10px; }\n  .museum-app .chart-wrap { height:155px; margin-top:12px; }\n  .museum-app .chart-legend { display:flex; align-items:center; gap:13px; margin-top:9px; color:var(--muted); font-size:9px; }\n  .museum-app .legend-dot { width:7px; height:7px; border-radius:50%; background:var(--gold); }\n  .museum-app .rank-list { margin:11px 0 0; padding:0; list-style:none; }\n  .museum-app .rank-item { display:flex; align-items:center; gap:9px; padding:9px 0; border-bottom:1px solid #EDE4D7; }\n  .museum-app .rank-item:last-child { border-bottom:0; }\n  .museum-app .rank-num { width:18px; height:18px; display:grid; place-items:center; border-radius:50%; background:#F1E4C7; color:#7C4A2D; font-size:9px; font-weight:700; }\n  .museum-app .rank-copy { min-width:0; flex:1; }\n  .museum-app .rank-copy strong { display:block; overflow:hidden; color:var(--ink); font-size:10px; text-overflow:ellipsis; white-space:nowrap; }\n  .museum-app .rank-copy span { display:block; margin-top:3px; color:var(--muted); font-size:9px; }\n  .museum-app .rank-score { color:var(--green); font-size:10px; font-weight:700; }\n  .museum-app .status-rail { margin-top:12px; display:grid; gap:9px; }\n  .museum-app .status-line { display:flex; align-items:center; gap:8px; color:var(--muted); font-size:10px; }\n  .museum-app .status-line b { margin-left:auto; color:var(--ink); font-size:10px; }\n  .museum-app .status-bar { height:5px; flex:1; background:#E9DED0; overflow:hidden; }\n  .museum-app .status-bar span { display:block; height:100%; background:var(--gold); }\n  .museum-app .status-bar.green span { background:var(--green); }\n  .museum-app .status-bar.red span { background:var(--red); }\n  .museum-app .workspace-strip { display:grid; grid-template-columns:1.15fr repeat(4,1fr); gap:9px; }\n  .museum-app .workspace-intro { padding:15px 15px 13px; border:1px solid #D6C5AE; background:#EFE3D1; }\n  .museum-app .workspace-intro h3 { margin:0; color:var(--ink); font:700 16px/1.1 'Playfair Display',serif; }\n  .museum-app .workspace-intro p { margin:6px 0 0; color:var(--muted); font-size:10px; line-height:1.35; }\n  .museum-app .action-card { min-height:86px; text-align:left; display:flex; flex-direction:column; justify-content:space-between; border:1px solid var(--border); background:var(--white); color:var(--ink); padding:12px; }\n  .museum-app .action-card:hover { border-color:rgba(212,160,23,.7); background:#FFF9ED; }\n  .museum-app .action-icon { color:var(--green); }\n  .museum-app .action-card span { color:var(--ink); font-size:10px; font-weight:700; }\n  .museum-app .action-card small { color:var(--muted); font-size:9px; }\n  .museum-app .lower-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(220px,.65fr) minmax(200px,.65fr); gap:14px; }\n  .museum-app .gallery-rail { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:11px; }\n  .museum-app .gallery-tile { overflow:hidden; border:1px solid var(--border); background:var(--white); }\n  .museum-app .gallery-tile img { display:block; width:100%; height:87px; object-fit:cover; }\n  .museum-app .gallery-tile figcaption { padding:8px 9px; color:var(--ink); font-size:9px; font-weight:700; line-height:1.25; }\n  .museum-app .gallery-tile figcaption span { display:block; color:var(--muted); font-size:8px; font-weight:500; margin-top:3px; }\n  .museum-app .activity-list, .museum-app .schedule-list, .museum-app .related-list { margin:11px 0 0; padding:0; list-style:none; }\n  .museum-app .activity-list li, .museum-app .schedule-list li, .museum-app .related-list li { display:flex; gap:9px; align-items:flex-start; padding:9px 0; border-bottom:1px solid #EDE4D7; }\n  .museum-app .activity-list li:last-child, .museum-app .schedule-list li:last-child, .museum-app .related-list li:last-child { border-bottom:0; }\n  .museum-app .activity-mark { width:7px; height:7px; flex:none; margin-top:4px; background:var(--gold); border-radius:50%; }\n  .museum-app .list-copy { min-width:0; }\n  .museum-app .list-copy strong { display:block; color:var(--ink); font-size:10px; line-height:1.3; }\n  .museum-app .list-copy span { display:block; color:var(--muted); font-size:9px; margin-top:3px; line-height:1.35; }\n  .museum-app .time-badge { width:42px; flex:none; color:var(--green); font-size:9px; font-weight:700; }\n  .museum-app .qr-card { background:var(--navy); color:#FFFDF9; padding:15px; border:1px solid #203450; display:flex; gap:13px; align-items:center; }\n  .museum-app .qr-code { width:72px; height:72px; flex:none; padding:6px; background:#FFFDF9; display:grid; grid-template-columns:repeat(7,1fr); grid-template-rows:repeat(7,1fr); gap:2px; }\n  .museum-app .qr-code span { background:#0A1628; }\n  .museum-app .qr-code span:nth-child(3n+1) { opacity:.75; }\n  .museum-app .qr-copy h3 { margin:0; font:700 16px/1.1 'Playfair Display',serif; }\n  .museum-app .qr-copy p { margin:5px 0 9px; color:rgba(255,253,249,.65); font-size:9px; line-height:1.4; }\n  .museum-app .copy-btn { border:1px solid rgba(255,255,255,.3); background:rgba(255,255,255,.06); color:#FFFDF9; border-radius:6px; padding:6px 8px; font-size:9px; font-weight:700; }\n  .museum-app .related-list img { width:34px; height:34px; flex:none; object-fit:cover; }\n  .museum-app .related-list strong { font-size:9px; }\n  .museum-app .footer { padding:19px 0 4px; color:#8B7668; font-size:9px; line-height:1.4; }\n  .museum-app .footer a { color:#7C4A2D; }\n  .museum-app .toast { position:fixed; right:24px; bottom:24px; z-index:50; display:flex; align-items:center; gap:8px; transform:translateY(20px); opacity:0; pointer-events:none; padding:10px 13px; background:#243205; border:1px solid #91AB68; color:#F8F7E8; box-shadow:0 10px 20px rgba(36,50,5,.2); font-size:11px; font-weight:700; transition:opacity .2s ease, transform .2s ease; }\n  .museum-app .toast.show { transform:translateY(0); opacity:1; }\n  .museum-app .drawer-backdrop { display:none; }\n  @media (max-width:1100px) {\n    .museum-app .workspace { padding-inline:18px; }\n    .museum-app .feature-layout { grid-template-columns:minmax(0,1.45fr) minmax(210px,.75fr); }\n    .museum-app .story-grid { grid-template-columns:minmax(0,1.1fr) minmax(190px,.75fr); }\n    .museum-app .story-grid > .panel:last-child { grid-column:1 / -1; }\n    .museum-app .status-rail { grid-template-columns:repeat(4,1fr); }\n    .museum-app .workspace-strip { grid-template-columns:repeat(4,1fr); }\n    .museum-app .workspace-intro { grid-column:1 / -1; }\n    .museum-app .lower-grid { grid-template-columns:1.25fr .8fr; }\n    .museum-app .lower-grid > .panel:last-child { grid-column:1 / -1; }\n  }\n  @media (max-width:820px) {\n    .museum-app .sidebar { position:fixed; inset:0 auto 0 0; transform:translateX(-105%); box-shadow:12px 0 35px rgba(10,22,40,.18); }\n    .museum-app .sidebar.mobile-open { transform:translateX(0); }\n    .museum-app .sidebar.collapsed { width:256px; flex-basis:256px; }\n    .museum-app .sidebar.collapsed .brand-copy, .museum-app .sidebar.collapsed .nav-label, .museum-app .sidebar.collapsed .nav-copy, .museum-app .sidebar.collapsed .subnav, .museum-app .sidebar.collapsed .status-card { display:block; }\n    .museum-app .sidebar.collapsed .nav-link, .museum-app .sidebar.collapsed .nav-parent { justify-content:flex-start; padding-inline:13px; }\n    .museum-app .sidebar.collapsed .brand-row { justify-content:space-between; padding-inline:20px; }\n    .museum-app .sidebar.collapsed .collapse-btn { display:none; }\n    .museum-app .mobile-menu { display:grid; }\n    .museum-app .top-search, .museum-app .operational, .museum-app .topbar-meta, .museum-app .user-name { display:none; }\n    .museum-app .topbar { padding-inline:14px; }\n    .museum-app .workspace { padding:16px 14px 12px; }\n    .museum-app .welcome { flex-direction:column; padding:20px; }\n    .museum-app .welcome-actions { justify-content:flex-start; }\n    .museum-app .feature-layout, .museum-app .story-grid, .museum-app .lower-grid { grid-template-columns:1fr; }\n    .museum-app .story-grid > .panel:last-child, .museum-app .lower-grid > .panel:last-child { grid-column:auto; }\n    .museum-app .kpi-rail { grid-template-columns:repeat(2,1fr); }\n    .museum-app .status-rail { grid-template-columns:repeat(2,1fr); }\n    .museum-app .workspace-strip { grid-template-columns:repeat(2,1fr); }\n    .museum-app .workspace-intro { grid-column:1 / -1; }\n  }\n  @media (max-width:520px) {\n    .museum-app .topbar-title { font-size:11px; }\n    .museum-app .avatar { display:none; }\n    .museum-app .logout span { display:none; }\n    .museum-app .logout { width:31px; height:31px; justify-content:center; padding:0; }\n    .museum-app .welcome h1 { font-size:28px; }\n    .museum-app .feature-card, .museum-app .feature-content { min-height:365px; }\n    .museum-app .feature-content { padding:18px; }\n    .museum-app .feature-bottom { align-items:flex-start; flex-direction:column; }\n    .museum-app .feature-bottom .btn { width:100%; }\n    .museum-app .feature-bottom .btn + .btn { margin-top:6px; }\n    .museum-app .feature-content .tab-row { margin-top:12px; }\n    .museum-app .kpi-rail { grid-template-columns:1fr 1fr; }\n    .museum-app .kpi-card { min-height:94px; align-items:flex-start; flex-direction:column-reverse; justify-content:space-between; }\n    .museum-app .kpi-icon { width:27px; height:27px; }\n    .museum-app .gallery-rail { grid-template-columns:1fr; }\n    .museum-app .gallery-tile { display:grid; grid-template-columns:88px 1fr; }\n    .museum-app .gallery-tile img { height:78px; }\n    .museum-app .workspace-strip { grid-template-columns:1fr 1fr; }\n    .museum-app .qr-card { align-items:flex-start; }\n  }\n</style>\n<div class=\"museum-app\" data-kid=\"1\" id=\"exhibition-app\">\n    <div class=\"app-frame\" data-kid=\"1-1\">\n        <aside aria-label=\"Primary navigation\" class=\"sidebar\" data-kid=\"1-1-1\" id=\"sidebar\">\n            <div class=\"brand-row\" data-kid=\"1-1-1-1\">\n                <a aria-label=\"SMRMP dashboard\" class=\"brand-link\" data-kid=\"1-1-1-1-1\" href=\"#dashboard\">\n                    <span class=\"brand-mark\" data-kid=\"1-1-1-1-1-1\">\n                        <i class=\"ti ti-building-museum\" data-kid=\"1-1-1-1-1-1-1\" style=\"font-size:21px;width:21px;height:21px;color:#374B07;line-height:1;\">\n                        </i>\n                    </span>\n                    <span class=\"brand-copy\" data-kid=\"1-1-1-1-1-2\">\n                        <strong data-kid=\"1-1-1-1-1-2-1\">\n                            SMRMP\n