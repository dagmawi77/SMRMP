=\"museum-badge\" data-kid=\"1-1-3-1-1-2\">\n                        <i class=\"ti ti-building-bank\" data-kid=\"1-1-3-1-1-2-1\" style=\"font-size:16px;width:16px;height:16px;color:#374B07;line-height:1;\">\n                        </i>\n                    </div>\n                    <span class=\"topbar-title\" data-kid=\"1-1-3-1-1-3\">\n                        Adwa Victory Memorial\n                    </span>\n                    <span data-kid=\"1-1-3-1-1-4\" style=\"color:#D8C8B8;font-size:12px;\">\n                        /\n                    </span>\n                    <span class=\"topbar-meta\" data-kid=\"1-1-3-1-1-5\">\n                        SMRMP\n                    </span>\n                    <span class=\"operational\" data-kid=\"1-1-3-1-1-6\">\n                        <span class=\"operational-dot\" data-kid=\"1-1-3-1-1-6-1\">\n                        </span>\n                        Operational\n                    </span>\n                </div>\n                <div class=\"topbar-right\" data-kid=\"1-1-3-1-2\">\n                    <button aria-label=\"Search catalog\" class=\"top-search\" data-kid=\"1-1-3-1-2-1\" type=\"button\">\n                        <i class=\"ti ti-search\" data-kid=\"1-1-3-1-2-1-1\" style=\"font-size:15px;width:15px;height:15px;color:#7C4A2D;line-height:1;\">\n                        </i>\n                        <span data-kid=\"1-1-3-1-2-1-2\">\n                            Search catalog…\n                        </span>\n                        <kbd data-kid=\"1-1-3-1-2-1-3\">\n                            ⌘K\n                        </kbd>\n                    </button>\n                    <div class=\"user-name\" data-kid=\"1-1-3-1-2-2\">\n                        <strong data-kid=\"1-1-3-1-2-2-1\">\n                            Aster Tadesse\n                        </strong>\n                        <span data-kid=\"1-1-3-1-2-2-2\">\n                            Administrator\n                        </span>\n                    </div>\n                    <div aria-label=\"Aster Tadesse profile\" class=\"avatar\" data-kid=\"1-1-3-1-2-3\">\n                        AT\n                    </div>\n                    <button aria-label=\"Log out\" class=\"logout\" data-kid=\"1-1-3-1-2-4\" type=\"button\">\n                        <i class=\"ti ti-logout\" data-kid=\"1-1-3-1-2-4-1\" style=\"font-size:15px;width:15px;height:15px;color:#7C4A2D;line-height:1;\">\n                        </i>\n                        <span data-kid=\"1-1-3-1-2-4-2\">\n                            Logout\n                        </span>\n                    </button>\n                </div>\n            </header>\n            <main class=\"workspace\" data-kid=\"1-1-3-2\">\n                <section aria-labelledby=\"page-title\" class=\"welcome\" data-kid=\"1-1-3-2-1\">\n                    <div data-kid=\"1-1-3-2-1-1\">\n                        <div class=\"eyebrow\" data-kid=\"1-1-3-2-1-1-1\">\n                            Museum operations / Daawwannaa · ማሳያ\n                        </div>\n                        <h1 data-kid=\"1-1-3-2-1-1-2\" id=\"page-title\">\n                            Exhibition Management\n                        </h1>\n                        <p data-kid=\"1-1-3-2-1-1-3\">\n                            Shape the public story of Adwa through thoughtful curation, dependable schedules, and artifact-first workflows.\n                        </p>\n                        <div class=\"welcome-context\" data-kid=\"1-1-3-2-1-1-4\">\n                            <span data-kid=\"1-1-3-2-1-1-4-1\">\n                                Today\n                            </span>\n                            <b data-kid=\"1-1-3-2-1-1-4-2\">\n                                Monday, 25 November 2024\n                            </b>\n                            <span data-kid=\"1-1-3-2-1-1-4-3\">\n                                •\n                            </span>\n                       