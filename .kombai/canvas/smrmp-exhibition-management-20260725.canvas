                               </span>\n                                <div class=\"activity-copy\" data-kid=\"1-1-3-2-6-1-2-4-2\" data-name=\"activity copy\">\n                                    <strong data-kid=\"1-1-3-2-6-1-2-4-2-1\" data-name=\"activity title\">\n                                        Gallery image uploaded\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-1-2-4-2-2\" data-name=\"activity detail\">\n                                        “Adwa wall detail” added to exhibition gallery\n                                    </span>\n                                </div>\n                                <time class=\"activity-time\" data-kid=\"1-1-3-2-6-1-2-4-3\" data-name=\"activity time\">\n                                    Yesterday\n                                </time>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"panel\" data-kid=\"1-1-3-2-6-2\" data-name=\"upcoming schedule panel\">\n                        <div class=\"panel-header\" data-kid=\"1-1-3-2-6-2-1\" data-name=\"panel header\">\n                            <div data-kid=\"1-1-3-2-6-2-1-1\" data-name=\"panel title area\">\n                                <h2 class=\"panel-title\" data-kid=\"1-1-3-2-6-2-1-1-1\" data-name=\"panel title\">\n                                    Upcoming schedule\n                                </h2>\n                                <p class=\"panel-subtitle\" data-kid=\"1-1-3-2-6-2-1-1-2\" data-name=\"panel subtitle\">\n                                    Next public-facing moments\n                                </p>\n                            </div>\n                            <a class=\"panel-link\" data-kid=\"1-1-3-2-6-2-1-2\" data-name=\"full schedule link\" href=\"#schedule\">\n                                Full schedule\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-1-3-2-6-2-1-2-1\" data-name=\"arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                        <div class=\"schedule-list\" data-kid=\"1-1-3-2-6-2-2\" data-name=\"schedule list\">\n                            <div class=\"schedule-item\" data-kid=\"1-1-3-2-6-2-2-1\" data-name=\"schedule item 1\">\n                                <div class=\"schedule-date\" data-kid=\"1-1-3-2-6-2-2-1-1\" data-name=\"schedule date\">\n                                    <strong data-kid=\"1-1-3-2-6-2-2-1-1-1\" data-name=\"date day\">\n                                        18\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-2-2-1-1-2\" data-name=\"date month\">\n                                        Jul\n                                    </span>\n                                </div>\n                                <div class=\"schedule-copy\" data-kid=\"1-1-3-2-6-2-2-1-2\" data-name=\"schedule copy\">\n                                    <strong data-kid=\"1-1-3-2-6-2-2-1-2-1\" data-name=\"schedule title\">\n                                        Exhibition opening\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-2-2-1-2-2\" data-name=\"schedule detail\">\n                                        17:00 · Hall A · 120 guests\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"schedule-item\" data-kid=\"1-1-3-2-6-2-2-2\" data-name=\"schedule item 2\">\n                                <div class=\"schedule-date\" data-kid=\"1-1-3-2-6-2-2-2-1\" data-name=\"schedule date\">\n                                    <strong data-kid=\"1-1-3-2-6-2-2-2-1-1\" data-name=\"date day\">\n                                        26\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-2-2-2-1-2\" data-name=\"date month\">\n                                        Jul\n                                    </span>\n                                </div>\n                                <div class=\"schedule-copy\" data-kid=\"1-1-3-2-6-2-2-2-2\" data-name=\"schedule copy\">\n                                    <strong data-kid=\"1-1-3-2-6-2-2-2-2-1\" data-name=\"schedule title\">\n                                        Guided tour · Oromo\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-2-2-2-2-2\" data-name=\"schedule detail\">\n                                        14:30 · Lion of Adwa\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"schedule-item\" data-kid=\"1-1-3-2-6-2-2-3\" data-name=\"schedule item 3\">\n                                <div class=\"schedule-date\" data-kid=\"1-1-3-2-6-2-2-3-1\" data-name=\"schedule date\">\n                                    <strong data-kid=\"1-1-3-2-6-2-2-3-1-1\" data-name=\"date day\">\n                                        02\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-2-2-3-1-2\" data-name=\"date month\">\n                                        Aug\n                                    </span>\n                                </div>\n                                <div class=\"schedule-copy\" data-kid=\"1-1-3-2-6-2-2-3-2\" data-name=\"schedule copy\">\n                                    <strong data-kid=\"1-1-3-2-6-2-2-3-2-1\" data-name=\"schedule title\">\n                                        Schools programme\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-2-2-3-2-2\" data-name=\"schedule detail\">\n                                        09:00 · Education studio\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"panel quick-panel\" data-kid=\"1-1-3-2-6-3\" data-name=\"quick actions panel\">\n                        <div class=\"panel-header\" data-kid=\"1-1-3-2-6-3-1\" data-name=\"panel header\">\n                            <div data-kid=\"1-1-3-2-6-3-1-1\" data-name=\"panel title area\">\n                                <h2 class=\"panel-title\" data-kid=\"1-1-3-2-6-3-1-1-1\" data-name=\"panel title\">\n                                    Quick actions\n                                </h2>\n                                <p class=\"panel-subtitle\" data-kid=\"1-1-3-2-6-3-1-1-2\" data-name=\"panel subtitle\">\n                                    Keep your programme moving\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"quick-actions\" data-kid=\"1-1-3-2-6-3-2\" data-name=\"quick actions grid\">\n                            <button class=\"quick-action\" data-kid=\"1-1-3-2-6-3-2-1\" data-name=\"create exhibition button\" type=\"button\">\n                                <span class=\"quick-icon\" data-kid=\"1-1-3-2-6-3-2-1-1\" data-name=\"icon container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-3-2-6-3-2-1-1-1\" data-name=\"plus icon\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-1-3-2-6-3-2-1-2\" data-name=\"text container\">\n                                    <strong data-kid=\"1-1-3-2-6-3-2-1-2-1\" data-name=\"title\">\n                                        Create exhibition\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-3-2-1-2-2\" data-name=\"description\">\n                                        Start a new record\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-1-3-2-6-3-2-1-3\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"quick-action\" data-kid=\"1-1-3-2-6-3-2-2\" data-name=\"assign artifacts button\" type=\"button\">\n                                <span class=\"quick-icon\" data-kid=\"1-1-3-2-6-3-2-2-1\" data-name=\"icon container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-archive\" data-kid=\"1-1-3-2-6-3-2-2-1-1\" data-name=\"archive icon\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-1-3-2-6-3-2-2-2\" data-name=\"text container\">\n                                    <strong data-kid=\"1-1-3-2-6-3-2-2-2-1\" data-name=\"title\">\n                                        Assign artifacts\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-3-2-2-2-2\" data-name=\"description\">\n                                        Build an object set\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-1-3-2-6-3-2-2-3\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"quick-action\" data-kid=\"1-1-3-2-6-3-2-3\" data-name=\"view calendar button\" type=\"button\">\n                                <span class=\"quick-icon\" data-kid=\"1-1-3-2-6-3-2-3-1\" data-name=\"icon container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-calendar-event\" data-kid=\"1-1-3-2-6-3-2-3-1-1\" data-name=\"calendar icon\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-1-3-2-6-3-2-3-2\" data-name=\"text container\">\n                                    <strong data-kid=\"1-1-3-2-6-3-2-3-2-1\" data-name=\"title\">\n                                        View calendar\n                                    </strong>\n                                    <span data-kid=\"1-1-3-2-6-3-2-3-2-2\" data-name=\"description\">\n                                        Review programme dates\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-1-3-2-6-3-2-3-3\" data-name=\"chevron icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </article>\n                </section>\n                <div class=\"module-note\" data-kid=\"1-1-3-2-7\" data-name=\"module note\">\n                    <i aria-hidden=\"true\" class=\"ti ti-language\" data-kid=\"1-1-3-2-7-1\" data-name=\"language icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-7-2\" data-name=\"note text\">\n                        This module is prepared for English, Afaan Oromo, and Amharic content. Labels can be localized without changing the curator workflow.\n                    </span>\n                </div>\n                <div class=\"artifact-attribution\" data-kid=\"1-1-3-2-8\" data-name=\"artifact attribution footer\">\n                    Photography: Rodrigo Chablé, Lokman Sevim, and Justinas on Pexels · SMRMP Exhibition Management preview\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    (() => {\n    const root = document.querySelector('[data-module=\"exhibition-management\"]');\n    if (!root) return;\n\n    const sidebar = root.querySelector('#artifactSidebar');\n    const collapseButton = root.querySelector('#sidebarCollapse');\n    const mobileMenu = root.querySelector('#mobileMenu');\n    const mobileClose = root.querySelector('#mobileClose');\n    const backdrop = root.querySelector('#drawerBackdrop');\n    const exhibitionParent = root.querySelector('#exhibitionParent');\n    const exhibitionSubmenu = root.querySelector('#exhibitionSubmenu');\n\n    const setDrawer = (open) => {\n      sidebar.classList.toggle('is-mobile-open', open);\n      backdrop.classList.toggle('is-visible', open);\n      mobileMenu.setAttribute('aria-expanded', String(open));\n      backdrop.setAttribute('aria-hidden', String(!open));\n    };\n\n    mobileMenu.addEventListener('click', () => setDrawer(true));\n    mobileClose.addEventListener('click', () => setDrawer(false));\n    backdrop.addEventListener('click', () => setDrawer(false));\n\n    collapseButton.addEventListener('click', () => {\n      const collapsed = sidebar.classList.toggle('is-collapsed');\n      collapseButton.setAttribute('aria-pressed', String(collapsed));\n      collapseButton.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n      collapseButton.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n      collapseButton.innerHTML = '<i class=\"ti ' + (collapsed ? 'ti-layout-sidebar-right-collapse' : 'ti-layout-sidebar-left-collapse') + '\" aria-hidden=\"true\"></i>';\n    });\n\n    exhibitionParent.addEventListener('click', () => {\n      const expanded = exhibitionParent.getAttribute('aria-expanded') === 'true';\n      exhibitionParent.setAttribute('aria-expanded', String(!expanded));\n      exhibitionSubmenu.hidden = expanded;\n      exhibitionParent.querySelector('.chevron').className = 'ti ' + (expanded ? 'ti-chevron-right' : 'ti-chevron-down') + ' chevron';\n    });\n\n    root.querySelectorAll('.nav-submenu a').forEach((link) => link.addEventListener('click', () => setDrawer(false)));\n\n    const chartDefaults = { responsive: true, maintainAspectRatio: false, animation: { duration: 500 }, plugins: { legend: { display: false }, tooltip: { backgroundColor: '#101b31', titleColor: '#f7edd9', bodyColor: '#fffdf9', padding: 10, cornerRadius: 8, displayColors: false } } };\n    if (window.Chart) {\n      const monthlyCanvas = root.querySelector('#monthlyVisitorsChart');\n      const monthlyContext = monthlyCanvas.getContext('2d');\n      const monthlyGradient = monthlyContext.createLinearGradient(0, 0, 0, 190);\n      monthlyGradient.addColorStop(0, 'rgba(205,164,93,.34)');\n      monthlyGradient.addColorStop(1, 'rgba(205,164,93,0)');\n      const monthlyChart = new Chart(monthlyContext, { type: 'line', data: { labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'], datasets: [{ label: 'Visitors', data: [1680, 2140, 1980, 2860, 3220, 3670, 4120], borderColor: '#b78e45', backgroundColor: monthlyGradient, fill: true, tension: .38, pointRadius: 3, pointHoverRadius: 5, pointBackgroundColor: '#fffdf9', pointBorderColor: '#b78e45', pointBorderWidth: 2 }, { label: 'Target', data: [1800, 2050, 2300, 2500, 2900, 3300, 3900], borderColor: '#d8e4ed', borderDash: [4, 5], borderWidth: 2, pointRadius: 0, fill: false, tension: .3 }] }, options: { ...chartDefaults, scales: { x: { grid: { display: false }, ticks: { color: '#978c80', font: { size: 9, family: 'Inter' } } }, y: { beginAtZero: true, grid: { color: '#eee7dd' }, ticks: { color: '#978c80', font: { size: 9, family: 'Inter' }, callback: (value) => value >= 1000 ? (value / 1000) + 'k' : value } } } } });\n\n      const popularityCanvas = root.querySelector('#popularityChart');\n      new Chart(popularityCanvas.getContext('2d'), { type: 'bar', data: { labels: ['Lion of Adwa', 'Threads of Continuity', 'Royal Regalia', 'River of Memory', 'Learning Lab'], datasets: [{ data: [7842, 4720, 3240, 1940, 900], backgroundColor: ['#243a62', '#cda45d', '#6d8c72', '#c8b7a1', '#d8d0c6'], borderRadius: 6, barThickness: 14 }] }, options: { ...chartDefaults, indexAxis: 'y', scales: { x: { beginAtZero: true, grid: { color: '#eee7dd' }, ticks: { color: '#978c80', font: { size: 9, family: 'Inter' }, callback: (value) => value >= 1000 ? (value / 1000) + 'k' : value } }, y: { grid: { display: false }, ticks: { color: '#675c52', font: { size: 9, family: 'Inter', weight: '600' } } } } } });\n\n      new Chart(root.querySelector('#statusChart').getContext('2d'), { type: 'doughnut', data: { labels: ['Active', 'Upcoming', 'Completed', 'Draft'], datasets: [{ data: [8, 5, 9, 3], backgroundColor: ['#54745b', '#cda45d', '#243a62', '#d2c3b0'], borderWidth: 0, hoverOffset: 4 }] }, options: { ...chartDefaults, cutout: '73%', plugins: { ...chartDefaults.plugins, tooltip: { ...chartDefaults.plugins.tooltip, displayColors: true } } } });\n\n      root.querySelectorAll('.range-btn').forEach((button) => button.addEventListener('click', () => {\n        root.querySelectorAll('.range-btn').forEach((item) => item.classList.remove('is-selected'));\n        button.classList.add('is-selected');\n        const range = button.dataset.range;\n        const multiplier = range === '30' ? 1 : range === '90' ? 1.14 : 1.27;\n        monthlyChart.data.datasets[0].data = [1680, 2140, 1980, 2860, 3220, 3670, 4120].map((value) => Math.round(value * multiplier));\n        monthlyChart.update();\n      }));\n    }\n  })();\n</script>\n",
