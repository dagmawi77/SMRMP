e:10px;color:#8b7160;margin:5px 0 0}.exh-panel-actions{display:flex;align-items:center;gap:7px}.exh-icon-btn{width:29px;height:29px;display:grid;place-items:center;border:1px solid var(--line);border-radius:8px;background:#fffdf9;color:#765f50}.exh-icon-btn:hover,.exh-icon-btn.is-active{background:#faf0d8;border-color:rgba(212,160,23,.55);color:#7c4a2d}.exh-filter-row{display:flex;align-items:center;justify-content:space-between;gap:9px;padding:11px 17px;border-bottom:1px solid #f0e8de;flex-wrap:wrap}.exh-chips{display:flex;gap:5px;flex-wrap:wrap}.exh-chip{border:1px solid var(--line);background:#fffdf9;color:#765f50;border-radius:999px;padding:5px 9px;font-size:9px;font-weight:800}.exh-chip:hover{background:#faf0e4}.exh-chip.is-selected{background:#0d1d2c;border-color:#0d1d2c;color:#fffdf9}.exh-table-scroll{overflow-x:auto}.exh-table{width:100%;min-width:860px;border-collapse:collapse}.exh-table th{padding:10px 11px;text-align:left;color:#a1846e;font-size:9px;text-transform:uppercase;letter-spacing:.1em;font-weight:800;white-space:nowrap;background:#fffcf7}.exh-table td{padding:12px 11px;border-top:1px solid #f0e8de;vertical-align:middle;font-size:10px;color:#5c4233;white-space:nowrap}.exh-table tr:hover td{background:#fffaf3}.exh-exh-name{display:flex;align-items:center;gap:9px;min-width:210px}.exh-thumb{width:39px;height:36px;border-radius:8px;object-fit:cover;border:1px solid rgba(124,74,45,.18);flex:none}.exh-name-main{font-size:11px;font-weight:800;color:#2b1b12;max-width:180px;overflow:hidden;text-overflow:ellipsis}.exh-name-sub{font-size:9px;color:#927966;margin-top:3px}.exh-status{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:5px 8px;font-size:9px;font-weight:800}.exh-status::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor}.exh-status-active{background:var(--green-soft);color:var(--green)}.exh-status-upcoming{background:var(--amber-soft);color:var(--amber)}.exh-status-draft{background:#efe8f5;col